#include "ubmem/copy.h"
using namespace kvaf::ubmem;

namespace kvaf::ubmem {
constexpr uint32_t kAddressBatchRows = 32;
constexpr uint32_t kAddressBankBytes = kAddressBatchRows * (2 * sizeof(uint64_t) + sizeof(uint32_t));
constexpr uint32_t kAddressScratchBytes = 2 * kAddressBankBytes;
constexpr uint32_t kCopyBufferBytes = kMteBufferBytes - kAddressScratchBytes;

// One thread resolves one request. Results stay in this core's UB until the
// scalar loop has consumed the whole batch. Two address banks follow the
// independent MTE data area at the end of the 32 KiB UB.
__simt_vf__ __aicore__ LAUNCH_BOUND(32)
inline void PrepareUbmemGetAddresses(
    __gm__ const int32_t* indices, __gm__ const int32_t* offsets,
    __gm__ const int32_t* output_indices, __gm__ const uint8_t* valid,
    __gm__ const uint64_t* addresses, uint64_t begin, uint32_t rows,
    uint32_t table_entries, uint32_t token_bytes, uint64_t block_bytes,
    uint64_t remote_base, uint64_t remote_bytes, uint64_t mapped_base,
    uint64_t local_base, uint64_t local_bytes,
    __ubuf__ uint64_t* sources, __ubuf__ uint64_t* destinations,
    __ubuf__ uint32_t* results) {
  const uint32_t slot = threadIdx.x;
  if (slot >= rows) return;
  const uint64_t row = begin + slot;
  const int32_t index = indices[row];
  const int32_t offset = offsets[row];
  const int32_t output = output_indices[row];
  if (index < 0 || static_cast<uint32_t>(index) >= table_entries || valid[index] == 0) {
    results[slot] = 2;
    return;
  }
  const uint64_t base = addresses[index];
  if (offset < 0 || static_cast<uint64_t>(offset) > block_bytes - token_bytes ||
      base < remote_base || block_bytes > remote_bytes ||
      base - remote_base > remote_bytes - block_bytes) {
    results[slot] = 2;
    return;
  }
  if (output < 0 || local_bytes < token_bytes ||
      static_cast<uint64_t>(output) > (local_bytes - token_bytes) / token_bytes) {
    results[slot] = 3;
    return;
  }
  sources[slot] = mapped_base + (base - remote_base) + offset;
  destinations[slot] = local_base + static_cast<uint64_t>(output) * token_bytes;
  results[slot] = 0;
}

__aicore__ inline __ubuf__ uint64_t* UbmemAddressSources(uint32_t bank) {
  return reinterpret_cast<__ubuf__ uint64_t*>(get_imm(kCopyBufferBytes + bank * kAddressBankBytes));
}

__aicore__ inline void SubmitUbmemGetAddresses(const BatchArgs& a, uint64_t begin,
                                              uint32_t rows, uint32_t bank) {
  auto* sources = UbmemAddressSources(bank);
  auto* destinations = sources + kAddressBatchRows;
  auto* results = reinterpret_cast<__ubuf__ uint32_t*>(destinations + kAddressBatchRows);
  const auto event = static_cast<event_t>(bank);
  // Reuse only after Scalar has consumed this bank. No data-MTE wait is
  // needed: Copy has already captured the addresses in its own state.
  set_flag(PIPE_S, PIPE_V, event);
  wait_flag(PIPE_S, PIPE_V, event);
  AscendC::Simt::VF_CALL<PrepareUbmemGetAddresses>(
      AscendC::Simt::Dim3{kAddressBatchRows, 1U, 1U},
      reinterpret_cast<__gm__ const int32_t*>(a.indices),
      reinterpret_cast<__gm__ const int32_t*>(a.offsets),
      reinterpret_cast<__gm__ const int32_t*>(a.output_indices),
      reinterpret_cast<__gm__ const uint8_t*>(a.valid),
      reinterpret_cast<__gm__ const uint64_t*>(a.addresses),
      begin, rows, a.table_entries, a.token_bytes,
      static_cast<uint64_t>(a.token_bytes) * a.tokens_per_block,
      a.remote_base, a.remote_bytes, a.mapped_base, a.local_base, a.local_bytes,
      sources, destinations, results);
  set_flag(PIPE_V, PIPE_S, event);
  // The caller waits only when it starts consuming this bank.
}
}  // namespace kvaf::ubmem

extern "C" __global__ __aicore__ void KvafExecuteBatchGetUbmemKernelV2(BatchArgs a) {
  const uint32_t core = AscendC::GetBlockIdx();
  const uint64_t start = a.profile ? AscendC::GetSystemCycle() : 0;
  const bool detail = a.profile == 2;
  CoreStatus report{};
  report.failed_request = UINT64_MAX;
  const int32_t active = *reinterpret_cast<__gm__ const int32_t*>(a.miss_count);
  const bool valid_count = active >= 0 && static_cast<uint32_t>(active) <= a.capacity;
  const uint64_t count = valid_count ? active : 0;
  if (!valid_count) report.result = 1;
  MteCopyPipeline<8, kCopyBufferBytes> copy(a.token_bytes);
  const uint64_t begin = count * core / a.blocks;
  const uint64_t end = count * (core + 1) / a.blocks;
  bool pending[2] = {};
  uint32_t bank = 0;
  const uint64_t setup_done = detail ? AscendC::GetSystemCycle() : 0;
  if (begin < end) {
    const uint64_t prepare_start = detail ? AscendC::GetSystemCycle() : 0;
    const uint32_t rows = end - begin < kAddressBatchRows ? end - begin : kAddressBatchRows;
    SubmitUbmemGetAddresses(a, begin, rows, bank);
    pending[bank] = true;
    if (detail) report.address_cycles += AscendC::GetSystemCycle() - prepare_start;
  }
  for (uint64_t batch = begin; batch < end && report.result == 0; batch += kAddressBatchRows) {
    const uint32_t rows = end - batch < kAddressBatchRows ? end - batch : kAddressBatchRows;
    const uint64_t prepare_start = detail ? AscendC::GetSystemCycle() : 0;
    wait_flag(PIPE_V, PIPE_S, static_cast<event_t>(bank));
    pending[bank] = false;
    const uint64_t next = batch + rows;
    if (next < end) {
      const uint32_t next_rows = end - next < kAddressBatchRows ? end - next : kAddressBatchRows;
      SubmitUbmemGetAddresses(a, next, next_rows, bank ^ 1U);
      pending[bank ^ 1U] = true;
    }
    if (detail) report.address_cycles += AscendC::GetSystemCycle() - prepare_start;

    // Next batch's SIMT can run while Scalar submits this batch's MTE copies.
    auto* sources = UbmemAddressSources(bank);
    auto* destinations = sources + kAddressBatchRows;
    auto* results = reinterpret_cast<__ubuf__ uint32_t*>(destinations + kAddressBatchRows);
    for (uint32_t slot = 0; slot < rows; ++slot) {
      const uint64_t address_start = detail ? AscendC::GetSystemCycle() : 0;
      if (results[slot] != 0) {
        report.result = results[slot];
        report.failed_request = batch + slot;
        break;
      }
      const uint64_t dst = destinations[slot];
      const uint64_t src = sources[slot];
      const uint64_t address_done = detail ? AscendC::GetSystemCycle() : 0;
      copy.Copy(dst, src, a.token_bytes);
      if (detail) {
        const uint64_t submit_done = AscendC::GetSystemCycle();
        report.address_cycles += address_done - address_start;
        // Copy submission and synchronization; payload DMA can overlap both
        // the SIMT batch preparation and scalar address loads above.
        report.submit_cycles += submit_done - address_done;
      }
      ++report.completed;
    }
    bank ^= 1U;
  }
  const uint64_t drain_start = detail ? AscendC::GetSystemCycle() : 0;
  // An error in the current batch may leave the prefetched next batch in
  // flight. Consume its completion event before returning/reusing the UB.
  for (uint32_t i = 0; i < 2; ++i) {
    if (pending[i]) wait_flag(PIPE_V, PIPE_S, static_cast<event_t>(i));
  }
  copy.Finish();
  const uint64_t finish = a.profile ? AscendC::GetSystemCycle() : 0;
  auto* status = reinterpret_cast<__gm__ CoreStatus*>(a.statuses) + core;
  status->result = report.result;
  status->failed_request = report.failed_request;
  status->completed = report.completed;
  status->profile_magic = a.profile ? kProfileMagic : 0;
  status->start_cycle = start;
  status->finish_cycle = finish;
  status->profile_detail = detail;
  if (detail) {
    status->setup_cycles = setup_done - start;
    status->address_cycles = report.address_cycles;
    status->submit_cycles = report.submit_cycles;
    status->drain_cycles = finish - drain_start;
  }
}
static const struct FunLevelKType KvafExecuteBatchGetUbmemKernelV2_type __attribute__(
    (used, section(".ascend.meta.KvafExecuteBatchGetUbmemKernelV2"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
