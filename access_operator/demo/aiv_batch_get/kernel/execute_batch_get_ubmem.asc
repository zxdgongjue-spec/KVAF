#include "ubmem_copy.h"
using namespace kvaf::ubmem;

extern "C" __global__ __aicore__ void KvafExecuteBatchGetUbmemKernel(BatchArgs a) {
  const uint32_t core = AscendC::GetBlockIdx();
  CoreStatus report{};
  report.failed_request = UINT64_MAX;
  const int32_t active = *reinterpret_cast<__gm__ const int32_t*>(a.miss_count);
  const bool valid_count = active >= 0 && static_cast<uint32_t>(active) <= a.capacity;
  const uint64_t count = valid_count ? active : 0;
  if (!valid_count) report.result = 1;
  MteCopyPipeline copy(a.token_bytes);
  const uint64_t block_bytes = static_cast<uint64_t>(a.token_bytes) * a.tokens_per_block;
  for (uint64_t row = count * core / a.blocks; row < count * (core + 1) / a.blocks; ++row) {
    const int32_t index = reinterpret_cast<__gm__ const int32_t*>(a.indices)[row];
    const int32_t offset = reinterpret_cast<__gm__ const int32_t*>(a.offsets)[row];
    const int32_t output = reinterpret_cast<__gm__ const int32_t*>(a.output_indices)[row];
    if (index < 0 || static_cast<uint32_t>(index) >= a.table_entries ||
        reinterpret_cast<__gm__ const uint8_t*>(a.valid)[index] == 0) {
      report.result = 2; report.failed_request = row; break;
    }
    const uint64_t base = reinterpret_cast<__gm__ const uint64_t*>(a.addresses)[index];
    if (offset < 0 || static_cast<uint64_t>(offset) > block_bytes - a.token_bytes ||
        base < a.remote_base || block_bytes > a.remote_bytes ||
        base - a.remote_base > a.remote_bytes - block_bytes) {
      report.result = 2; report.failed_request = row; break;
    }
    if (output < 0 || a.local_bytes < a.token_bytes ||
        static_cast<uint64_t>(output) > (a.local_bytes - a.token_bytes) / a.token_bytes) {
      report.result = 3; report.failed_request = row; break;
    }
    copy.Copy(a.local_base + static_cast<uint64_t>(output) * a.token_bytes,
              a.mapped_base + (base - a.remote_base) + offset, a.token_bytes);
    ++report.completed;
  }
  copy.Finish();
  auto* status = reinterpret_cast<__gm__ CoreStatus*>(a.statuses) + core;
  status->result = report.result;
  status->failed_request = report.failed_request;
  status->completed = report.completed;
}
static const struct FunLevelKType KvafExecuteBatchGetUbmemKernel_type __attribute__(
    (used, section(".ascend.meta.KvafExecuteBatchGetUbmemKernel"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
