// Included after execute_batch_get_aiv.asc: reuse its proven WQE copy,
// doorbell and CQ machinery, but keep a separate, checked range-read entry.
namespace kvaf_ranges {

// Advance a logical-range cursor by at most limit physical READs. No expanded
// worklist allocation or CPU request_count readback is needed.
__aicore__ inline uint32_t Advance(__gm__ const int64_t* lengths, uint32_t end,
                                  uint32_t limit, uint32_t chunk_bytes,
                                  uint32_t* request, uint64_t* offset, uint64_t* bytes) {
  uint32_t reads = 0;
  *bytes = 0;
  while (*request < end && reads < limit) {
    const uint64_t left = static_cast<uint64_t>(lengths[*request]) - *offset;
    const uint64_t chunks = (left - 1U) / chunk_bytes + 1U;
    const uint32_t available = limit - reads;
    if (chunks <= available) {
      *bytes += left;
      reads += static_cast<uint32_t>(chunks);
      ++*request;
      *offset = 0;
    } else {
      *bytes += static_cast<uint64_t>(available) * chunk_bytes;
      *offset += static_cast<uint64_t>(available) * chunk_bytes;
      reads += available;
    }
  }
  return reads;
}

__simt_vf__ __aicore__ LAUNCH_BOUND(128)
inline void Fill(__gm__ const uint64_t* addresses, __gm__ const int32_t* indices,
                 __gm__ const int64_t* offsets, __gm__ const int64_t* lengths,
                 __gm__ const int64_t* destinations, uint32_t first,
                 uint64_t first_offset, uint32_t count, uint64_t head,
                 uint32_t chunk_bytes,
                 __gm__ const KvafBatchGetDirectUrmaEntity* entity) {
  const uint32_t slot = threadIdx.x;
  if (slot >= count) return;
  uint32_t request = first, skip = slot;
  uint64_t offset = first_offset;
  for (;;) {
    const uint64_t left = static_cast<uint64_t>(lengths[request]) - offset;
    const uint64_t chunks = (left - 1U) / chunk_bytes + 1U;
    if (skip < chunks) break;
    skip -= static_cast<uint32_t>(chunks);
    ++request;
    offset = 0;
  }
  offset += static_cast<uint64_t>(skip) * chunk_bytes;
  const uint64_t left = static_cast<uint64_t>(lengths[request]) - offset;
  const uint32_t bytes = left < chunk_bytes
      ? static_cast<uint32_t>(left) : chunk_bytes;
  const uint64_t source = addresses[indices[request]] +
                          static_cast<uint64_t>(offsets[request]) + offset;
  const uint64_t target = entity->local_hbm_address +
                          static_cast<uint64_t>(destinations[request]) + offset;
  const uint32_t owner = 1U - static_cast<uint32_t>(((head + slot) >> kSqDepthShift) & 1ULL);
  const bool completion = slot + 1U == count;
  // A SIMT VF cannot call the scalar __aicore__ WqeControl helper. Build the
  // word here, as the existing fixed-token SIMT WQE builder does.
  const uint32_t place_order = completion ? 0x2U : 0x1U;
  const uint32_t control = (place_order << 16U) | (1U << 18U) | (1U << 20U) |
      (static_cast<uint32_t>(completion) << 21U) | (1U << 28U) |
      (1U << 29U) | ((owner & 1U) << 31U);
  const uint64_t eid_low = *reinterpret_cast<__gm__ const uint64_t*>(entity->remote_eid);
  const uint64_t eid_high = *reinterpret_cast<__gm__ const uint64_t*>(entity->remote_eid + 8);
  uint32_t words[16] = {
      control, kReadOpcode << 8U,
      (entity->tp_id & 0x00ffffffU) | 0x01000000U, entity->remote_token_id & 0x000fffffU,
      static_cast<uint32_t>(eid_low), static_cast<uint32_t>(eid_low >> 32U),
      static_cast<uint32_t>(eid_high), static_cast<uint32_t>(eid_high >> 32U),
      entity->remote_token_value, 0U, static_cast<uint32_t>(source),
      static_cast<uint32_t>(source >> 32U), bytes, entity->local_token_id,
      static_cast<uint32_t>(target), static_cast<uint32_t>(target >> 32U)};
  auto* output = reinterpret_cast<__ubuf__ uint32_t*>(get_imm(slot * kWqeBytes));
#pragma unroll
  for (uint32_t word = 0; word < 16; ++word) output[word] = words[word];
}
}  // namespace kvaf_ranges

extern "C" __global__ __aicore__ void KvafExecuteBatchGetRangesAivKernelV2(
    KvafExecuteBatchGetRangesKernelArgs args) {
  const uint32_t core = GetBlockIdx();
  if (!args.core_status || !args.block_count || core >= args.block_count ||
      args.block_count > KVAF_AIV_BATCH_GET_MAX_AIV_CORES) return;
  auto* status = reinterpret_cast<__gm__ KvafBatchGetCoreStatus*>(args.core_status) + core;
  uint64_t result = kSuccess, failed = UINT64_MAX, completed_requests = 0;
  const uint32_t jettys = args.jettys_per_core;
  const uint32_t chunk_bytes = args.read_chunk_bytes ? args.read_chunk_bytes : UINT32_MAX;
  if (!jettys || jettys > KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE ||
      !args.address_table || !args.valid_table || !args.table_lengths || !args.indices ||
      !args.source_offsets || !args.lengths || !args.request_count || !args.output_offsets ||
      !args.output || !args.channel_entity || !args.queue_state ||
      !args.table_capacity || !args.request_capacity ||
      (args.max_inflight_total && args.max_inflight_total < 2U * args.block_count)) {
    WriteStatus(status, kInvalidArgs, 0, 0, 0, 0, failed, 0);
    return;
  }
  const auto active = *reinterpret_cast<__gm__ const int32_t*>(args.request_count);
  if (active < 0 || static_cast<uint32_t>(active) > args.request_capacity) {
    WriteStatus(status, kInvalidArgs, 0, 0, 0, 0, failed, 0);
    return;
  }
  auto* queues = reinterpret_cast<__gm__ KvafBatchGetQueueState*>(args.queue_state) +
                 static_cast<uint64_t>(core) * jettys;
  const auto* entities = reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity*>(args.channel_entity) +
                         static_cast<uint64_t>(core) * jettys;
  for (uint32_t j = 0; j < jettys; ++j) {
    const auto& e = entities[j];
    if (e.magic != kEntityMagic || e.version != kEntityVersion ||
        e.local_hbm_address != args.output || !e.local_hbm_size || !e.local_token_id ||
        !e.remote_host_ddr_address || !e.remote_host_ddr_size ||
        !e.sq_va || !e.sq_db_va || e.sq_depth != kSqDepthWqebbs || e.wqe_size != kWqeBytes ||
        !e.cq_va || !e.cq_db_va || !e.cq_depth || e.cqe_size < kCqeProbeBytes ||
        e.remote_host_ddr_address != entities[0].remote_host_ddr_address ||
        e.remote_host_ddr_size != entities[0].remote_host_ddr_size ||
        e.remote_token_id != entities[0].remote_token_id ||
        e.remote_token_value != entities[0].remote_token_value ||
        e.local_hbm_size != entities[0].local_hbm_size ||
        e.local_token_id != entities[0].local_token_id ||
        e.local_token_value != entities[0].local_token_value) result = kInvalidEntity;
    if (queues[j].initialized &&
        (queues[j].magic != kQueueMagic || queues[j].poisoned)) result = kInvalidQueue;
  }
  const auto* addresses = reinterpret_cast<__gm__ const uint64_t*>(args.address_table);
  const auto* valid = reinterpret_cast<__gm__ const uint8_t*>(args.valid_table);
  const auto* table_lengths = reinterpret_cast<__gm__ const uint64_t*>(args.table_lengths);
  const auto* indices = reinterpret_cast<__gm__ const int32_t*>(args.indices);
  const auto* offsets = reinterpret_cast<__gm__ const int64_t*>(args.source_offsets);
  const auto* lengths = reinterpret_cast<__gm__ const int64_t*>(args.lengths);
  const auto* destinations = reinterpret_cast<__gm__ const int64_t*>(args.output_offsets);
  const uint32_t begin = static_cast<uint64_t>(active) * core / args.block_count;
  const uint32_t end = static_cast<uint64_t>(active) * (core + 1U) / args.block_count;
  // Validate this core's whole prefix before posting. On any core error the
  // caller must discard the entire output (other cores may already have run).
  for (uint32_t i = begin; result == kSuccess && i < end; ++i) {
    const int32_t index = indices[i];
    if (index < 0 || static_cast<uint32_t>(index) >= args.table_capacity ||
        !valid[index] || offsets[i] < 0 || lengths[i] <= 0) result = kInvalidLookup;
    else {
      const uint64_t start = addresses[index], capacity = table_lengths[index];
      const uint64_t offset = offsets[i], bytes = lengths[i];
      const auto& e = entities[0];
      if (start < e.remote_host_ddr_address || capacity > e.remote_host_ddr_size ||
          start - e.remote_host_ddr_address > e.remote_host_ddr_size - capacity ||
          offset > capacity || bytes > capacity - offset) result = kInvalidLookup;
      else if (destinations[i] < 0 || static_cast<uint64_t>(destinations[i]) > e.local_hbm_size ||
               bytes > e.local_hbm_size - static_cast<uint64_t>(destinations[i])) result = kInvalidOutput;
    }
    if (result != kSuccess) failed = i;
  }
  if (result != kSuccess) {
    WriteStatus(status, result, 0, 0, queues[0].sq_producer_index,
                queues[0].cq_consumer_index, failed, 0);
    return;
  }
  for (uint32_t j = 0; j < jettys; ++j) {
    if (!queues[j].initialized) {
      queues[j].magic = kQueueMagic;
      queues[j].initialized = 1;
      queues[j].sq_producer_index = queues[j].cq_consumer_index = 0;
      queues[j].completed_batch_count = queues[j].poisoned = 0;
    }
    queues[j].reserved[0] = queues[j].reserved[1] = 0;  // physical READs this call / reserved
  }
  ConfigureUbToGmCopy();
  uint32_t request = begin;
  uint64_t offset = 0;
  const uint32_t budget = args.max_inflight_total
      ? kvaf_batch_get::CoreBudget(args.max_inflight_total, args.block_count, core)
      : kWqesPerPost * jettys;
  uint64_t pending_bytes[KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE];
  while (request < end && result == kSuccess) {
    uint32_t used = 0, in_flight = 0;
    const uint32_t wave_first = request;
    for (uint32_t j = 0; j < jettys && request < end && in_flight < budget; ++j) {
      const uint32_t first = request;
      const uint64_t first_offset = offset;
      const uint32_t limit = budget - in_flight < kWqesPerPost ? budget - in_flight : kWqesPerPost;
      const uint32_t count = kvaf_ranges::Advance(
          lengths, end, limit, chunk_bytes, &request, &offset, pending_bytes + j);
      const uint64_t head = queues[j].sq_producer_index;
      set_flag(PIPE_S, PIPE_V, static_cast<event_t>(kScratchEventId));
      wait_flag(PIPE_S, PIPE_V, static_cast<event_t>(kScratchEventId));
      AscendC::Simt::VF_CALL<kvaf_ranges::Fill>(
          AscendC::Simt::Dim3{kWqesPerPost, 1U, 1U}, addresses, indices, offsets, lengths,
          destinations, first, first_offset, count, head, chunk_bytes, entities + j);
      set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
      PreparedPost prepared{};
      prepared.sq_base_address = entities[j].sq_va;
      prepared.sq_db_address = entities[j].sq_db_va;
      prepared.queue_state_address = reinterpret_cast<uint64_t>(queues + j);
      prepared.current_head = head;
      prepared.next_head = head + count;
      prepared.sq_depth = entities[j].sq_depth;
      prepared.wqe_count = count;
      prepared.event_id = 0;
      PendingPost pending{};
      PreparePostMte3Stage(&prepared, 0, &pending);
      CommitPostScalarStage(&pending);  // UB bank is reusable after this wait.
      queues[j].reserved[0] += count;
      in_flight += count;
      ++used;
    }
    for (uint32_t j = 0; j < used; ++j) {
      uint32_t polls = 0;
      // Size the polling allowance for the full post, rather than applying
      // the legacy small-payload allowance to MiB-scale READs. This is still
      // an iteration budget, not a calibrated wall-clock timeout.
      const uint64_t units = (pending_bytes[j] - 1U) / 65536U + 1U;
      const uint64_t allowance = units * kMaxCqPolls;
      const uint32_t max_polls = allowance > UINT32_MAX ? UINT32_MAX
                                                       : static_cast<uint32_t>(allowance);
      const auto completion = WaitForCompletion(entities + j, queues + j, &polls, max_polls);
      if (completion != kSuccess) result = completion;
    }
    if (result != kSuccess) {
      for (uint32_t j = 0; j < used; ++j) queues[j].poisoned = 1;
    } else {
      completed_requests += request - wave_first;
    }
  }
  for (uint32_t j = 0; j < jettys; ++j) {
    queues[j].last_error = result;
    if (result == kSuccess) ++queues[j].completed_batch_count;
  }
  WriteStatus(status, result, result == kSuccess ? end - begin : completed_requests,
              queues[0].completed_batch_count, queues[0].sq_producer_index,
              queues[0].cq_consumer_index, failed, 0);
}

static const struct FunLevelKType
    KvafExecuteBatchGetRangesAivKernelV2_kernel_type_section __attribute__(
        (used, section(".ascend.meta.KvafExecuteBatchGetRangesAivKernelV2"))) =
        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
