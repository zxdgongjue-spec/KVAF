#include "batch_get_kernel_common.h"
#define KVAF_SCATTER_OPTIONS_INLINE __aicore__ inline
#include "scatter_batch_get_abi.h"
#undef KVAF_SCATTER_OPTIONS_INLINE

namespace kvaf_scatter {
using namespace AscendC;
using namespace kvaf_aiv;
constexpr uint64_t kPushMagic = 0x4b56414650555333ULL;
constexpr uint32_t kCopyBytes = 16384;
constexpr uint32_t kTileBytes = 32768;
constexpr uint32_t kMaxTileRows = 32;
// Both runtime paths share one binary and the same static UB address budget.
constexpr uint32_t kMaxBanks = 2;
constexpr uint32_t kTileBufferBytes = kMaxBanks * kTileBytes;
constexpr uint32_t kBuildTileRows = 256;
constexpr uint32_t kCachedTableEntries = 4096;
constexpr uint32_t kBuildOffsets = kBuildTileRows * 4;
constexpr uint32_t kBuildRows = kBuildOffsets * 2;
constexpr uint32_t kBuildSources = kBuildOffsets * 3;
constexpr uint32_t kBuildAddresses = kBuildSources + kBuildTileRows * 8;
constexpr uint32_t kBuildValid = kBuildAddresses + kCachedTableEntries * 8;
constexpr uint32_t kBuildBufferBytes = kBuildValid + kCachedTableEntries;
static_assert(kBuildBufferBytes <= kTileBufferBytes);

__aicore__ inline void WaitCopyIn() {
  set_flag(PIPE_MTE2, PIPE_S, static_cast<event_t>(0));
  wait_flag(PIPE_MTE2, PIPE_S, static_cast<event_t>(0));
}

__aicore__ inline void LoadMetadata(uint32_t ub_offset, uint64_t address, uint32_t bytes) {
  if (!bytes) return;
  LocalTensor<uint8_t> destination(TPosition::VECIN, ub_offset, (bytes + 31U) & ~31U);
  GlobalTensor<uint8_t> source;
  source.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
  source.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
  const DataCopyExtParams copy{1, bytes, 0, 0, 0};
  const DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
  DataCopyPad(destination, source, copy, pad);
}

__aicore__ inline uint64_t BuildState(const KvafScatterBatchGetArgs& a, uint32_t core) {
  // One private cache line per builder, followed by the shared failure line.
  return a.workspace + a.workspace_bytes - uint64_t(a.request.block_count + 1) * 64 +
      uint64_t(core) * 64;
}

__aicore__ bool ValidateAndBuildSources(const KvafScatterBatchGetArgs& a,
                                       uint32_t core, uint32_t count) {
  const auto& r = a.request;
  // Eight descriptors fill a cache line. No two builders write the same line.
  const uint32_t groups = (count + 7U) / 8U;
  const uint32_t begin = uint64_t(groups) * core / r.block_count * 8;
  const uint32_t end = Min(count, uint64_t(groups) * (core + 1) / r.block_count * 8);
  if (begin == end) return true;
  const uint64_t block_bytes = uint64_t(r.token_bytes) * r.tokens_per_block;
  if (block_bytes > a.source_bytes) return false;
  const uint64_t max_base_offset = a.source_bytes - block_bytes;
  const uint64_t max_offset = block_bytes - r.token_bytes;
  // Combining sign/range checks must still reject negative int32 values even
  // when a caller supplies a capacity above INT32_MAX.
  const uint32_t table_limit = Min(r.table_capacity, 0x80000000U);
  const uint32_t row_limit = Min(r.output_rows, 0x80000000U);
  LocalTensor<int32_t> indices(TPosition::VECIN, 0, kBuildTileRows);
  LocalTensor<int32_t> offsets(TPosition::VECIN, kBuildOffsets, kBuildTileRows);
  LocalTensor<int32_t> rows(TPosition::VECIN, kBuildRows, kBuildTileRows);
  LocalTensor<uint64_t> sources(TPosition::VECIN, kBuildSources, kBuildTileRows);
  LocalTensor<uint64_t> addresses(TPosition::VECIN, kBuildAddresses, kCachedTableEntries);
  LocalTensor<uint8_t> valid(TPosition::VECIN, kBuildValid, kCachedTableEntries);
  const bool cached = r.table_capacity <= kCachedTableEntries;
  ResetLoopModePara(DataCopyMVType::OUT_TO_UB);
  set_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(0));
  wait_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(0));
  if (cached) {
    LoadMetadata(kBuildAddresses, r.address_table, r.table_capacity * 8);
    LoadMetadata(kBuildValid, r.valid_table, r.table_capacity);
    WaitCopyIn();
  } else {
    // Large tables keep the bounded scalar lookup fallback; the request tile
    // and generated descriptor still use DMA. No extra runtime option/ABI.
    Flush(r.address_table, uint64_t(r.table_capacity) * 8);
    Flush(r.valid_table, r.table_capacity);
  }
  for (uint32_t first = begin; first < end; first += kBuildTileRows) {
    const auto n = Min(kBuildTileRows, end - first);
    // Do not overwrite the previous tile until its scalar UB reads finish.
    set_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(0));
    wait_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(0));
    LoadMetadata(0, r.indices + uint64_t(first) * 4, n * 4);
    LoadMetadata(kBuildOffsets, r.offsets + uint64_t(first) * 4, n * 4);
    LoadMetadata(kBuildRows, r.output_indices + uint64_t(first) * 4, n * 4);
    WaitCopyIn();
    for (uint32_t j = 0; j < n; ++j) {
      const auto index = uint32_t(indices.GetValue(j));
      // A negative int32 offset converts above any uint32*uint32 block range.
      const auto offset = uint64_t(offsets.GetValue(j));
      const auto row = uint32_t(rows.GetValue(j));
      if (index >= table_limit || row >= row_limit || offset > max_offset) return false;
      const auto live = cached ? valid.GetValue(index) :
          reinterpret_cast<__gm__ const uint8_t*>(r.valid_table)[index];
      if (!live) return false;
      const auto base = cached ? addresses.GetValue(index) :
          reinterpret_cast<__gm__ const uint64_t*>(r.address_table)[index];
      if (base < a.source_base || base - a.source_base > max_base_offset) return false;
      sources.SetValue(j, base + offset);
    }
    set_flag(PIPE_S, PIPE_MTE3, static_cast<event_t>(0));
    wait_flag(PIPE_S, PIPE_MTE3, static_cast<event_t>(0));
    GlobalTensor<uint8_t> destination;
    destination.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(
        a.workspace + a.descriptor_offset + uint64_t(first) * 8));
    destination.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
    LocalTensor<uint8_t> bytes(TPosition::VECIN, kBuildSources, kBuildTileRows * 8);
    const DataCopyExtParams copy{1, n * 8, 0, 0, 0};
    DataCopyPad(destination, bytes, copy);
    // The descriptor must reach GM before its ready flag, or UB reuse.
    set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(0));
    wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(0));
  }
  return true;
}

__aicore__ inline void CopyIn(const LocalTensor<uint8_t>& scratch,
                             const GlobalTensor<uint8_t>& input, uint32_t bytes) {
  // DataCopy handles the 32-byte-multiple body; uint8_t counts are bytes.
  const uint32_t body = bytes / 32 * 32;
  if (body) {
    DataCopy(scratch, input, body);
    WaitCopyIn();
  }
  if (body != bytes) {
    // Packed staging requires an exact GM read. Padding stays inside UB.
    const DataCopyExtParams tail{1, bytes - body, 0, 0, 0};
    const DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
    DataCopyPad(scratch[body], input[body], tail, pad);
    WaitCopyIn();
  }
}

__aicore__ void CopyPayload(uint64_t source, uint64_t destination, uint32_t bytes) {
  LocalTensor<uint8_t> scratch(TPosition::VECIN, 0, kCopyBytes);
  while (bytes) {
    const auto n = Min(bytes, kCopyBytes);
    GlobalTensor<uint8_t> input, output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(source));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(destination));
    input.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
    // Payload is never read through scalar DCache; DMA needs no per-line DCCI.
    // Restore ordinary GM->UB copies when a preceding operator used loop mode.
    ResetLoopModePara(DataCopyMVType::OUT_TO_UB);
    set_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(0));
    wait_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(0));
    CopyIn(scratch, input, n);
    set_flag(PIPE_MTE2, PIPE_MTE3, static_cast<event_t>(0));
    wait_flag(PIPE_MTE2, PIPE_MTE3, static_cast<event_t>(0));
    const DataCopyExtParams copy{1, n, 0, 0, 0};
    DataCopyPad(output, scratch, copy);
    // Finish the exact-byte write before reusing UB or publishing completion.
    set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(0));
    wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(0));
    source += n; destination += n; bytes -= n;
  }
}

__aicore__ void CopyRows(uint64_t staging, uint64_t output, uint64_t output_indices,
                         uint32_t bytes, uint32_t begin, uint32_t end, bool double_buffer) {
  if (begin == end) return;
  const auto* rows = reinterpret_cast<__gm__ const int32_t*>(output_indices);
  if (bytes > kTileBytes) {
    // Retain exact, bounded chunks for a row larger than the tile buffer.
    for (uint32_t i = begin; i < end; ++i)
      CopyPayload(staging + uint64_t(i) * bytes,
                  output + uint64_t(rows[i]) * bytes, bytes);
    return;
  }

  // Normal DataCopyPad pads EACH UB row to 32 bytes. Packed GM rows remain
  // exactly `bytes` long: 656-byte tokens have a 672-byte UB row pitch.
  const uint32_t pitch = (bytes + 31U) & ~31U;
  const auto tile_rows = Min(kMaxTileRows, kTileBytes / pitch);
  LocalTensor<uint8_t> buffer(TPosition::VECIN, 0, kTileBufferBytes);
  GlobalTensor<uint8_t> input, destination;
  input.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(staging));
  input.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
  ResetLoopModePara(DataCopyMVType::OUT_TO_UB);
  const DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
  const DataCopyExtParams copy_out{1, bytes, 0, 0, 0};
  const uint32_t bank_count = double_buffer ? 2U : 1U;
  bool pending[kMaxBanks]{};
  uint32_t bank = 0;
  for (uint32_t i = begin; i < end;) {
    if (pending[bank]) {
      // Only this bank must be free; another bank's output may still be active.
      wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
      pending[bank] = false;
    }
    const auto scratch = buffer[bank * kTileBytes];
    const auto count = Min(tile_rows, end - i);
    const auto source_offset = uint64_t(i) * bytes;
    set_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(bank));
    wait_flag(PIPE_S, PIPE_MTE2, static_cast<event_t>(bank));
    const DataCopyExtParams copy_in{static_cast<uint16_t>(count), bytes, 0, 0, 0};
    DataCopyPad(scratch, input[source_offset], copy_in, pad);
    set_flag(PIPE_MTE2, PIPE_MTE3, static_cast<event_t>(bank));
    wait_flag(PIPE_MTE2, PIPE_MTE3, static_cast<event_t>(bank));
    // BatchGet requires unique output rows, so these writes do not overlap.
    for (uint32_t j = 0; j < count; ++j) {
      destination.SetGlobalBuffer(
          reinterpret_cast<__gm__ uint8_t*>(output + uint64_t(rows[i + j]) * bytes));
      // Only valid payload bytes reach GM; UB padding never reaches output.
      DataCopyPad(destination, scratch[j * pitch], copy_out);
    }
    // The next iteration can load the other bank while MTE3 writes this one.
    set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
    pending[bank] = true;
    i += count;
    bank = double_buffer ? (bank ^ 1U) : 0U;
  }
  // Completion/profile timestamps must follow BOTH banks' final exact writes.
  for (uint32_t b = 0; b < bank_count; ++b)
    if (pending[b]) wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(b));
}

__aicore__ uint64_t Scatter(const KvafScatterBatchGetArgs& a, uint32_t core,
                            uint32_t count, __gm__ KvafSequentialStatus* status,
                            __gm__ kvaf::ScatterBatchGetCoreProfile* profile = nullptr) {
  const auto& r = a.request;
  const bool fused = kvaf::ScatterOptionEnabled(a.reserved, kvaf::kScatterFusedBuild);
  if (fused) {
    const uint64_t private_bytes = uint64_t(r.block_count + 1) * 64;
    if (a.workspace_bytes < private_bytes ||
        a.staging_offset > a.workspace_bytes - private_bytes ||
        uint64_t(count) * r.token_bytes > a.workspace_bytes - private_bytes - a.staging_offset) {
      // Shape is identical on every worker; reject before touching a private
      // line that an older Host may not have allocated.
      return KVAF_SEQ_INVALID;
    }
    status->phase = KVAF_SEQ_BUILD;
    if (!ValidateAndBuildSources(a, core, count)) {
      PublishWord(a.workspace + a.workspace_bytes - 64, a.sequence);
      return KVAF_SEQ_INVALID;
    }
    PublishWord(BuildState(a, core), a.sequence);
  }
  if (!core) {
    // Validate every source before publishing a request CPU will dereference.
    if (!fused && !ValidateRows(a, 0, count)) {
      PublishWord(a.workspace + a.workspace_bytes - 64, a.sequence);
      return KVAF_SEQ_INVALID;
    }
    if (fused) {
      // This core has already completed and published its own descriptor DMA.
      for (uint32_t worker = 1; worker < r.block_count; ++worker) {
        bool ready = false;
        for (uint32_t poll = 0; poll < a.max_polls; ++poll) {
          if (LoadWord(a.workspace + a.workspace_bytes - 64) == a.sequence)
            return KVAF_SEQ_INVALID;
          if (LoadWord(BuildState(a, worker)) == a.sequence) { ready = true; break; }
        }
        if (!ready) {
          PublishWord(a.workspace + a.workspace_bytes - 64, a.sequence);
          return KVAF_SEQ_TIMEOUT;
        }
      }
    } else {
      status->phase = KVAF_SEQ_BUILD;
      auto* sources = reinterpret_cast<__gm__ uint64_t*>(a.workspace + a.descriptor_offset);
      for (uint32_t i = 0; i < count; ++i) sources[i] = Source(a, i);
      Flush(a.workspace + a.descriptor_offset, uint64_t(count) * 8);
    }
    auto* header = reinterpret_cast<__gm__ uint64_t*>(a.workspace);
    header[0] = kPushMagic; header[1] = a.sequence;
    header[2] = uint64_t(count) | (uint64_t(r.token_bytes) << 32);
    header[3] = uint64_t(r.block_count) |
        (profile ? uint64_t(kvaf::cpu_push::kInlineProfile) << 32 : 0);
    for (uint32_t i = 4; i < 8; ++i) header[i] = 0;
    Flush(a.workspace, 64);
    status->phase = KVAF_SEQ_NOTIFY;
    PublishWord(a.workspace + 64, a.sequence |
        (profile ? kvaf::cpu_push::kProfileNotify : uint64_t(0)));
    if (profile) profile->notify_cycle = GetSystemCycle();
  }
  status->phase = KVAF_SEQ_WAIT_REMOTE;
  bool done = false;
  for (uint32_t poll = 0; poll < a.max_polls; ++poll) {
    if (LoadWord(a.workspace + a.workspace_bytes - 64) == a.sequence) return KVAF_SEQ_INVALID;
    const auto token = LoadWord(a.workspace + 128);
    if ((token >> 32) > a.sequence) return KVAF_SEQ_REMOTE_ERROR;
    if ((token >> 32) != a.sequence) continue;
    if (uint32_t(token) != 1) return KVAF_SEQ_REMOTE_ERROR;
    done = true; break;
  }
  if (!done) return KVAF_SEQ_TIMEOUT;
  if (profile) {
    profile->done_cycle = GetSystemCycle();
  }
  status->phase = KVAF_SEQ_PAYLOAD;
  const auto begin = uint64_t(count) * core / r.block_count;
  const auto end = uint64_t(count) * (core + 1) / r.block_count;
  CopyRows(a.workspace + a.staging_offset, r.output, r.output_indices,
           r.token_bytes, begin, end,
           kvaf::ScatterOptionEnabled(a.reserved, kvaf::kScatterDoubleBuffer));
  status->requests = end - begin;
  if (profile) {
    profile->requests = end - begin;
    profile->bytes = uint64_t(end - begin) * r.token_bytes;
  }
  return KVAF_SEQ_OK;
}

}  // namespace kvaf_scatter

extern "C" __global__ __aicore__ void KvafScatterBatchGetAivKernelV1(
    KvafScatterBatchGetArgs args) {
  using namespace kvaf_scatter;
  const auto core = GetBlockIdx();
  const auto& r = args.request;
  if (!r.core_status || core >= r.block_count) return;
  auto* status = reinterpret_cast<__gm__ KvafSequentialStatus*>(r.core_status) + core;
  status->magic = KVAF_SEQ_STATUS_MAGIC; status->sequence = args.sequence;
  status->phase = KVAF_SEQ_VALIDATE; status->result = KVAF_SEQ_INVALID;
  status->requests = status->data_wrs = status->sq_pi = status->cq_ci = 0;
  auto* profile = kvaf::ScatterProfileEnabled(args.reserved) && r.block_count <= KVAF_SEQ_MAX_WORKERS ?
      reinterpret_cast<__gm__ kvaf::ScatterBatchGetCoreProfile*>(
      r.core_status + uint64_t(r.block_count) * sizeof(KvafSequentialStatus)) + core : nullptr;
  if (profile) {
    const auto start = GetSystemCycle();
    auto* words = reinterpret_cast<__gm__ uint64_t*>(profile);
    for (uint32_t i = 0; i < sizeof(*profile) / 8; ++i) words[i] = 0;
    profile->magic = kvaf::kScatterProfileMagic;
    profile->sequence = args.sequence;
    profile->start_cycle = start;
  }
  uint64_t result = KVAF_SEQ_INVALID;
  if (r.block_count && r.block_count <= KVAF_SEQ_MAX_WORKERS && r.token_bytes &&
      r.tokens_per_block && r.address_table && r.valid_table && r.indices && r.offsets &&
      r.miss_count && r.output_indices && r.output && args.workspace && args.sequence &&
      args.sequence <= UINT32_MAX && args.max_polls && r.request_capacity <= KVAF_SEQ_MAX_REQUESTS &&
      kvaf::ScatterOptionsValid(args.reserved)) {
    // Inputs and persistent queue state may have changed since this physical
    // core last ran the kernel. A new launch is not a scalar-cache invalidate.
    Flush(r.miss_count, 4);
    const auto count = *reinterpret_cast<__gm__ const int32_t*>(r.miss_count);
    if (count >= 0 && uint32_t(count) <= r.request_capacity) {
      const bool fused = kvaf::ScatterOptionEnabled(args.reserved, kvaf::kScatterFusedBuild);
      if (count && !fused && !core) {
        // Keep the original two-pass scalar path for runtime A/B comparison.
        Flush(r.address_table, uint64_t(r.table_capacity) * 8);
        Flush(r.valid_table, r.table_capacity);
        Flush(r.indices, uint64_t(count) * 4);
        Flush(r.offsets, uint64_t(count) * 4);
        Flush(r.output_indices, uint64_t(count) * 4);
      } else if (count) {
        // Only the payload helper still reads output rows through scalar GM.
        // DMA metadata reads bypass that cache and need no full-array DCCI.
        const auto begin = uint64_t(count) * core / r.block_count;
        const auto end = uint64_t(count) * (core + 1) / r.block_count;
        Flush(r.output_indices + begin * 4, (end - begin) * 4);
      }
      if (profile) profile->inputs_ready_cycle = GetSystemCycle();
      if (count) result = Scatter(args, core, count, status, profile);
      else {
        result = KVAF_SEQ_OK;
        if (profile) profile->done_cycle = profile->inputs_ready_cycle;
      }
    }
  }
  if (profile) {
    profile->finish_cycle = GetSystemCycle();
    if (!core && !result && profile->notify_cycle) {
      // Read the CPU report after the local-copy timer stops. Its separate
      // WRITE completed before CPU published the matching done token.
      Flush(args.workspace + 128, 64);
      const auto* report = reinterpret_cast<__gm__ const uint64_t*>(args.workspace + 136);
      auto* fields = reinterpret_cast<__gm__ uint64_t*>(&profile->cpu_magic);
      for (uint32_t i = 0; i < 7; ++i) fields[i] = report[i];
    }
    Flush(reinterpret_cast<uint64_t>(profile), sizeof(*profile));
  }
  status->result = result;
  if (!result) status->phase = KVAF_SEQ_COMPLETE;
  Flush(reinterpret_cast<uint64_t>(status), sizeof(*status));
  // Finish all pipelines before the static-Tensor kernel returns.
  PipeBarrier<PIPE_ALL>();
}

// Standalone AIV dispatch also needs a per-function type in the binary;
// __aicore__ and the Host engine attribute do not export this metadata.
static const struct FunLevelKType
    KvafScatterBatchGetAivKernelV1_kernel_type_section __attribute__(
        (used, section(".ascend.meta.KvafScatterBatchGetAivKernelV1"))) =
        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
