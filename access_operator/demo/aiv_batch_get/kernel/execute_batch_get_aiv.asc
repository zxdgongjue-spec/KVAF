#include "kvaf_batch_get_device.h"

// Preserve the standalone graph ABI. The engine itself accepts an explicit
// owner and prefix, allowing fused operators to call it without a new launch.
extern "C" __global__ __aicore__ void KvafExecuteBatchGetAivKernel(
    KvafExecuteBatchGetKernelArgs args) {
  const uint32_t core = AscendC::GetBlockIdx();
  if (args.block_count == 0U || core >= args.block_count ||
      args.block_count > KVAF_AIV_BATCH_GET_MAX_AIV_CORES ||
      args.miss_count == 0U) {
    return;
  }
  const int32_t count =
      *reinterpret_cast<__gm__ const int32_t *>(args.miss_count);
  if (count < 0 || static_cast<uint32_t>(count) > args.request_capacity) {
    // This range is invalid for every capacity, including UINT32_MAX.
    kvaf_device::KvafBatchGetDevice(args, core, args.request_capacity, 1U);
    return;
  }
  const uint32_t begin = static_cast<uint32_t>(
      (static_cast<uint64_t>(count) * core) / args.block_count);
  const uint32_t end = static_cast<uint32_t>(
      (static_cast<uint64_t>(count) * (core + 1U)) / args.block_count);
  kvaf_device::KvafBatchGetDevice(args, core, begin, end - begin);
}

static const struct FunLevelKType
    KvafExecuteBatchGetAivKernel_kernel_type_section __attribute__(
        (used, section(".ascend.meta.KvafExecuteBatchGetAivKernel"))) =
        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
