#include "kernel_operator.h"
#include "batch_get_abi.h"

// This kernel is intentionally independent from the performance-experiment
// BatchGet kernel.  It proves the ExecuteBatchGet public data ABI: a device
// address table is looked up on AIV, then the established USER_CTL UDMA READ
// path moves the selected Host DDR block to an arbitrary output tensor row.
using namespace AscendC;

namespace {

constexpr uint32_t kEntityMagic = 0x4b564155U;  // "KVAU"
constexpr uint32_t kEntityVersion = 1U;
constexpr uint32_t kQueueMagic = 0x4b564151U;   // "KVAQ"
constexpr uint32_t kReadOpcode = 0x6U;
constexpr uint32_t kWqeBytes = 64U;
constexpr uint32_t kCqeProbeBytes = 32U;
constexpr uint32_t kCqeSubStatusOffset = 2U;
constexpr uint32_t kCqeStatusOffset = 3U;
constexpr uint32_t kCqConsumerMask = 0x003fffffU;
// A failed first-ABI smoke test must return a device status rather than keep
// the host process inside a DCCI polling loop until the runner's 180 s wall
// timeout.  Successful A5 reads complete orders of magnitude below this
// bound; the established baseline keeps its larger diagnostic bound.
constexpr uint32_t kMaxCqPolls = 20000U;
constexpr uint64_t kCacheLineBytes = 64U;
constexpr uint32_t kWqeStageEntries = 256U;

enum ExecuteResult : uint64_t {
  kSuccess = 0U,
  kInvalidArgs = 1U,
  kInvalidEntity = 2U,
  kInvalidQueue = 3U,
  kInvalidLookup = 4U,
  kQueueFull = 5U,
  kCqTimeout = 6U,
  kCqError = 7U,
  kInvalidOutput = 8U,
};

__aicore__ inline uint32_t EidWord(const __gm__ KvafBatchGetDirectUrmaEntity *entity, uint32_t word) {
  const uint32_t byte = word * 4U;
  return static_cast<uint32_t>(entity->remote_eid[byte]) |
         (static_cast<uint32_t>(entity->remote_eid[byte + 1U]) << 8U) |
         (static_cast<uint32_t>(entity->remote_eid[byte + 2U]) << 16U) |
         (static_cast<uint32_t>(entity->remote_eid[byte + 3U]) << 24U);
}

__aicore__ inline void CleanCacheLines(__gm__ uint8_t *address, uint64_t bytes) {
  if (address == nullptr || bytes == 0U) {
    return;
  }
  const uint64_t first = reinterpret_cast<uint64_t>(address) & ~(kCacheLineBytes - 1U);
  const uint64_t last = (reinterpret_cast<uint64_t>(address) + bytes - 1U) & ~(kCacheLineBytes - 1U);
  GlobalTensor<uint8_t> global;
  global.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(first));
  for (uint64_t offset = 0U; offset <= last - first; offset += kCacheLineBytes) {
    DataCacheCleanAndInvalid<uint8_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(global[offset]);
  }
}

__aicore__ inline uint32_t WqeControl(bool completion, uint32_t owner) {
  const uint32_t place_order = completion ? 0x2U : 0x1U;
  return (place_order << 16U) | (1U << 18U) | (1U << 20U) |
         (static_cast<uint32_t>(completion) << 21U) | (1U << 28U) |
         (1U << 29U) | ((owner & 1U) << 31U);
}

// Keep this byte-for-byte aligned with the established scalar producer in
// batch_get_aiv.asc.  In particular, WQEs are first materialized in UB and
// land in the USER_CTL SQ through MTE3; a Scalar GM store to that private SQ
// timed out on A5 and is intentionally not used as a fallback.
__aicore__ inline uint32_t BuildReadWqe(const LocalTensor<uint32_t> &wqe,
                                        const __gm__ KvafBatchGetDirectUrmaEntity *entity,
                                        const __gm__ KvafBatchGetLocalHbmBinding *local_hbm,
                                        uint64_t local_address, uint64_t remote_address,
                                        uint32_t byte_count, bool completion, uint32_t owner,
                                        uint32_t word_base) {
  for (uint32_t word = 0U; word < kWqeBytes / sizeof(uint32_t); ++word) {
    wqe.SetValue(word_base + word, 0U);
  }
  const uint32_t control = WqeControl(completion, owner);
  wqe.SetValue(word_base + 0U, control);
  wqe.SetValue(word_base + 1U, kReadOpcode << 8U);
  wqe.SetValue(word_base + 2U, (entity->tp_id & 0x00ffffffU) | 0x01000000U);
  wqe.SetValue(word_base + 3U, entity->remote_token_id & 0x000fffffU);
  wqe.SetValue(word_base + 4U, EidWord(entity, 0U));
  wqe.SetValue(word_base + 5U, EidWord(entity, 1U));
  wqe.SetValue(word_base + 6U, EidWord(entity, 2U));
  wqe.SetValue(word_base + 7U, EidWord(entity, 3U));
  wqe.SetValue(word_base + 8U, entity->remote_token_value);
  wqe.SetValue(word_base + 10U, static_cast<uint32_t>(remote_address));
  wqe.SetValue(word_base + 11U, static_cast<uint32_t>(remote_address >> 32U));
  wqe.SetValue(word_base + 12U, byte_count);
  wqe.SetValue(word_base + 13U, local_hbm->local_token_id);
  wqe.SetValue(word_base + 14U, static_cast<uint32_t>(local_address));
  wqe.SetValue(word_base + 15U, static_cast<uint32_t>(local_address >> 32U));
  return control;
}

__aicore__ inline void WriteStatus(__gm__ KvafBatchGetCoreStatus *status, uint64_t result,
                                   uint64_t processed, uint64_t completed, uint64_t sq_pi,
                                   uint64_t cq_ci, uint64_t failed_request, uint64_t last_wqe) {
  status->magic = KVAF_AIV_BATCH_GET_STATUS_MAGIC;
  status->processed_request_count = processed;
  status->result = result;
  status->completed_batch_count = completed;
  status->sq_producer_index = sq_pi;
  status->cq_consumer_index = cq_ci;
  status->failed_request_index = failed_request;
  status->last_wqe_protocol = last_wqe;
}

__aicore__ inline bool AddressInsideRemoteMr(uint64_t address, uint32_t block_bytes,
                                             const __gm__ KvafBatchGetDirectUrmaEntity *entity) {
  return entity->remote_host_ddr_size >= block_bytes && address >= entity->remote_host_ddr_address &&
         address - entity->remote_host_ddr_address <= entity->remote_host_ddr_size - block_bytes;
}

__aicore__ inline uint64_t WaitForCompletion(const LocalTensor<uint8_t> &cqe_local,
                                             const __gm__ KvafBatchGetDirectUrmaEntity *entity,
                                             __gm__ KvafBatchGetQueueState *queue) {
  const uint32_t slot = static_cast<uint32_t>(queue->cq_consumer_index % entity->cq_depth);
  __gm__ uint8_t *const cqe_address = reinterpret_cast<__gm__ uint8_t *>(entity->cq_va) +
                                      static_cast<uint64_t>(slot) * entity->cqe_size;
  GlobalTensor<uint8_t> cq_global;
  cq_global.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(entity->cq_va));
  for (uint32_t poll = 0U; poll < kMaxCqPolls; ++poll) {
    CleanCacheLines(cqe_address, kCqeProbeBytes);
    DataCopy(cqe_local, cq_global[slot * entity->cqe_size], kCqeProbeBytes);
    PipeBarrier<PIPE_ALL>();
    const uint8_t owner = static_cast<uint8_t>((cqe_local.GetValue(0U) >> 2U) & 1U);
    const uint8_t expected = static_cast<uint8_t>((queue->cq_consumer_index / entity->cq_depth) & 1U);
    if ((owner ^ expected) == 0U) {
      continue;
    }
    const uint8_t sub_status = cqe_local.GetValue(kCqeSubStatusOffset);
    const uint8_t status = cqe_local.GetValue(kCqeStatusOffset);
    ++queue->cq_consumer_index;
    st_dev(static_cast<uint32_t>(queue->cq_consumer_index) & kCqConsumerMask,
           reinterpret_cast<__gm__ uint32_t *>(entity->cq_db_va), 0);
    return status == 0U && sub_status == 0U ? kSuccess : kCqError;
  }
  return kCqTimeout;
}

}  // namespace

extern "C" __global__ __aicore__ void KvafExecuteBatchGetAivKernel(KvafExecuteBatchGetKernelArgs args) {
  const uint32_t core = GetBlockIdx();
  if (args.block_count == 0U || core >= args.block_count ||
      args.block_count > KVAF_AIV_BATCH_GET_MAX_AIV_CORES || args.address_table == 0U ||
      args.valid_table == 0U || args.indices == 0U || args.mask == 0U || args.output_indices == 0U ||
      args.local_hbm_binding == 0U || args.core_status == 0U || args.channel_entity == 0U || args.queue_state == 0U ||
      args.table_capacity == 0U || args.request_capacity == 0U || args.output_rows == 0U ||
      args.block_bytes == 0U) {
    return;
  }

  __gm__ KvafBatchGetCoreStatus *const status =
      reinterpret_cast<__gm__ KvafBatchGetCoreStatus *>(args.core_status) + core;
  __gm__ KvafBatchGetQueueState *const queue =
      reinterpret_cast<__gm__ KvafBatchGetQueueState *>(args.queue_state) + core;
  __gm__ const KvafBatchGetDirectUrmaEntity *const entity =
      reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity *>(args.channel_entity) + core;
  __gm__ const KvafBatchGetLocalHbmBinding *const local_hbm =
      reinterpret_cast<__gm__ const KvafBatchGetLocalHbmBinding *>(args.local_hbm_binding);
  uint64_t result = kSuccess;
  uint64_t failed_request = UINT64_MAX;
  uint64_t active_count = 0U;
  uint64_t last_wqe = 0U;
  const uint32_t begin = static_cast<uint32_t>((static_cast<uint64_t>(args.request_capacity) * core) /
                                                args.block_count);
  const uint32_t end = static_cast<uint32_t>((static_cast<uint64_t>(args.request_capacity) * (core + 1U)) /
                                              args.block_count);

  if (entity->magic != kEntityMagic || entity->version != kEntityVersion ||
      local_hbm->hbm_address == 0U || local_hbm->hbm_size < args.block_bytes || local_hbm->local_token_id == 0U ||
      entity->remote_host_ddr_address == 0U || entity->remote_host_ddr_size < args.block_bytes ||
      entity->sq_va == 0U || entity->sq_db_va == 0U || entity->sq_depth < 2U ||
      entity->wqe_size != kWqeBytes || entity->cq_va == 0U || entity->cq_db_va == 0U ||
      entity->cq_depth == 0U || entity->cqe_size < kCqeProbeBytes) {
    result = kInvalidEntity;
  }
  if (result == kSuccess && queue->initialized != 0U && queue->magic != kQueueMagic) {
    result = kInvalidQueue;
  }
  if (result == kSuccess && queue->initialized == 0U) {
    queue->magic = kQueueMagic;
    queue->initialized = 1U;
    queue->sq_producer_index = 0U;
    queue->cq_consumer_index = 0U;
    queue->completed_batch_count = 0U;
    queue->last_error = 0U;
  }

  __gm__ const uint64_t *const address_table = reinterpret_cast<__gm__ const uint64_t *>(args.address_table);
  __gm__ const uint8_t *const valid_table = reinterpret_cast<__gm__ const uint8_t *>(args.valid_table);
  __gm__ const int32_t *const indices = reinterpret_cast<__gm__ const int32_t *>(args.indices);
  __gm__ const uint8_t *const mask = reinterpret_cast<__gm__ const uint8_t *>(args.mask);
  __gm__ const int32_t *const output_indices = reinterpret_cast<__gm__ const int32_t *>(args.output_indices);

  // Validate before touching SQ.  A malformed device table must never turn
  // into a UDMA request to an arbitrary address.  The table remains dynamic:
  // only the fixed tensor capacities are part of graph capture.
  if (result == kSuccess) {
    for (uint32_t request = begin; request < end; ++request) {
      if (mask[request] == 0U) {
        continue;
      }
      const int32_t table_index = indices[request];
      const int32_t output_row = output_indices[request];
      if (table_index < 0 || static_cast<uint32_t>(table_index) >= args.table_capacity ||
          valid_table[table_index] == 0U) {
        result = kInvalidLookup;
        failed_request = request;
        break;
      }
      if (output_row < 0 || static_cast<uint32_t>(output_row) >= args.output_rows ||
          static_cast<uint64_t>(output_row) > (local_hbm->hbm_size - args.block_bytes) / args.block_bytes) {
        result = kInvalidOutput;
        failed_request = request;
        break;
      }
      if (!AddressInsideRemoteMr(address_table[table_index], args.block_bytes, entity)) {
        result = kInvalidLookup;
        failed_request = request;
        break;
      }
      ++active_count;
    }
  }
  if (result == kSuccess && active_count >= entity->sq_depth) {
    result = kQueueFull;
  }

  TPipe pipe;
  TBuf<TPosition::VECCALC> wqe_buffer;
  TBuf<TPosition::VECCALC> cqe_buffer;
  pipe.InitBuffer(wqe_buffer, kWqeStageEntries * kWqeBytes);
  pipe.InitBuffer(cqe_buffer, kWqeBytes);
  LocalTensor<uint32_t> wqe_local = wqe_buffer.Get<uint32_t>();
  LocalTensor<uint8_t> cqe_local = cqe_buffer.Get<uint8_t>();
  const uint64_t initial_sq_pi = queue->sq_producer_index;
  if (result == kSuccess && active_count != 0U) {
    GlobalTensor<uint32_t> sq_global;
    sq_global.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t *>(entity->sq_va));
    uint64_t posted = 0U;
    uint32_t cursor = begin;
    while (posted < active_count && cursor < end) {
      const uint64_t stage_pi = initial_sq_pi + posted;
      const uint32_t sq_slot = static_cast<uint32_t>(stage_pi % entity->sq_depth);
      const uint32_t space_to_ring_end = entity->sq_depth - sq_slot;
      const uint32_t stage_limit = space_to_ring_end < kWqeStageEntries ? space_to_ring_end : kWqeStageEntries;
      uint32_t stage_count = 0U;
      while (cursor < end && stage_count < stage_limit) {
        const uint32_t request = cursor++;
        if (mask[request] == 0U) continue;
        const int32_t table_index = indices[request];
        const uint64_t wqe_pi = stage_pi + stage_count;
        const bool completion = posted + stage_count + 1U == active_count;
        const uint32_t owner = 1U - static_cast<uint32_t>((wqe_pi / entity->sq_depth) & 1U);
        const uint64_t local_address = local_hbm->hbm_address +
                                       static_cast<uint64_t>(output_indices[request]) * args.block_bytes;
        const uint32_t control = BuildReadWqe(
            wqe_local, entity, local_hbm, local_address, address_table[table_index], args.block_bytes, completion, owner,
            stage_count * (kWqeBytes / sizeof(uint32_t)));
        if (completion) last_wqe = static_cast<uint64_t>(control);
        ++stage_count;
      }
      if (stage_count == 0U) continue;
      // This is the same established Scalar UB->SQ MTE3 sequence used by the
      // accepted descriptor kernel.  Each stage is ring-contiguous by design.
      PipeBarrier<PIPE_ALL>();
      DataCopy(sq_global[sq_slot * (kWqeBytes / sizeof(uint32_t))], wqe_local,
               stage_count * (kWqeBytes / sizeof(uint32_t)));
      PipeBarrier<PIPE_ALL>();
      CleanCacheLines(reinterpret_cast<__gm__ uint8_t *>(entity->sq_va) +
                          static_cast<uint64_t>(sq_slot) * kWqeBytes,
                      static_cast<uint64_t>(stage_count) * kWqeBytes);
      posted += stage_count;
    }
    if (posted != active_count) result = kInvalidQueue;
  }
  if (result == kSuccess && active_count != 0U) {
    queue->sq_producer_index = initial_sq_pi + active_count;
    st_dev(static_cast<uint32_t>(queue->sq_producer_index),
           reinterpret_cast<__gm__ uint32_t *>(entity->sq_db_va), 0);
    const uint64_t completion_result = WaitForCompletion(cqe_local, entity, queue);
    if (completion_result != kSuccess) {
      result = completion_result;
    } else {
      ++queue->completed_batch_count;
    }
  }
  queue->last_error = result;
  WriteStatus(status, result, active_count, queue->completed_batch_count,
              queue->sq_producer_index, queue->cq_consumer_index, failed_request, last_wqe);
}

static const struct FunLevelKType KvafExecuteBatchGetAivKernel_kernel_type_section __attribute__(
    (used, section(".ascend.meta.KvafExecuteBatchGetAivKernel"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
