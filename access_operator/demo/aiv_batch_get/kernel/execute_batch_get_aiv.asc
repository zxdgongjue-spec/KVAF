#include "kernel_operator.h"
#include "batch_get_abi.h"

#include "simt_api/device_atomic_functions.h"

// Graph-safe ExecuteBatchGet data path.  The Direct-HCCP transport and WQE
// protocol remain the verified KVAF ABI; request validation, mask compaction,
// WQE materialization and round-robin multi-Jetty SQ submission use the
// pipelined AIV_URMA execution model.
using namespace AscendC;

namespace kvaf_fused_get {
namespace {

constexpr uint32_t kEntityMagic = 0x4b564155U;  // "KVAU"
constexpr uint32_t kEntityVersion = 1U;
constexpr uint32_t kQueueMagic = 0x4b564151U;   // "KVAQ"
constexpr uint32_t kReadOpcode = 0x6U;
constexpr uint32_t kWqeBytes = 64U;
constexpr uint32_t kTransferBytes = KVAF_AIV_BATCH_GET_WQE_DATA_BYTES;
constexpr uint32_t kAddressTableEntryBytes =
    KVAF_AIV_BATCH_GET_ADDRESS_TABLE_ENTRY_BYTES;
constexpr uint32_t kWqesPerPost = 32U;
constexpr uint32_t kWqeBankBytes = kWqesPerPost * kWqeBytes;
constexpr uint32_t kWqeBankCount = 2U;
constexpr uint32_t kValidationThreads = 1024U;
constexpr uint32_t kCompactThreads = 2048U;
constexpr uint32_t kActiveRequestCapacity = 16384U;
// P1 ExactScanSpeculativeGet produces an already-valid, dense wave for one
// Get lane.  It never needs the generic mask-compaction arrays above: two
// 32-WQE banks are sufficient to materialize and submit at most 256 reads.
constexpr uint32_t kDenseRequestCapacity = 256U;
constexpr uint32_t kDenseWqeScratchBytes = kWqeBankBytes * kWqeBankCount;
constexpr uint32_t kCompactEventId = 2U;
constexpr uint32_t kCqeProbeBytes = 32U;
constexpr uint32_t kCqConsumerMask = 0x003fffffU;
constexpr uint32_t kMaxCqPolls = 20000U;
constexpr uint64_t kCacheLineBytes = 64U;
constexpr uint32_t kLocalMemoryBytes =
    KVAF_AIV_BATCH_GET_LOCAL_MEMORY_BYTES;

// UB layout. WQE banks are consumed by MTE3 while the vector pipeline fills
// the other bank. Compacting caches both the table index and original request
// ID, moving the indices[] GM read out of the serial per-post WQE construction
// path. Callers guarantee at most 16384 active requests per AIV.
constexpr uint32_t kActiveTableIndicesUbOffset =
    kWqeBankBytes * kWqeBankCount;
constexpr uint32_t kActiveTableIndicesUbBytes =
    kActiveRequestCapacity * sizeof(uint32_t);
constexpr uint32_t kActiveRequestIdsUbOffset =
    kActiveTableIndicesUbOffset + kActiveTableIndicesUbBytes;
constexpr uint32_t kActiveRequestIdsUbBytes =
    kActiveRequestCapacity * sizeof(uint32_t);
constexpr uint32_t kActiveCountUbOffset =
    kActiveRequestIdsUbOffset + kActiveRequestIdsUbBytes;
constexpr uint32_t kValidationFailureIdsUbOffset =
    kActiveCountUbOffset + kCacheLineBytes;
constexpr uint32_t kValidationFailureIdsUbBytes =
    kValidationThreads * sizeof(uint32_t);
constexpr uint32_t kValidationFailureCodesUbOffset =
    kValidationFailureIdsUbOffset + kValidationFailureIdsUbBytes;
constexpr uint32_t kValidationFailureCodesUbBytes =
    kValidationThreads * sizeof(uint32_t);

static_assert(kWqeBankBytes * kWqeBankCount <=
                  kActiveTableIndicesUbOffset,
              "BatchGet WQE banks overlap active table indices");
static_assert(kActiveTableIndicesUbOffset +
                      kActiveTableIndicesUbBytes <=
                  kActiveRequestIdsUbOffset,
              "BatchGet active table indices overlap request IDs");
static_assert(kValidationFailureCodesUbOffset +
                      kValidationFailureCodesUbBytes <=
                  kLocalMemoryBytes,
              "BatchGet UB scratch exceeds configured local memory");
static_assert(kDenseWqeScratchBytes <= 8U * 1024U,
              "Dense BatchGet scratch must remain within the P1 UB budget");

enum ExecuteResult : uint64_t {
  kSuccess = 0U,
  kInvalidArgs = 1U,
  kInvalidEntity = 2U,
  kInvalidQueue = 3U,
  kInvalidLookup = 4U,
  kQueueFull = 5U,
  kCqTimeout = 6U,
  kCqError = 7U,
  kInvalidOutput = 8U,
};

struct PreparedPost {
  uint64_t sq_base_address;
  uint64_t sq_db_address;
  uint64_t queue_state_address;
  uint64_t current_head;
  uint64_t next_head;
  uint32_t sq_depth;
  uint32_t wqe_count;
  uint32_t event_id;
};

struct PendingPost {
  uint64_t sq_db_address;
  uint64_t queue_state_address;
  uint64_t next_head;
  uint32_t event_id;
};

__aicore__ inline void CleanCacheLines(__gm__ uint8_t *address,
                                       uint64_t bytes) {
  if (address == nullptr || bytes == 0U) {
    return;
  }
  const uint64_t first =
      reinterpret_cast<uint64_t>(address) & ~(kCacheLineBytes - 1U);
  const uint64_t last =
      (reinterpret_cast<uint64_t>(address) + bytes - 1U) &
      ~(kCacheLineBytes - 1U);
  GlobalTensor<uint8_t> global;
  global.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(first));
  for (uint64_t offset = 0U; offset <= last - first;
       offset += kCacheLineBytes) {
    DataCacheCleanAndInvalid<uint8_t, CacheLine::SINGLE_CACHE_LINE,
                             DcciDst::CACHELINE_OUT>(global[offset]);
  }
}

__aicore__ inline uint32_t WqeControl(bool completion, uint32_t owner) {
  const uint32_t place_order = completion ? 0x2U : 0x1U;
  return (place_order << 16U) | (1U << 18U) | (1U << 20U) |
         (static_cast<uint32_t>(completion) << 21U) | (1U << 28U) |
         (1U << 29U) | ((owner & 1U) << 31U);
}

__aicore__ inline void WriteStatus(__gm__ KvafBatchGetCoreStatus *status,
                                   uint64_t result, uint64_t processed,
                                   uint64_t completed, uint64_t sq_pi,
                                   uint64_t cq_ci, uint64_t failed_request,
                                   uint64_t last_wqe) {
  status->magic = KVAF_AIV_BATCH_GET_STATUS_MAGIC;
  status->processed_request_count = processed;
  status->result = result;
  status->completed_batch_count = completed;
  status->sq_producer_index = sq_pi;
  status->cq_consumer_index = cq_ci;
  status->failed_request_index = failed_request;
  status->last_wqe_protocol = last_wqe;
}

__aicore__ inline void WriteProfile(
    __gm__ KvafBatchGetCoreStatus *status, uint64_t start_cycle,
    uint64_t setup_done_cycle, uint64_t compact_done_cycle,
    uint64_t first_doorbell_cycle, uint64_t post_done_cycle,
    uint64_t completion_done_cycle, uint64_t finish_cycle,
    uint64_t active_requests, uint64_t total_posts,
    const uint64_t *jetty_completion_wait_cycles,
    const uint32_t *jetty_completion_polls) {
  status->profile.magic = KVAF_AIV_BATCH_GET_PROFILE_MAGIC;
  status->profile.kernel_start_cycle = start_cycle;
  status->profile.setup_done_cycle = setup_done_cycle;
  status->profile.compact_done_cycle = compact_done_cycle;
  status->profile.first_doorbell_cycle = first_doorbell_cycle;
  status->profile.post_done_cycle = post_done_cycle;
  status->profile.completion_done_cycle = completion_done_cycle;
  status->profile.kernel_finish_cycle = finish_cycle;
  status->profile.active_requests = active_requests;
  status->profile.total_posts = total_posts;
#pragma unroll
  for (uint32_t jetty = 0U;
       jetty < KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE; ++jetty) {
    status->profile.jetty_completion_wait_cycles[jetty] =
        jetty_completion_wait_cycles[jetty];
    status->profile.jetty_completion_polls[jetty] =
        jetty_completion_polls[jetty];
  }
}

__aicore__ inline void ConfigureUbToGmCopy() {
  uint64_t loop_size = 1U | (1ULL << 21U);
  set_loop_size_ubtoout(loop_size);
  set_loop1_stride_ubtoout(0U);
  set_loop2_stride_ubtoout(0U);
  set_atomic_none();
}

__aicore__ inline void CopyUbToGm(__gm__ void *destination,
                                  __ubuf__ void *source, uint64_t bytes) {
  uint64_t config0 = 1ULL << 4U;
  config0 |= bytes << 25U;
  copy_ubuf_to_gm_align_v2(reinterpret_cast<__gm__ float *>(destination),
                           reinterpret_cast<__ubuf__ float *>(source),
                           config0, 0U);
}

__simt_vf__ __aicore__ LAUNCH_BOUND(1024)
inline void ValidateBatchGetRequests(
    __gm__ const uint64_t *address_table,
    __gm__ const uint8_t *valid_table, __gm__ const int32_t *indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint8_t *mask, __gm__ const int32_t *output_indices,
    uint32_t request_begin, uint32_t request_end, uint32_t table_capacity,
    uint32_t output_rows, uint32_t block_bytes, uint64_t remote_base,
    uint64_t remote_bytes, uint64_t local_bytes,
    __ubuf__ uint32_t *active_count,
    __ubuf__ uint32_t *failure_request_ids,
    __ubuf__ uint32_t *failure_codes) {
  const uint32_t thread = threadIdx.x;
  uint32_t local_active_count = 0U;
  uint32_t first_failure = UINT32_MAX;
  uint32_t first_failure_code = static_cast<uint32_t>(kSuccess);

  for (uint64_t request_value =
           static_cast<uint64_t>(request_begin) + thread;
       request_value < request_end;
       request_value += kValidationThreads) {
    const uint32_t request = static_cast<uint32_t>(request_value);
    if (mask[request] == 0U) {
      continue;
    }
    ++local_active_count;
    if (first_failure != UINT32_MAX) {
      continue;
    }

    const int32_t table_index = indices[request];
    const int32_t offset = offsets[request];
    const int32_t output_row = output_indices[request];
    if (table_index < 0 ||
        static_cast<uint32_t>(table_index) >= table_capacity ||
        valid_table[table_index] == 0U) {
      first_failure = request;
      first_failure_code = static_cast<uint32_t>(kInvalidLookup);
      continue;
    }
    if (offset < 0 ||
        static_cast<uint32_t>(offset) >
            kAddressTableEntryBytes - kTransferBytes) {
      first_failure = request;
      first_failure_code = static_cast<uint32_t>(kInvalidLookup);
      continue;
    }
    if (output_row < 0 || static_cast<uint32_t>(output_row) >= output_rows ||
        local_bytes < block_bytes ||
        static_cast<uint64_t>(output_row) >
            (local_bytes - block_bytes) / block_bytes) {
      first_failure = request;
      first_failure_code = static_cast<uint32_t>(kInvalidOutput);
      continue;
    }

    const uint64_t table_base = address_table[table_index];
    if (remote_bytes < kAddressTableEntryBytes || table_base < remote_base ||
        table_base - remote_base > remote_bytes - kAddressTableEntryBytes) {
      first_failure = request;
      first_failure_code = static_cast<uint32_t>(kInvalidLookup);
      continue;
    }
    const uint64_t remote_address =
        table_base + static_cast<uint32_t>(offset);
    if (remote_address < table_base) {
      first_failure = request;
      first_failure_code = static_cast<uint32_t>(kInvalidLookup);
      continue;
    }
    if (remote_bytes < block_bytes || remote_address < remote_base ||
        remote_address - remote_base > remote_bytes - block_bytes) {
      first_failure = request;
      first_failure_code = static_cast<uint32_t>(kInvalidLookup);
    }
  }

  if (local_active_count != 0U) {
    asc_atomic_add(active_count, local_active_count);
  }
  failure_request_ids[thread] = first_failure;
  failure_codes[thread] = first_failure_code;
}

__aicore__ inline uint32_t RunBatchGetValidation(
    __gm__ const uint64_t *address_table,
    __gm__ const uint8_t *valid_table, __gm__ const int32_t *indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint8_t *mask, __gm__ const int32_t *output_indices,
    uint32_t request_begin, uint32_t request_end, uint32_t table_capacity,
    uint32_t output_rows, uint32_t block_bytes, uint64_t remote_base,
    uint64_t remote_bytes, uint64_t local_bytes, uint64_t *result,
    uint64_t *failed_request) {
  __ubuf__ uint32_t *active_count =
      reinterpret_cast<__ubuf__ uint32_t *>(get_imm(kActiveCountUbOffset));
  __ubuf__ uint32_t *failure_request_ids =
      reinterpret_cast<__ubuf__ uint32_t *>(
          get_imm(kValidationFailureIdsUbOffset));
  __ubuf__ uint32_t *failure_codes =
      reinterpret_cast<__ubuf__ uint32_t *>(
          get_imm(kValidationFailureCodesUbOffset));
  *active_count = 0U;

  set_flag(PIPE_S, PIPE_V, static_cast<event_t>(kCompactEventId));
  wait_flag(PIPE_S, PIPE_V, static_cast<event_t>(kCompactEventId));
  AscendC::Simt::VF_CALL<ValidateBatchGetRequests>(
      AscendC::Simt::Dim3{kValidationThreads, 1U, 1U}, address_table,
      valid_table, indices, offsets, mask, output_indices, request_begin, request_end,
      table_capacity, output_rows, block_bytes, remote_base, remote_bytes,
      local_bytes, active_count, failure_request_ids, failure_codes);
  set_flag(PIPE_V, PIPE_S, static_cast<event_t>(kCompactEventId));
  wait_flag(PIPE_V, PIPE_S, static_cast<event_t>(kCompactEventId));

  uint32_t first_failure = UINT32_MAX;
  uint32_t first_failure_code = static_cast<uint32_t>(kSuccess);
  for (uint32_t thread = 0U; thread < kValidationThreads; ++thread) {
    if (failure_request_ids[thread] < first_failure) {
      first_failure = failure_request_ids[thread];
      first_failure_code = failure_codes[thread];
    }
  }
  if (first_failure != UINT32_MAX) {
    *result = first_failure_code;
    *failed_request = first_failure;
  }
  return *active_count;
}

__simt_vf__ __aicore__ LAUNCH_BOUND(2048)
inline void CompactBatchGetMask(__gm__ const uint8_t *mask,
                                __gm__ const int32_t *indices,
                                uint32_t request_begin,
                                uint32_t request_end,
                                __ubuf__ uint32_t *active_table_indices,
                                __ubuf__ uint32_t *active_request_ids,
                                __ubuf__ uint32_t *active_count) {
  for (uint64_t request_value =
           static_cast<uint64_t>(request_begin) + threadIdx.x;
       request_value < request_end;
       request_value += kCompactThreads) {
    const uint32_t request = static_cast<uint32_t>(request_value);
    if (mask[request] != 0U) {
      const uint32_t table_index =
          static_cast<uint32_t>(indices[request]);
      const uint32_t position = asc_atomic_add(active_count, 1U);
      if (position < kActiveRequestCapacity) {
        active_table_indices[position] = table_index;
        active_request_ids[position] = request;
      }
    }
  }
}

__aicore__ inline uint32_t CompactBatchGetRequests(
    __gm__ const uint8_t *mask, __gm__ const int32_t *indices,
    uint32_t request_begin, uint32_t request_end,
    __ubuf__ uint32_t *active_table_indices,
    __ubuf__ uint32_t *active_request_ids) {
  __ubuf__ uint32_t *active_count =
      reinterpret_cast<__ubuf__ uint32_t *>(get_imm(kActiveCountUbOffset));
  *active_count = 0U;

  set_flag(PIPE_S, PIPE_V, static_cast<event_t>(kCompactEventId));
  wait_flag(PIPE_S, PIPE_V, static_cast<event_t>(kCompactEventId));
  AscendC::Simt::VF_CALL<CompactBatchGetMask>(
      AscendC::Simt::Dim3{kCompactThreads, 1U, 1U}, mask, indices,
      request_begin, request_end, active_table_indices, active_request_ids,
      active_count);
  set_flag(PIPE_V, PIPE_S, static_cast<event_t>(kCompactEventId));
  wait_flag(PIPE_V, PIPE_S, static_cast<event_t>(kCompactEventId));
  return *active_count;
}

__simt_vf__ __aicore__ LAUNCH_BOUND(32)
inline void FillBatchGetReadWqes(
    __ubuf__ const uint32_t *active_table_indices,
    __ubuf__ const uint32_t *active_request_ids,
    __gm__ const int32_t *output_indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint64_t *address_table, uint32_t active_offset,
    uint32_t block_bytes, uint64_t output_base, uint64_t current_head,
    uint32_t wqe_count, uint32_t completion_on_last_wqe,
    uint32_t ub_base_offset, uint32_t sq_depth,
    uint32_t tp_id, uint32_t remote_token_id,
    uint32_t remote_token_value, uint32_t local_token_id,
    uint64_t remote_eid_low, uint64_t remote_eid_high) {
  const uint32_t slot = threadIdx.x;
  if (slot >= wqe_count) {
    return;
  }

  const uint32_t request = active_request_ids[active_offset + slot];
  const uint32_t table_index = active_table_indices[active_offset + slot];
  const uint32_t output_row =
      static_cast<uint32_t>(output_indices[request]);
  const uint64_t remote_address =
      address_table[table_index] + static_cast<uint32_t>(offsets[request]);
  const uint64_t local_address =
      output_base + static_cast<uint64_t>(output_row) * block_bytes;
  const uint64_t wqe_pi = current_head + slot;
  const uint32_t owner =
      1U - static_cast<uint32_t>((wqe_pi / sq_depth) & 1U);
  const bool completion =
      completion_on_last_wqe != 0U && slot + 1U == wqe_count;
  const uint32_t place_order = completion ? 0x2U : 0x1U;

  uint32_t words[16];
  words[0] = (place_order << 16U) | (1U << 18U) | (1U << 20U) |
             (static_cast<uint32_t>(completion) << 21U) | (1U << 28U) |
             (1U << 29U) | ((owner & 1U) << 31U);
  words[1] = kReadOpcode << 8U;
  words[2] = (tp_id & 0x00ffffffU) | 0x01000000U;
  words[3] = remote_token_id & 0x000fffffU;
  words[4] = static_cast<uint32_t>(remote_eid_low);
  words[5] = static_cast<uint32_t>(remote_eid_low >> 32U);
  words[6] = static_cast<uint32_t>(remote_eid_high);
  words[7] = static_cast<uint32_t>(remote_eid_high >> 32U);
  words[8] = remote_token_value;
  words[9] = 0U;
  words[10] = static_cast<uint32_t>(remote_address);
  words[11] = static_cast<uint32_t>(remote_address >> 32U);
  words[12] = kTransferBytes;
  words[13] = local_token_id;
  words[14] = static_cast<uint32_t>(local_address);
  words[15] = static_cast<uint32_t>(local_address >> 32U);

  __ubuf__ uint32_t *wqe_words =
      reinterpret_cast<__ubuf__ uint32_t *>(
          get_imm(ub_base_offset + slot * kWqeBytes));
#pragma unroll
  for (uint32_t word = 0U; word < 16U; ++word) {
    wqe_words[word] = words[word];
  }
}

__aicore__ inline void PreparePostVectorStage(
    __ubuf__ const uint32_t *active_table_indices,
    __ubuf__ const uint32_t *active_request_ids,
    __gm__ const int32_t *output_indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint64_t *address_table, uint32_t active_offset,
    uint32_t block_bytes, uint64_t output_base, uint64_t current_head,
    uint32_t wqe_count, uint32_t completion_on_last_wqe,
    uint32_t bank_id, uint32_t wait_for_bank_reuse,
    __gm__ const KvafBatchGetDirectUrmaEntity *entity,
    __gm__ KvafBatchGetQueueState *queue,
    PreparedPost *prepared) {
  if (wait_for_bank_reuse != 0U) {
    wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank_id));
  }

  const uint64_t remote_eid_low =
      *reinterpret_cast<__gm__ const uint64_t *>(entity->remote_eid);
  const uint64_t remote_eid_high =
      *reinterpret_cast<__gm__ const uint64_t *>(&(entity->remote_eid[8]));
  const uint32_t ub_base_offset = bank_id * kWqeBankBytes;
  AscendC::Simt::VF_CALL<FillBatchGetReadWqes>(
      AscendC::Simt::Dim3{kWqesPerPost, 1U, 1U}, active_table_indices,
      active_request_ids, output_indices, offsets, address_table, active_offset,
      block_bytes, output_base, current_head, wqe_count,
      completion_on_last_wqe, ub_base_offset,
      entity->sq_depth, entity->tp_id, entity->remote_token_id,
      entity->remote_token_value, entity->local_token_id, remote_eid_low,
      remote_eid_high);
  set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank_id));

  prepared->sq_base_address = entity->sq_va;
  prepared->sq_db_address = entity->sq_db_va;
  prepared->queue_state_address = reinterpret_cast<uint64_t>(queue);
  prepared->current_head = current_head;
  prepared->next_head = current_head + wqe_count;
  prepared->sq_depth = entity->sq_depth;
  prepared->wqe_count = wqe_count;
  prepared->event_id = bank_id;
}

__aicore__ inline void CopyPreparedPostToSq(const PreparedPost *prepared) {
  const uint32_t ring_head =
      static_cast<uint32_t>(prepared->current_head % prepared->sq_depth);
  const uint32_t ub_base_offset = prepared->event_id * kWqeBankBytes;
  if (ring_head + prepared->wqe_count <= prepared->sq_depth) {
    CopyUbToGm(
        reinterpret_cast<__gm__ void *>(
            prepared->sq_base_address +
            static_cast<uint64_t>(ring_head) * kWqeBytes),
        reinterpret_cast<__ubuf__ void *>(get_imm(ub_base_offset)),
        static_cast<uint64_t>(prepared->wqe_count) * kWqeBytes);
    return;
  }

  const uint32_t first_count = prepared->sq_depth - ring_head;
  CopyUbToGm(
      reinterpret_cast<__gm__ void *>(
          prepared->sq_base_address +
          static_cast<uint64_t>(ring_head) * kWqeBytes),
      reinterpret_cast<__ubuf__ void *>(get_imm(ub_base_offset)),
      static_cast<uint64_t>(first_count) * kWqeBytes);
  CopyUbToGm(
      reinterpret_cast<__gm__ void *>(prepared->sq_base_address),
      reinterpret_cast<__ubuf__ void *>(
          get_imm(ub_base_offset + first_count * kWqeBytes)),
      static_cast<uint64_t>(prepared->wqe_count - first_count) *
          kWqeBytes);
}

__aicore__ inline void PreparePostMte3Stage(const PreparedPost *prepared,
                                            uint32_t release_bank_to_vector,
                                            PendingPost *pending) {
  wait_flag(PIPE_V, PIPE_MTE3,
            static_cast<event_t>(prepared->event_id));
  CopyPreparedPostToSq(prepared);
  set_flag(PIPE_MTE3, PIPE_S,
           static_cast<event_t>(prepared->event_id));
  if (release_bank_to_vector != 0U) {
    set_flag(PIPE_MTE3, PIPE_V,
             static_cast<event_t>(prepared->event_id));
  }
  pending->next_head = prepared->next_head;
  pending->sq_db_address = prepared->sq_db_address;
  pending->queue_state_address = prepared->queue_state_address;
  pending->event_id = prepared->event_id;
}

__aicore__ inline void CommitPostScalarStage(const PendingPost *pending) {
  wait_flag(PIPE_MTE3, PIPE_S,
            static_cast<event_t>(pending->event_id));
  __gm__ KvafBatchGetQueueState *const queue =
      reinterpret_cast<__gm__ KvafBatchGetQueueState *>(
          pending->queue_state_address);
  queue->sq_producer_index = pending->next_head;
  st_dev(static_cast<uint32_t>(pending->next_head),
         reinterpret_cast<__gm__ uint32_t *>(pending->sq_db_address), 0);
}

__aicore__ inline void PostActiveRequests(
    __ubuf__ const uint32_t *active_table_indices,
    __ubuf__ const uint32_t *active_request_ids,
    __gm__ const int32_t *output_indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint64_t *address_table, uint32_t active_request_count,
    uint32_t block_bytes, uint32_t jettys_per_core,
    __gm__ const KvafBatchGetDirectUrmaEntity *entities,
    __gm__ KvafBatchGetQueueState *queues, uint32_t profile_enabled,
    uint64_t *first_doorbell_cycle, uint64_t *last_wqe) {
  PreparedPost prepared_posts[kWqeBankCount];
  PendingPost pending_posts[kWqeBankCount];
  uint64_t current_heads[KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE];
  for (uint32_t jetty = 0U; jetty < jettys_per_core; ++jetty) {
    current_heads[jetty] = queues[jetty].sq_producer_index;
  }
  const uint32_t total_posts =
      (active_request_count + kWqesPerPost - 1U) / kWqesPerPost;

  for (uint32_t post_index = 0U; post_index < total_posts; ++post_index) {
    if (post_index != 0U) {
      const uint32_t previous_post = post_index - 1U;
      const uint32_t previous_bank = previous_post % kWqeBankCount;
      const uint32_t release_bank_to_vector =
          previous_post + kWqeBankCount < total_posts;
      PreparePostMte3Stage(&prepared_posts[previous_bank],
                           release_bank_to_vector,
                           &pending_posts[previous_bank]);
    }

    const uint32_t bank_id = post_index % kWqeBankCount;
    const uint32_t jetty = post_index % jettys_per_core;
    const uint32_t active_offset = post_index * kWqesPerPost;
    uint32_t wqe_count = active_request_count - active_offset;
    if (wqe_count > kWqesPerPost) {
      wqe_count = kWqesPerPost;
    }
    const uint32_t completion_on_last_wqe =
        post_index + jettys_per_core >= total_posts;
    __gm__ const KvafBatchGetDirectUrmaEntity *const entity =
        entities + jetty;
    __gm__ KvafBatchGetQueueState *const queue = queues + jetty;
    PreparePostVectorStage(
        active_table_indices, active_request_ids, output_indices,
        offsets, address_table, active_offset, block_bytes,
        entity->local_hbm_address,
        current_heads[jetty], wqe_count, completion_on_last_wqe, bank_id,
        post_index >= kWqeBankCount, entity, queue,
        &prepared_posts[bank_id]);
    current_heads[jetty] += wqe_count;

    if (post_index + 1U == total_posts) {
      const uint64_t last_pi = current_heads[jetty] - 1U;
      const uint32_t last_owner =
          1U - static_cast<uint32_t>((last_pi / entity->sq_depth) & 1U);
      *last_wqe = WqeControl(true, last_owner);
    }

    if (post_index >= kWqeBankCount) {
      const uint32_t commit_bank =
          (post_index - kWqeBankCount) % kWqeBankCount;
      CommitPostScalarStage(&pending_posts[commit_bank]);
      if (profile_enabled != 0U && *first_doorbell_cycle == 0U) {
        *first_doorbell_cycle =
            static_cast<uint64_t>(AscendC::GetSystemCycle());
      }
    }
  }

  if (total_posts != 0U) {
    const uint32_t final_post = total_posts - 1U;
    const uint32_t final_bank = final_post % kWqeBankCount;
    PreparePostMte3Stage(&prepared_posts[final_bank], 0U,
                         &pending_posts[final_bank]);
    if (total_posts > 1U) {
      const uint32_t penultimate_bank =
          (total_posts - 2U) % kWqeBankCount;
      CommitPostScalarStage(&pending_posts[penultimate_bank]);
      if (profile_enabled != 0U && *first_doorbell_cycle == 0U) {
        *first_doorbell_cycle =
            static_cast<uint64_t>(AscendC::GetSystemCycle());
      }
    }
    CommitPostScalarStage(&pending_posts[final_bank]);
    if (profile_enabled != 0U && *first_doorbell_cycle == 0U) {
      *first_doorbell_cycle =
          static_cast<uint64_t>(AscendC::GetSystemCycle());
    }
  }
}

// P1's producer writes only valid descriptors and publishes them densely in
// request order.  This is deliberately separate from FillBatchGetReadWqes:
// the normal path needs active_table_indices/active_request_ids generated by
// mask compaction, while this bounded path must not touch that 128-KiB UB
// scratch at all.
__simt_vf__ __aicore__ LAUNCH_BOUND(32)
inline void FillDenseBatchGetReadWqes(
    __gm__ const int32_t *indices, __gm__ const int32_t *output_indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint64_t *address_table, uint32_t request_offset,
    uint32_t block_bytes, uint64_t output_base, uint64_t current_head,
    uint32_t wqe_count, uint32_t completion_on_last_wqe,
    __ubuf__ uint8_t *wqe_bank, uint32_t sq_depth, uint32_t tp_id,
    uint32_t remote_token_id, uint32_t remote_token_value,
    uint32_t local_token_id, uint64_t remote_eid_low,
    uint64_t remote_eid_high) {
  const uint32_t slot = threadIdx.x;
  if (slot >= wqe_count) {
    return;
  }

  const uint32_t request = request_offset + slot;
  const uint32_t table_index = static_cast<uint32_t>(indices[request]);
  const uint32_t output_row =
      static_cast<uint32_t>(output_indices[request]);
  const uint64_t remote_address =
      address_table[table_index] + static_cast<uint32_t>(offsets[request]);
  const uint64_t local_address =
      output_base + static_cast<uint64_t>(output_row) * block_bytes;
  const uint64_t wqe_pi = current_head + slot;
  const uint32_t owner =
      1U - static_cast<uint32_t>((wqe_pi / sq_depth) & 1U);
  const bool completion =
      completion_on_last_wqe != 0U && slot + 1U == wqe_count;
  const uint32_t place_order = completion ? 0x2U : 0x1U;

  uint32_t words[16];
  words[0] = (place_order << 16U) | (1U << 18U) | (1U << 20U) |
             (static_cast<uint32_t>(completion) << 21U) | (1U << 28U) |
             (1U << 29U) | ((owner & 1U) << 31U);
  words[1] = kReadOpcode << 8U;
  words[2] = (tp_id & 0x00ffffffU) | 0x01000000U;
  words[3] = remote_token_id & 0x000fffffU;
  words[4] = static_cast<uint32_t>(remote_eid_low);
  words[5] = static_cast<uint32_t>(remote_eid_low >> 32U);
  words[6] = static_cast<uint32_t>(remote_eid_high);
  words[7] = static_cast<uint32_t>(remote_eid_high >> 32U);
  words[8] = remote_token_value;
  words[9] = 0U;
  words[10] = static_cast<uint32_t>(remote_address);
  words[11] = static_cast<uint32_t>(remote_address >> 32U);
  words[12] = kTransferBytes;
  words[13] = local_token_id;
  words[14] = static_cast<uint32_t>(local_address);
  words[15] = static_cast<uint32_t>(local_address >> 32U);

  __ubuf__ uint32_t *const wqe_words =
      reinterpret_cast<__ubuf__ uint32_t *>(wqe_bank + slot * kWqeBytes);
#pragma unroll
  for (uint32_t word = 0U; word < 16U; ++word) {
    wqe_words[word] = words[word];
  }
}

__aicore__ inline void PrepareDensePostVectorStage(
    __gm__ const int32_t *indices, __gm__ const int32_t *output_indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint64_t *address_table, uint32_t request_offset,
    uint32_t block_bytes, uint64_t output_base, uint64_t current_head,
    uint32_t wqe_count, uint32_t completion_on_last_wqe,
    uint32_t bank_id, uint32_t wait_for_bank_reuse,
    __ubuf__ uint8_t *wqe_bank,
    __gm__ const KvafBatchGetDirectUrmaEntity *entity,
    __gm__ KvafBatchGetQueueState *queue, PreparedPost *prepared) {
  if (wait_for_bank_reuse != 0U) {
    wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank_id));
  }

  const uint64_t remote_eid_low =
      *reinterpret_cast<__gm__ const uint64_t *>(entity->remote_eid);
  const uint64_t remote_eid_high =
      *reinterpret_cast<__gm__ const uint64_t *>(&(entity->remote_eid[8]));
  AscendC::Simt::VF_CALL<FillDenseBatchGetReadWqes>(
      AscendC::Simt::Dim3{kWqesPerPost, 1U, 1U}, indices, output_indices,
      offsets, address_table, request_offset, block_bytes, output_base,
      current_head, wqe_count, completion_on_last_wqe, wqe_bank,
      entity->sq_depth, entity->tp_id, entity->remote_token_id,
      entity->remote_token_value, entity->local_token_id, remote_eid_low,
      remote_eid_high);
  set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank_id));

  prepared->sq_base_address = entity->sq_va;
  prepared->sq_db_address = entity->sq_db_va;
  prepared->queue_state_address = reinterpret_cast<uint64_t>(queue);
  prepared->current_head = current_head;
  prepared->next_head = current_head + wqe_count;
  prepared->sq_depth = entity->sq_depth;
  prepared->wqe_count = wqe_count;
  prepared->event_id = bank_id;
}

__aicore__ inline void CopyDensePreparedPostToSq(
    const PreparedPost *prepared, __ubuf__ uint8_t *wqe_bank) {
  const uint32_t ring_head =
      static_cast<uint32_t>(prepared->current_head % prepared->sq_depth);
  if (ring_head + prepared->wqe_count <= prepared->sq_depth) {
    CopyUbToGm(
        reinterpret_cast<__gm__ void *>(
            prepared->sq_base_address +
            static_cast<uint64_t>(ring_head) * kWqeBytes),
        reinterpret_cast<__ubuf__ void *>(wqe_bank),
        static_cast<uint64_t>(prepared->wqe_count) * kWqeBytes);
    return;
  }

  const uint32_t first_count = prepared->sq_depth - ring_head;
  CopyUbToGm(
      reinterpret_cast<__gm__ void *>(
          prepared->sq_base_address +
          static_cast<uint64_t>(ring_head) * kWqeBytes),
      reinterpret_cast<__ubuf__ void *>(wqe_bank),
      static_cast<uint64_t>(first_count) * kWqeBytes);
  CopyUbToGm(
      reinterpret_cast<__gm__ void *>(prepared->sq_base_address),
      reinterpret_cast<__ubuf__ void *>(wqe_bank + first_count * kWqeBytes),
      static_cast<uint64_t>(prepared->wqe_count - first_count) *
          kWqeBytes);
}

__aicore__ inline void PrepareDensePostMte3Stage(
    const PreparedPost *prepared, __ubuf__ uint8_t *wqe_bank,
    uint32_t release_bank_to_vector, PendingPost *pending) {
  wait_flag(PIPE_V, PIPE_MTE3,
            static_cast<event_t>(prepared->event_id));
  CopyDensePreparedPostToSq(prepared, wqe_bank);
  set_flag(PIPE_MTE3, PIPE_S,
           static_cast<event_t>(prepared->event_id));
  if (release_bank_to_vector != 0U) {
    set_flag(PIPE_MTE3, PIPE_V,
             static_cast<event_t>(prepared->event_id));
  }
  pending->next_head = prepared->next_head;
  pending->sq_db_address = prepared->sq_db_address;
  pending->queue_state_address = prepared->queue_state_address;
  pending->event_id = prepared->event_id;
}

__aicore__ inline void PostDenseBatchGetRequests(
    __gm__ const int32_t *indices, __gm__ const int32_t *output_indices,
    __gm__ const int32_t *offsets,
    __gm__ const uint64_t *address_table, uint32_t request_count,
    uint32_t block_bytes, uint32_t jettys_per_core,
    __gm__ const KvafBatchGetDirectUrmaEntity *entities,
    __gm__ KvafBatchGetQueueState *queues,
    __ubuf__ uint8_t *wqe_banks, uint32_t profile_enabled,
    uint64_t *first_doorbell_cycle, uint64_t *last_wqe) {
  PreparedPost prepared_posts[kWqeBankCount];
  PendingPost pending_posts[kWqeBankCount];
  uint64_t current_heads[KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE];
  for (uint32_t jetty = 0U; jetty < jettys_per_core; ++jetty) {
    current_heads[jetty] = queues[jetty].sq_producer_index;
  }
  const uint32_t total_posts =
      (request_count + kWqesPerPost - 1U) / kWqesPerPost;

  for (uint32_t post_index = 0U; post_index < total_posts; ++post_index) {
    if (post_index != 0U) {
      const uint32_t previous_post = post_index - 1U;
      const uint32_t previous_bank = previous_post % kWqeBankCount;
      const uint32_t release_bank_to_vector =
          previous_post + kWqeBankCount < total_posts;
      PrepareDensePostMte3Stage(
          &prepared_posts[previous_bank],
          wqe_banks + previous_bank * kWqeBankBytes,
          release_bank_to_vector, &pending_posts[previous_bank]);
    }

    const uint32_t bank_id = post_index % kWqeBankCount;
    const uint32_t jetty = post_index % jettys_per_core;
    const uint32_t request_offset = post_index * kWqesPerPost;
    uint32_t wqe_count = request_count - request_offset;
    if (wqe_count > kWqesPerPost) {
      wqe_count = kWqesPerPost;
    }
    const uint32_t completion_on_last_wqe =
        post_index + jettys_per_core >= total_posts;
    __gm__ const KvafBatchGetDirectUrmaEntity *const entity =
        entities + jetty;
    __gm__ KvafBatchGetQueueState *const queue = queues + jetty;
    PrepareDensePostVectorStage(
        indices, output_indices, offsets, address_table, request_offset,
        block_bytes, entity->local_hbm_address, current_heads[jetty],
        wqe_count, completion_on_last_wqe, bank_id,
        post_index >= kWqeBankCount,
        wqe_banks + bank_id * kWqeBankBytes, entity, queue,
        &prepared_posts[bank_id]);
    current_heads[jetty] += wqe_count;

    if (post_index + 1U == total_posts) {
      const uint64_t last_pi = current_heads[jetty] - 1U;
      const uint32_t last_owner =
          1U - static_cast<uint32_t>((last_pi / entity->sq_depth) & 1U);
      *last_wqe = WqeControl(true, last_owner);
    }

    if (post_index >= kWqeBankCount) {
      const uint32_t commit_bank =
          (post_index - kWqeBankCount) % kWqeBankCount;
      CommitPostScalarStage(&pending_posts[commit_bank]);
      if (profile_enabled != 0U && *first_doorbell_cycle == 0U) {
        *first_doorbell_cycle =
            static_cast<uint64_t>(AscendC::GetSystemCycle());
      }
    }
  }

  if (total_posts != 0U) {
    const uint32_t final_post = total_posts - 1U;
    const uint32_t final_bank = final_post % kWqeBankCount;
    PrepareDensePostMte3Stage(&prepared_posts[final_bank],
                              wqe_banks + final_bank * kWqeBankBytes, 0U,
                              &pending_posts[final_bank]);
    if (total_posts > 1U) {
      const uint32_t penultimate_bank =
          (total_posts - 2U) % kWqeBankCount;
      CommitPostScalarStage(&pending_posts[penultimate_bank]);
      if (profile_enabled != 0U && *first_doorbell_cycle == 0U) {
        *first_doorbell_cycle =
            static_cast<uint64_t>(AscendC::GetSystemCycle());
      }
    }
    CommitPostScalarStage(&pending_posts[final_bank]);
    if (profile_enabled != 0U && *first_doorbell_cycle == 0U) {
      *first_doorbell_cycle =
          static_cast<uint64_t>(AscendC::GetSystemCycle());
    }
  }
}

// Dense P1 descriptors have already passed the ExactScan semantic filter, but
// they still cross a transport boundary.  Before constructing a USER_CTL WQE,
// recheck the actual registered DDR/HBM ranges.  This bounded scalar
// preflight runs over at most 256 entries; it turns a stale descriptor into a
// normal status error instead of letting an invalid DMA address surface as an
// AICore exception.
__aicore__ inline void ValidateDenseBatchGetDescriptors(
    __gm__ const uint64_t *address_table,
    __gm__ const uint8_t *valid_table,
    __gm__ const int32_t *indices, __gm__ const int32_t *offsets,
    __gm__ const int32_t *output_indices, uint32_t active_request_count,
    uint32_t table_capacity, uint32_t output_rows, uint32_t block_bytes,
    __gm__ const KvafBatchGetDirectUrmaEntity *entity,
    uint64_t *result, uint64_t *failed_request) {
  for (uint32_t request = 0U;
       request < active_request_count && *result == kSuccess; ++request) {
    const int32_t table_index = indices[request];
    const int32_t offset = offsets[request];
    const int32_t output_row = output_indices[request];
    if (table_index < 0 ||
        static_cast<uint32_t>(table_index) >= table_capacity ||
        valid_table[table_index] == 0U || offset < 0 ||
        static_cast<uint32_t>(offset) >
            kAddressTableEntryBytes - kTransferBytes) {
      *result = kInvalidLookup;
      *failed_request = request;
      continue;
    }
    if (output_row < 0 ||
        static_cast<uint32_t>(output_row) >= output_rows ||
        entity->local_hbm_size < block_bytes ||
        static_cast<uint64_t>(output_row) >
            (entity->local_hbm_size - block_bytes) / block_bytes) {
      *result = kInvalidOutput;
      *failed_request = request;
      continue;
    }

    const uint64_t table_base = address_table[table_index];
    if (entity->remote_host_ddr_size < kAddressTableEntryBytes ||
        table_base < entity->remote_host_ddr_address ||
        table_base - entity->remote_host_ddr_address >
            entity->remote_host_ddr_size - kAddressTableEntryBytes) {
      *result = kInvalidLookup;
      *failed_request = request;
      continue;
    }
    const uint64_t remote_address =
        table_base + static_cast<uint32_t>(offset);
    if (remote_address < table_base ||
        entity->remote_host_ddr_size < block_bytes ||
        remote_address < entity->remote_host_ddr_address ||
        remote_address - entity->remote_host_ddr_address >
            entity->remote_host_ddr_size - block_bytes) {
      *result = kInvalidLookup;
      *failed_request = request;
    }
  }
}

__aicore__ inline uint32_t ActiveRequestsForJetty(
    uint32_t active_request_count, uint32_t jetty,
    uint32_t jettys_per_core) {
  const uint32_t total_posts =
      (active_request_count + kWqesPerPost - 1U) / kWqesPerPost;
  uint32_t assigned = 0U;
  for (uint32_t post = jetty; post < total_posts;
       post += jettys_per_core) {
    const uint32_t active_offset = post * kWqesPerPost;
    uint32_t wqe_count = active_request_count - active_offset;
    if (wqe_count > kWqesPerPost) {
      wqe_count = kWqesPerPost;
    }
    assigned += wqe_count;
  }
  return assigned;
}

__aicore__ inline uint64_t WaitForCompletion(
    __gm__ const KvafBatchGetDirectUrmaEntity *entity,
    __gm__ KvafBatchGetQueueState *queue, uint32_t *poll_count) {
  const uint32_t slot =
      static_cast<uint32_t>(queue->cq_consumer_index % entity->cq_depth);
  __gm__ uint8_t *const cqe_address =
      reinterpret_cast<__gm__ uint8_t *>(entity->cq_va) +
      static_cast<uint64_t>(slot) * entity->cqe_size;
  for (uint32_t poll = 0U; poll < kMaxCqPolls; ++poll) {
    CleanCacheLines(cqe_address, kCqeProbeBytes);
    __asm__ __volatile__("");
    const uint32_t cqe_word =
        *reinterpret_cast<__gm__ uint32_t *>(cqe_address);
    __asm__ __volatile__("");
    const uint8_t owner = static_cast<uint8_t>((cqe_word >> 2U) & 1U);
    const uint8_t expected = static_cast<uint8_t>(
        (queue->cq_consumer_index / entity->cq_depth) & 1U);
    if ((owner ^ expected) == 0U) {
      continue;
    }
    const uint8_t sub_status =
        static_cast<uint8_t>((cqe_word >> 16U) & 0xffU);
    const uint8_t status =
        static_cast<uint8_t>((cqe_word >> 24U) & 0xffU);
    ++queue->cq_consumer_index;
    st_dev(static_cast<uint32_t>(queue->cq_consumer_index) &
               kCqConsumerMask,
           reinterpret_cast<__gm__ uint32_t *>(entity->cq_db_va), 0);
    *poll_count = poll + 1U;
    return status == 0U && sub_status == 0U ? kSuccess : kCqError;
  }
  *poll_count = kMaxCqPolls;
  return kCqTimeout;
}

}  // namespace

// This is the complete Direct-HCCP transaction for exactly one KVAF worker:
// compact the request mask, materialize WQEs, copy them to SQ, ring the
// doorbell, and retain the AIV through the matching CQ completion.  It is
// intentionally inline so a fused MIX kernel can call the same code through
// kvaf_fused_full_get_device.h rather than reimplementing the WQE/CQ ABI.
// `core` is a KVAF worker ordinal, not a MIX AIV ID.
__aicore__ inline void RunKvafFullBatchGetCore(
    const KvafExecuteBatchGetKernelArgs& args, uint32_t core) {
  const uint32_t jettys_per_core =
      args.jettys_per_core == 0U ? 1U : args.jettys_per_core;
  if (args.block_count == 0U || core >= args.block_count ||
      args.block_count > KVAF_AIV_BATCH_GET_MAX_AIV_CORES ||
      jettys_per_core > KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE ||
      args.address_table == 0U || args.valid_table == 0U ||
      args.indices == 0U || args.offsets == 0U || args.mask == 0U ||
      args.output_indices == 0U || args.output == 0U ||
      args.core_status == 0U || args.channel_entity == 0U ||
      args.queue_state == 0U || args.table_capacity == 0U ||
      args.request_capacity == 0U || args.output_rows == 0U ||
      args.block_bytes != kTransferBytes) {
    return;
  }

  __gm__ KvafBatchGetCoreStatus *const status =
      reinterpret_cast<__gm__ KvafBatchGetCoreStatus *>(args.core_status) +
      core;
  const bool profile_enabled =
      status->profile.magic == KVAF_AIV_BATCH_GET_PROFILE_MAGIC;
  const uint64_t profile_start_cycle =
      profile_enabled ? static_cast<uint64_t>(AscendC::GetSystemCycle()) : 0U;
  __gm__ KvafBatchGetQueueState *const queues =
      reinterpret_cast<__gm__ KvafBatchGetQueueState *>(args.queue_state) +
      static_cast<uint64_t>(core) * jettys_per_core;
  __gm__ const KvafBatchGetDirectUrmaEntity *const entities =
      reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity *>(
          args.channel_entity) +
      static_cast<uint64_t>(core) * jettys_per_core;

  uint64_t result = kSuccess;
  uint64_t failed_request = UINT64_MAX;
  uint64_t active_count = 0U;
  uint64_t last_wqe = 0U;
  uint64_t first_doorbell_cycle = 0U;
  uint64_t total_posts = 0U;
  uint32_t completion_polls[KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE] = {
      0U, 0U};
  uint64_t completion_wait_cycles[KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE] = {
      0U, 0U};
  const uint32_t begin = static_cast<uint32_t>(
      (static_cast<uint64_t>(args.request_capacity) * core) /
      args.block_count);
  const uint32_t end = static_cast<uint32_t>(
      (static_cast<uint64_t>(args.request_capacity) * (core + 1U)) /
      args.block_count);

  for (uint32_t jetty = 0U; jetty < jettys_per_core; ++jetty) {
    __gm__ const KvafBatchGetDirectUrmaEntity *const entity =
        entities + jetty;
    if (entity->magic != kEntityMagic ||
        entity->version != kEntityVersion ||
        entity->local_hbm_address == 0U ||
        entity->local_hbm_address != args.output ||
        entity->local_hbm_size < args.block_bytes ||
        entity->local_token_id == 0U ||
        entity->remote_host_ddr_address == 0U ||
        entity->remote_host_ddr_size < args.block_bytes ||
        entity->sq_va == 0U || entity->sq_db_va == 0U ||
        entity->sq_depth < 2U || entity->wqe_size != kWqeBytes ||
        entity->cq_va == 0U || entity->cq_db_va == 0U ||
        entity->cq_depth == 0U || entity->cqe_size < kCqeProbeBytes ||
        (jetty != 0U &&
         (entity->remote_host_ddr_address !=
              entities[0].remote_host_ddr_address ||
          entity->remote_host_ddr_size !=
              entities[0].remote_host_ddr_size ||
          entity->remote_token_id != entities[0].remote_token_id ||
          entity->remote_token_value != entities[0].remote_token_value ||
          entity->local_hbm_address != entities[0].local_hbm_address ||
          entity->local_hbm_size != entities[0].local_hbm_size ||
          entity->local_token_id != entities[0].local_token_id ||
          entity->local_token_value != entities[0].local_token_value))) {
      result = kInvalidEntity;
    }
  }
  for (uint32_t jetty = 0U;
       result == kSuccess && jetty < jettys_per_core; ++jetty) {
    __gm__ KvafBatchGetQueueState *const queue = queues + jetty;
    if (queue->initialized != 0U && queue->magic != kQueueMagic) {
      result = kInvalidQueue;
    }
    if (result == kSuccess && queue->initialized == 0U) {
      queue->magic = kQueueMagic;
      queue->initialized = 1U;
      queue->sq_producer_index = 0U;
      queue->cq_consumer_index = 0U;
      queue->completed_batch_count = 0U;
      queue->last_error = 0U;
    }
  }

  __gm__ const uint64_t *const address_table =
      reinterpret_cast<__gm__ const uint64_t *>(args.address_table);
  __gm__ const uint8_t *const valid_table =
      reinterpret_cast<__gm__ const uint8_t *>(args.valid_table);
  __gm__ const int32_t *const indices =
      reinterpret_cast<__gm__ const int32_t *>(args.indices);
  __gm__ const int32_t *const offsets =
      reinterpret_cast<__gm__ const int32_t *>(args.offsets);
  __gm__ const uint8_t *const mask =
      reinterpret_cast<__gm__ const uint8_t *>(args.mask);
  __gm__ const int32_t *const output_indices =
      reinterpret_cast<__gm__ const int32_t *>(args.output_indices);
  const uint64_t profile_setup_done_cycle =
      profile_enabled ? static_cast<uint64_t>(AscendC::GetSystemCycle()) : 0U;
  uint64_t profile_compact_done_cycle = profile_setup_done_cycle;

  // Temporarily disabled: retain RunBatchGetValidation so the device-side
  // preflight can be restored without changing its implementation.
  // if (result == kSuccess) {
  //   active_count = RunBatchGetValidation(
  //       address_table, valid_table, indices, offsets, mask, output_indices,
  //       begin, end, args.table_capacity, args.output_rows, args.block_bytes,
  //       entities[0].remote_host_ddr_address,
  //       entities[0].remote_host_ddr_size, entities[0].local_hbm_size,
  //       &result, &failed_request);
  // }

  if (result == kSuccess) {
    __ubuf__ uint32_t *active_table_indices =
        reinterpret_cast<__ubuf__ uint32_t *>(
            get_imm(kActiveTableIndicesUbOffset));
    __ubuf__ uint32_t *active_request_ids =
        reinterpret_cast<__ubuf__ uint32_t *>(
            get_imm(kActiveRequestIdsUbOffset));
    active_count = CompactBatchGetRequests(
        mask, indices, begin, end, active_table_indices,
        active_request_ids);
    total_posts =
        (active_count + kWqesPerPost - 1U) / kWqesPerPost;
    if (profile_enabled) {
      profile_compact_done_cycle =
          static_cast<uint64_t>(AscendC::GetSystemCycle());
    }
    if (active_count > kActiveRequestCapacity) {
      result = kQueueFull;
    }
    for (uint32_t jetty = 0U;
         result == kSuccess && jetty < jettys_per_core; ++jetty) {
      if (ActiveRequestsForJetty(static_cast<uint32_t>(active_count), jetty,
                                 jettys_per_core) >=
          entities[jetty].sq_depth) {
        result = kQueueFull;
      }
    }
    if (result == kSuccess) {
      ConfigureUbToGmCopy();
      PostActiveRequests(active_table_indices, active_request_ids,
                         output_indices, offsets, address_table, active_count,
                         args.block_bytes, jettys_per_core, entities, queues,
                         static_cast<uint32_t>(profile_enabled),
                         &first_doorbell_cycle, &last_wqe);
    }
  }

  // All WQEs have reached SQ memory and all doorbells have been issued;
  // Direct-HCCP completion is measured separately below.
  const uint64_t profile_post_done_cycle =
      profile_enabled ? static_cast<uint64_t>(AscendC::GetSystemCycle()) : 0U;

  if (result == kSuccess && active_count != 0U) {
    const uint32_t used_jettys =
        total_posts < jettys_per_core
            ? static_cast<uint32_t>(total_posts)
            : jettys_per_core;
    for (uint32_t jetty = 0U; jetty < used_jettys; ++jetty) {
      const uint64_t wait_start_cycle =
          profile_enabled
              ? static_cast<uint64_t>(AscendC::GetSystemCycle())
              : 0U;
      const uint64_t completion_result =
          WaitForCompletion(entities + jetty, queues + jetty,
                            completion_polls + jetty);
      if (profile_enabled) {
        completion_wait_cycles[jetty] =
            static_cast<uint64_t>(AscendC::GetSystemCycle()) -
            wait_start_cycle;
      }
      if (result == kSuccess && completion_result != kSuccess) {
        result = completion_result;
      }
    }
    if (result == kSuccess) {
      for (uint32_t jetty = 0U; jetty < used_jettys; ++jetty) {
        ++queues[jetty].completed_batch_count;
      }
    }
  }
  const uint64_t profile_completion_done_cycle =
      profile_enabled ? static_cast<uint64_t>(AscendC::GetSystemCycle()) : 0U;
  for (uint32_t jetty = 0U; jetty < jettys_per_core; ++jetty) {
    queues[jetty].last_error = result;
  }
  WriteStatus(status, result, active_count, queues[0].completed_batch_count,
              queues[0].sq_producer_index, queues[0].cq_consumer_index,
              failed_request, last_wqe);
  if (profile_enabled) {
    const uint64_t profile_finish_cycle =
        static_cast<uint64_t>(AscendC::GetSystemCycle());
    WriteProfile(status, profile_start_cycle, profile_setup_done_cycle,
                 profile_compact_done_cycle, first_doorbell_cycle,
                 profile_post_done_cycle, profile_completion_done_cycle,
                 profile_finish_cycle, active_count, total_posts,
                 completion_wait_cycles, completion_polls);
  }
}

// Dense fused Direct-HCCP state machine.
//
// It has deliberately one transaction per already-bound KVAF queue.  A
// transaction is not a new queue ABI and must live in the caller's AIV-local
// state: after PostOnly returns, the WQEs already reside in SQ memory, while
// the caller can perform unrelated ExactScan work until it probes/retires the
// one CQE for this wave.  It may not post another wave on this queue until
// this one is retired, because the existing queue state has no multi-flight
// CQ ledger.
enum DenseBatchGetTransactionState : uint32_t {
  kDenseBatchGetIdle = 0U,
  kDenseBatchGetInFlight = 1U,
  kDenseBatchGetRetired = 2U,
  kDenseBatchGetFailed = 3U,
};

struct KvafDenseBatchGetTransaction {
  uint64_t active_count;
  uint64_t total_posts;
  uint64_t failed_request;
  uint64_t last_wqe;
  uint64_t first_doorbell_cycle;
  uint64_t profile_start_cycle;
  uint64_t profile_setup_done_cycle;
  uint64_t profile_compact_done_cycle;
  uint64_t profile_post_done_cycle;
  uint64_t profile_completion_done_cycle;
  uint64_t result;
  uint32_t completion_polls;
  uint32_t state;
  uint32_t profile_enabled;
  uint32_t finalized;
};

__aicore__ inline void ResetDenseBatchGetTransaction(
    KvafDenseBatchGetTransaction *transaction) {
  transaction->active_count = 0U;
  transaction->total_posts = 0U;
  transaction->failed_request = UINT64_MAX;
  transaction->last_wqe = 0U;
  transaction->first_doorbell_cycle = 0U;
  transaction->profile_start_cycle = 0U;
  transaction->profile_setup_done_cycle = 0U;
  transaction->profile_compact_done_cycle = 0U;
  transaction->profile_post_done_cycle = 0U;
  transaction->profile_completion_done_cycle = 0U;
  transaction->result = kSuccess;
  transaction->completion_polls = 0U;
  transaction->state = kDenseBatchGetIdle;
  transaction->profile_enabled = 0U;
  transaction->finalized = 0U;
}

// Begin performs the exact pre-P1-commit transaction up to and including the
// existing SQ doorbell.  It intentionally does not read CQ.  The caller owns
// this queue exclusively until TryRetire/Finish reports a terminal state.
__aicore__ inline void BeginKvafDenseBatchGetPostOnly(
    const KvafExecuteBatchGetKernelArgs& args,
    uint32_t active_request_count, uint32_t core,
    KvafDenseBatchGetTransaction *transaction) {
  if (transaction == nullptr) {
    return;
  }
  ResetDenseBatchGetTransaction(transaction);
  const uint32_t jettys_per_core =
      args.jettys_per_core == 0U ? 1U : args.jettys_per_core;
  __gm__ KvafBatchGetCoreStatus *const invalid_status =
      args.core_status == 0U
          ? nullptr
          : reinterpret_cast<__gm__ KvafBatchGetCoreStatus *>(
                args.core_status);
  if (args.block_count != 1U || core != 0U ||
      jettys_per_core != 1U || args.address_table == 0U ||
      args.valid_table == 0U || args.indices == 0U || args.offsets == 0U ||
      args.output_indices == 0U || args.output == 0U ||
      args.core_status == 0U || args.channel_entity == 0U ||
      args.queue_state == 0U || args.table_capacity == 0U ||
      args.request_capacity == 0U ||
      args.request_capacity > kDenseRequestCapacity ||
      active_request_count == 0U ||
      active_request_count > args.request_capacity ||
      args.output_rows == 0U || args.block_bytes != kTransferBytes) {
    transaction->result = kInvalidArgs;
    transaction->state = kDenseBatchGetFailed;
    transaction->finalized = 1U;
    if (invalid_status != nullptr) {
      WriteStatus(invalid_status, kInvalidArgs, 0U, 0U, 0U, 0U,
                  UINT64_MAX, 0U);
    }
    return;
  }

  __gm__ KvafBatchGetCoreStatus *const status =
      reinterpret_cast<__gm__ KvafBatchGetCoreStatus *>(args.core_status);
  transaction->profile_enabled =
      status->profile.magic == KVAF_AIV_BATCH_GET_PROFILE_MAGIC ? 1U : 0U;
  transaction->profile_start_cycle =
      transaction->profile_enabled != 0U
          ? static_cast<uint64_t>(AscendC::GetSystemCycle())
          : 0U;
  transaction->active_count = active_request_count;
  transaction->total_posts =
      (transaction->active_count + kWqesPerPost - 1U) / kWqesPerPost;

  __gm__ KvafBatchGetQueueState *const queues =
      reinterpret_cast<__gm__ KvafBatchGetQueueState *>(args.queue_state);
  __gm__ const KvafBatchGetDirectUrmaEntity *const entities =
      reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity *>(
          args.channel_entity);
  __gm__ const KvafBatchGetDirectUrmaEntity *const entity = entities;

  if (entity->magic != kEntityMagic || entity->version != kEntityVersion ||
      entity->local_hbm_address == 0U ||
      entity->local_hbm_address != args.output ||
      entity->local_hbm_size < args.block_bytes ||
      entity->local_token_id == 0U ||
      entity->remote_host_ddr_address == 0U ||
      entity->remote_host_ddr_size < args.block_bytes ||
      entity->sq_va == 0U || entity->sq_db_va == 0U ||
      entity->sq_depth < 2U || entity->wqe_size != kWqeBytes ||
      entity->cq_va == 0U || entity->cq_db_va == 0U ||
      entity->cq_depth == 0U || entity->cqe_size < kCqeProbeBytes) {
    transaction->result = kInvalidEntity;
  }
  if (transaction->result == kSuccess && queues->initialized != 0U &&
      queues->magic != kQueueMagic) {
    transaction->result = kInvalidQueue;
  }
  if (transaction->result == kSuccess && queues->initialized == 0U) {
    queues->magic = kQueueMagic;
    queues->initialized = 1U;
    queues->sq_producer_index = 0U;
    queues->cq_consumer_index = 0U;
    queues->completed_batch_count = 0U;
    queues->last_error = 0U;
  }

  __gm__ const uint64_t *const address_table =
      reinterpret_cast<__gm__ const uint64_t *>(args.address_table);
  __gm__ const uint8_t *const valid_table =
      reinterpret_cast<__gm__ const uint8_t *>(args.valid_table);
  __gm__ const int32_t *const indices =
      reinterpret_cast<__gm__ const int32_t *>(args.indices);
  __gm__ const int32_t *const offsets =
      reinterpret_cast<__gm__ const int32_t *>(args.offsets);
  __gm__ const int32_t *const output_indices =
      reinterpret_cast<__gm__ const int32_t *>(args.output_indices);
  transaction->profile_setup_done_cycle =
      transaction->profile_enabled != 0U
          ? static_cast<uint64_t>(AscendC::GetSystemCycle())
          : 0U;
  transaction->profile_compact_done_cycle =
      transaction->profile_setup_done_cycle;

  if (transaction->result == kSuccess) {
    ValidateDenseBatchGetDescriptors(
        address_table, valid_table, indices, offsets, output_indices,
        static_cast<uint32_t>(transaction->active_count), args.table_capacity,
        args.output_rows, args.block_bytes, entity, &transaction->result,
        &transaction->failed_request);
  }
  if (transaction->result == kSuccess &&
      ActiveRequestsForJetty(static_cast<uint32_t>(transaction->active_count),
                             0U, jettys_per_core) >= entity->sq_depth) {
    transaction->result = kQueueFull;
  }
  if (transaction->result == kSuccess) {
    // The WQEs live in this function's aligned UB scratch only until the MTE3
    // copies below complete.  After PostDenseBatchGetRequests returns, SQ
    // owns the wave and the caller may scan while the direct HCCP read runs.
    alignas(kWqeBytes) __ubuf__ uint32_t dense_wqe_words[
        kDenseWqeScratchBytes / sizeof(uint32_t)];
    __ubuf__ uint8_t *const dense_wqe_banks =
        reinterpret_cast<__ubuf__ uint8_t *>(dense_wqe_words);
    ConfigureUbToGmCopy();
    PostDenseBatchGetRequests(
        indices, output_indices, offsets, address_table,
        static_cast<uint32_t>(transaction->active_count), args.block_bytes,
        jettys_per_core, entities, queues, dense_wqe_banks,
        transaction->profile_enabled, &transaction->first_doorbell_cycle,
        &transaction->last_wqe);
  }

  transaction->profile_post_done_cycle =
      transaction->profile_enabled != 0U
          ? static_cast<uint64_t>(AscendC::GetSystemCycle())
          : 0U;
  transaction->state = transaction->result == kSuccess
                           ? kDenseBatchGetInFlight
                           : kDenseBatchGetFailed;
}

// Probe the one CQE belonging to a PostOnly transaction exactly once.  A
// not-ready CQ intentionally has no side effect; this makes it safe for the
// owner to interleave this call between small ExactScan tiles.
__aicore__ inline void TryRetireKvafDenseBatchGet(
    const KvafExecuteBatchGetKernelArgs& args,
    KvafDenseBatchGetTransaction *transaction) {
  if (transaction == nullptr ||
      transaction->state != kDenseBatchGetInFlight) {
    return;
  }
  __gm__ KvafBatchGetQueueState *const queue =
      reinterpret_cast<__gm__ KvafBatchGetQueueState *>(args.queue_state);
  __gm__ const KvafBatchGetDirectUrmaEntity *const entity =
      reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity *>(
          args.channel_entity);
  const uint32_t slot =
      static_cast<uint32_t>(queue->cq_consumer_index % entity->cq_depth);
  __gm__ uint8_t *const cqe_address =
      reinterpret_cast<__gm__ uint8_t *>(entity->cq_va) +
      static_cast<uint64_t>(slot) * entity->cqe_size;
  CleanCacheLines(cqe_address, kCqeProbeBytes);
  __asm__ __volatile__("");
  const uint32_t cqe_word =
      *reinterpret_cast<__gm__ uint32_t *>(cqe_address);
  __asm__ __volatile__("");
  ++transaction->completion_polls;
  const uint8_t owner = static_cast<uint8_t>((cqe_word >> 2U) & 1U);
  const uint8_t expected = static_cast<uint8_t>(
      (queue->cq_consumer_index / entity->cq_depth) & 1U);
  if ((owner ^ expected) == 0U) {
    if (transaction->completion_polls >= kMaxCqPolls) {
      transaction->result = kCqTimeout;
      transaction->state = kDenseBatchGetFailed;
      transaction->profile_completion_done_cycle =
          transaction->profile_enabled != 0U
              ? static_cast<uint64_t>(AscendC::GetSystemCycle())
              : 0U;
    }
    return;
  }

  const uint8_t sub_status =
      static_cast<uint8_t>((cqe_word >> 16U) & 0xffU);
  const uint8_t status =
      static_cast<uint8_t>((cqe_word >> 24U) & 0xffU);
  ++queue->cq_consumer_index;
  st_dev(static_cast<uint32_t>(queue->cq_consumer_index) & kCqConsumerMask,
         reinterpret_cast<__gm__ uint32_t *>(entity->cq_db_va), 0);
  transaction->result =
      status == 0U && sub_status == 0U ? kSuccess : kCqError;
  if (transaction->result == kSuccess) {
    ++queue->completed_batch_count;
    transaction->state = kDenseBatchGetRetired;
  } else {
    transaction->state = kDenseBatchGetFailed;
  }
  transaction->profile_completion_done_cycle =
      transaction->profile_enabled != 0U
          ? static_cast<uint64_t>(AscendC::GetSystemCycle())
          : 0U;
}

// Terminal drain/final publication.  This is the only routine that may spin
// for the remaining CQ budget; callers should use TryRetire while they still
// have ExactScan work.  The resulting status/profile ABI remains identical to
// the old blocking helper for a transaction that is drained immediately.
__aicore__ inline void FinishKvafDenseBatchGet(
    const KvafExecuteBatchGetKernelArgs& args,
    KvafDenseBatchGetTransaction *transaction) {
  if (transaction == nullptr || transaction->finalized != 0U) {
    return;
  }
  while (transaction->state == kDenseBatchGetInFlight) {
    TryRetireKvafDenseBatchGet(args, transaction);
  }
  __gm__ KvafBatchGetCoreStatus *const status =
      reinterpret_cast<__gm__ KvafBatchGetCoreStatus *>(args.core_status);
  __gm__ KvafBatchGetQueueState *const queue =
      reinterpret_cast<__gm__ KvafBatchGetQueueState *>(args.queue_state);
  queue->last_error = transaction->result;
  WriteStatus(status, transaction->result, transaction->active_count,
              queue->completed_batch_count, queue->sq_producer_index,
              queue->cq_consumer_index, transaction->failed_request,
              transaction->last_wqe);
  if (transaction->profile_enabled != 0U) {
    const uint64_t profile_finish_cycle =
        static_cast<uint64_t>(AscendC::GetSystemCycle());
    const uint64_t completion_done_cycle =
        transaction->profile_completion_done_cycle != 0U
            ? transaction->profile_completion_done_cycle
            : profile_finish_cycle;
    const uint64_t completion_wait_cycles =
        completion_done_cycle >= transaction->profile_post_done_cycle
            ? completion_done_cycle - transaction->profile_post_done_cycle
            : 0U;
    const uint64_t wait_cycles[KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE] = {
        completion_wait_cycles, 0U};
    const uint32_t polls[KVAF_AIV_BATCH_GET_MAX_JETTYS_PER_CORE] = {
        transaction->completion_polls, 0U};
    WriteProfile(status, transaction->profile_start_cycle,
                 transaction->profile_setup_done_cycle,
                 transaction->profile_compact_done_cycle,
                 transaction->first_doorbell_cycle,
                 transaction->profile_post_done_cycle, completion_done_cycle,
                 profile_finish_cycle, transaction->active_count,
                 transaction->total_posts, wait_cycles, polls);
  }
  transaction->finalized = 1U;
}

// Compatibility wrapper retained for the standalone BatchGet and P1 tests.
// It follows the new state machine but drains immediately, so its WQE/CQ
// ordering and status contract are mathematically identical to the historical
// full blocking implementation.
__aicore__ inline void RunKvafDenseBatchGetCore256(
    const KvafExecuteBatchGetKernelArgs& args,
    uint32_t active_request_count, uint32_t core) {
  KvafDenseBatchGetTransaction transaction;
  BeginKvafDenseBatchGetPostOnly(args, active_request_count, core,
                                 &transaction);
  FinishKvafDenseBatchGet(args, &transaction);
}
}  // namespace kvaf_fused_get

#if !defined(KVAF_FUSED_FULL_GET_DEVICE_EMBEDDED)
extern "C" __global__ __aicore__ void KvafExecuteBatchGetAivKernel(
    KvafExecuteBatchGetKernelArgs args) {
  kvaf_fused_get::RunKvafFullBatchGetCore(args, GetBlockIdx());
}

static const struct FunLevelKType
    KvafExecuteBatchGetAivKernel_kernel_type_section __attribute__(
        (used, section(".ascend.meta.KvafExecuteBatchGetAivKernel"))) =
        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
#endif  // KVAF_FUSED_FULL_GET_DEVICE_EMBEDDED
