#include "gather_batch_get_abi.h"
#include "batch_get_kernel_common.h"

namespace kvaf_gather {
using namespace AscendC;
using namespace kvaf_aiv;
constexpr uint64_t kGatherMagic = 0x4b56414647445232ULL;
constexpr uint64_t kErrorBit = 1ULL << 63;
constexpr uint64_t kCqPending = 1ULL << 62;
constexpr uint32_t kRead = 6, kWrite = 3;
constexpr uint32_t kMaxWqebbsPerWqe = (48 + KVAF_SEQ_MAX_SGES * 16 + 63) / 64;
// The USER_CTL transport provisions four 64-byte WQEBBs per logical WR.
static_assert(kMaxWqebbsPerWqe <= 4);
struct Timeline {
  // Keep only the explicit GM pointer in local state. The device trace showed
  // caller mask 0x41 and missing early stamps after mutating a local aggregate
  // through Gather/Queue references. Each stage now updates its own core's
  // record directly; no mutable local profile crosses a function boundary.
  __gm__ volatile KvafGatherBatchGetCoreProfile* record;
  __aicore__ inline bool Enabled() const { return record != nullptr; }
  __aicore__ inline void Initialize(uint64_t sequence) {
    if (!Enabled()) return;
    // This HBM record can have been written by a different physical AIV core.
    Flush(reinterpret_cast<uint64_t>(record), sizeof(*record));
    record->magic = 0;
    record->sequence = sequence;
    record->result = KVAF_SEQ_INVALID;
    record->valid_mask = 0;
    record->kernel_start_cycle = 0;
    record->input_done_cycle = 0;
    record->descriptor_done_cycle = 0;
    record->notify_done_cycle = 0;
    record->ack_done_cycle = 0;
    record->read_done_cycle = 0;
    record->kernel_finish_cycle = 0;
    record->requests = 0;
    record->data_wrs = 0;
    record->ack_queries = 0;
    record->data_wqebbs = 0;
    record->data_doorbells = 0;
    record->data_cq_wait_cycles = 0;
    record->read_build_cycles = 0;
    record->first_ready_cycle = 0;
    record->first_read_submit_cycle = 0;
    record->first_read_ready_bytes = 0;
    record->ready_queries = 0;
    record->ready_wait_cycles = 0;
    record->pipeline_chunk_bytes = 0;
  }
  __aicore__ inline void Stamp(uint32_t event) const {
    if (!Enabled()) return;
    const auto cycle = static_cast<uint64_t>(GetSystemCycle());
    switch (event) {
      case 0: record->kernel_start_cycle = cycle; break;
      case 1: record->input_done_cycle = cycle; break;
      case 2: record->descriptor_done_cycle = cycle; break;
      case 3: record->notify_done_cycle = cycle; break;
      case 4: record->ack_done_cycle = cycle; break;
      case 5: record->read_done_cycle = cycle; break;
      default: record->kernel_finish_cycle = cycle; break;
    }
    record->valid_mask = record->valid_mask | (uint64_t(1) << event);
  }
  __aicore__ inline void Empty() const {
    if (!Enabled()) return;
    const auto cycle = record->input_done_cycle;
    record->descriptor_done_cycle = cycle;
    record->notify_done_cycle = cycle;
    record->ack_done_cycle = cycle;
    record->read_done_cycle = cycle;
    record->valid_mask = record->valid_mask | 0x3c;
  }
  __aicore__ inline void Finish(uint64_t result) const {
    if (!Enabled()) return;
    Stamp(6);
    record->result = result;
    // Mark and export the same record the inner stages updated. Host reads it
    // only after stream completion; keep the full event-mask validation.
    record->magic = KVAF_GATHER_PROFILE_MAGIC;
    Flush(reinterpret_cast<uint64_t>(record), sizeof(*record));
  }
};
// One queue owns a physically bounded wave. Data posts can publish several
// doorbells before its ordered tail completion; there is no software window.
struct Queue {
  __gm__ const KvafBatchGetDirectUrmaEntity* entity;
  __gm__ KvafBatchGetQueueState* state;
  uint64_t wave_begin, last_header;
  uint32_t wrs, max_polls;
  __gm__ volatile KvafGatherBatchGetCoreProfile* profile{};

  __aicore__ uint64_t Init() {
    Flush(reinterpret_cast<uint64_t>(entity), sizeof(*entity));
    Flush(reinterpret_cast<uint64_t>(state), sizeof(*state));
    const auto& e = *entity;
    if (e.magic != 0x4b564155U || e.version != 1 || !e.sq_va || !e.sq_db_va ||
        !e.cq_va || !e.cq_db_va || e.sq_depth < 4 || e.sq_depth % 4 ||
        !e.cq_depth || e.cqe_size < 32 || e.wqe_size != 64 || !e.local_token_id)
      return KVAF_SEQ_QUEUE_ERROR;
    if (state->initialized && (state->magic != 0x4b564151U || state->poisoned))
      return KVAF_SEQ_QUEUE_ERROR;
    if (!state->initialized) {
      state->magic = 0x4b564151U;
      state->initialized = 1;
      state->sq_producer_index = state->cq_consumer_index = 0;
      state->poisoned = state->last_error = 0;
    }
    wave_begin = state->sq_producer_index;
    wrs = 0;
    return KVAF_SEQ_OK;
  }
  __aicore__ void Publish() {
    st_dev(static_cast<uint32_t>(state->sq_producer_index),
           reinterpret_cast<__gm__ uint32_t*>(entity->sq_db_va), 0);
    if (profile) ++profile->data_doorbells;
  }
  __aicore__ uint64_t Poison(uint64_t result) {
    state->last_error = result;
    state->poisoned = 1;
    return result;
  }
  __aicore__ uint64_t Wait() {
    if (!wrs) return KVAF_SEQ_OK;
    const auto wait_begin = profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    // Keep the blocking poll's address/owner invariants outside the hot loop.
    const auto ci = state->cq_consumer_index;
    const auto cqe = entity->cq_va + (ci % entity->cq_depth) * entity->cqe_size;
    uint64_t result = KVAF_SEQ_TIMEOUT;
    for (uint32_t poll = 0; poll < max_polls; ++poll) {
      Flush(cqe, 32);
      const auto word = *reinterpret_cast<__gm__ volatile uint32_t*>(cqe);
      if (((word >> 2) & 1) == ((ci / entity->cq_depth) & 1)) continue;
      result = ConsumeCompletion(ci, word);
      break;
    }
    if (profile)
      profile->data_cq_wait_cycles += static_cast<uint64_t>(GetSystemCycle()) - wait_begin;
    if (result) {
      state->last_error = result;
      state->poisoned = 1;
    }
    return result;
  }
  __aicore__ uint64_t PollOnce() {
    if (!wrs) return KVAF_SEQ_OK;
    const auto ci = state->cq_consumer_index;
    const auto cqe = entity->cq_va + (ci % entity->cq_depth) * entity->cqe_size;
    Flush(cqe, 32);
    const auto word = *reinterpret_cast<__gm__ volatile uint32_t*>(cqe);
    if (((word >> 2) & 1) == ((ci / entity->cq_depth) & 1)) return kCqPending;
    return ConsumeCompletion(ci, word);
  }
  __aicore__ uint64_t ConsumeCompletion(uint64_t ci, uint32_t word) {
    state->cq_consumer_index = ci + 1;
    st_dev(static_cast<uint32_t>(state->cq_consumer_index) & 0x003fffffU,
           reinterpret_cast<__gm__ uint32_t*>(entity->cq_db_va), 0);
    if (word & 0xffff0000U) return Poison(KVAF_SEQ_CQ_ERROR);
    wave_begin = state->sq_producer_index;
    wrs = 0;
    return KVAF_SEQ_OK;
  }
  __aicore__ uint64_t Drain() {
    if (!wrs) return KVAF_SEQ_OK;
    // Scalar control/fallback WQEs have not been published yet. The pipelined
    // path instead encodes the completion bit before VF/MTE3 publication.
    auto* tail = reinterpret_cast<__gm__ uint32_t*>(last_header);
    *tail = (*tail & ~(3U << 16)) | (2U << 16) | (1U << 21);
    Flush(last_header, 64);
    Publish();
    return Wait();
  }
  __aicore__ uint64_t Append(uint32_t opcode, uint64_t remote,
                            const uint64_t* local, const uint32_t* lengths,
                            uint32_t count, bool completion = false) {
    // 48-byte common header followed by count 16-byte local SGEs.
    // The SQ producer/owner operate in 64-byte WQEBBs, not logical WRs.
    const uint32_t blocks = (48 + count * 16 + 63) / 64;
    const auto& e = *entity;
    if (!count || count > KVAF_SEQ_MAX_SGES || blocks > e.sq_depth)
      return KVAF_SEQ_QUEUE_ERROR;
    if (state->sq_producer_index - wave_begin + blocks > e.sq_depth ||
        wrs == e.sq_depth / 4) {
      const auto result = Drain();
      if (result) return result;
    }
    // Capacity drains above are excluded from WQE construction time.
    const auto build_begin = profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    const auto pi = state->sq_producer_index;
    uint32_t words[kMaxWqebbsPerWqe * 16] = {};
    const uint32_t owner = 1U - static_cast<uint32_t>((pi / e.sq_depth) & 1);
    words[0] = ((completion ? 2U : 1U) << 16) | (1U << 18) | (1U << 20) |
               (uint32_t(completion) << 21) |
               (1U << 28) | (1U << 29) | (owner << 31);
    words[1] = opcode << 8;
    words[2] = (e.tp_id & 0xffffffU) | (count << 24);
    words[3] = e.remote_token_id & 0xfffffU;
    const auto* eid = reinterpret_cast<__gm__ const uint32_t*>(e.remote_eid);
    for (uint32_t i = 0; i < 4; ++i) words[4 + i] = eid[i];
    words[8] = e.remote_token_value;
    words[10] = static_cast<uint32_t>(remote);
    words[11] = static_cast<uint32_t>(remote >> 32);
    for (uint32_t i = 0; i < count; ++i) {
      words[12 + i * 4] = lengths[i];
      words[13 + i * 4] = e.local_token_id;
      words[14 + i * 4] = static_cast<uint32_t>(local[i]);
      words[15 + i * 4] = static_cast<uint32_t>(local[i] >> 32);
    }
    for (uint32_t b = 0; b < blocks; ++b) {
      const auto dst = e.sq_va + ((pi + b) % e.sq_depth) * 64;
      auto* out = reinterpret_cast<__gm__ uint32_t*>(dst);
      for (uint32_t i = 0; i < 16; ++i) out[i] = words[b * 16 + i];
      Flush(dst, 64);
    }
    last_header = e.sq_va + (pi % e.sq_depth) * 64;
    state->sq_producer_index += blocks;
    ++wrs;
    if (profile) {
      profile->data_wqebbs += blocks;
      profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - build_begin;
    }
    return KVAF_SEQ_OK;
  }
  __aicore__ uint64_t AppendTransfer(uint32_t opcode, uint64_t remote,
                                    uint64_t local, uint64_t bytes) {
    while (bytes) {
      const uint32_t n = bytes > 65536 ? 65536 : static_cast<uint32_t>(bytes);
      const auto result = Append(opcode, remote, &local, &n, 1);
      if (result) return result;
      remote += n; local += n; bytes -= n;
    }
    return KVAF_SEQ_OK;
  }
  __aicore__ uint64_t Transfer(uint32_t opcode, uint64_t remote,
                              uint64_t local, uint64_t bytes) {
    if (opcode == kRead && bytes && bytes <= 65536) {
      const auto result = StartRead(remote, local, static_cast<uint32_t>(bytes));
      return result ? result : Wait();
    }
    const auto result = AppendTransfer(opcode, remote, local, bytes);
    return result ? result : Drain();
  }
  __aicore__ uint64_t StartRead(uint64_t remote, uint64_t local, uint32_t bytes) {
    if (wrs || !bytes || bytes > 65536) return KVAF_SEQ_QUEUE_ERROR;
    // The sole WR is a known tail: encode ordering/completion before its one
    // SQ write, avoiding Drain's subsequent header patch and second Flush.
    const auto result = Append(kRead, remote, &local, &bytes, 1, true);
    if (!result) Publish();
    return result;
  }
};

constexpr uint32_t kReadWrsPerPost = KVAF_GATHER_WRS_PER_POST;
constexpr uint32_t kReadBankBytes = kReadWrsPerPost * kMaxWqebbsPerWqe * 64;
static_assert(2 * kReadBankBytes <= KVAF_AIV_BATCH_GET_LOCAL_MEMORY_BYTES);

// Descriptor construction finishes before READ construction starts, so both
// stages can reuse raw UB storage and event IDs. Keep descriptor chunk size
// independent of the READ SGL limit so descriptor timing remains comparable.
constexpr uint32_t kDescriptorThreads = 128;
constexpr uint32_t kDescriptorBankBytes = 24 * 1024;
constexpr uint32_t kDescriptorHeaderBytes = sizeof(KvafSequentialGatherHeader);
constexpr uint32_t kDescriptorSpanBytes = sizeof(KvafSequentialGatherSpan);
static_assert(kDescriptorBankBytes % 64 == 0 && kDescriptorHeaderBytes == 48 &&
              kDescriptorSpanBytes == 16);

__simt_vf__ __aicore__ LAUNCH_BOUND(128)
inline void FillGatherDescriptor(
    __ubuf__ uint32_t* bank, __gm__ const uint64_t* addresses,
    __gm__ const int32_t* indices, __gm__ const int32_t* offsets,
    uint32_t first, uint32_t spans, uint32_t token_bytes,
    uint32_t header, uint32_t total_spans, uint64_t sequence, uint64_t staging,
    uint32_t copy_bytes, uint32_t chunk_bytes, uint32_t shards, uint32_t sgl) {
  const uint32_t thread = threadIdx.x;
  if (header && !thread) {
    const uint64_t magic = shards ? kvaf::kGatherShardMagic : kGatherMagic;
    bank[0] = static_cast<uint32_t>(magic);
    bank[1] = static_cast<uint32_t>(magic >> 32);
    bank[2] = static_cast<uint32_t>(sequence);
    bank[3] = static_cast<uint32_t>(sequence >> 32);
    bank[4] = static_cast<uint32_t>(staging);
    bank[5] = static_cast<uint32_t>(staging >> 32);
    bank[6] = total_spans;
    bank[7] = total_spans * token_bytes;
    bank[8] = chunk_bytes;
    bank[9] = token_bytes;
    bank[10] = shards ? sgl : 0;  // GDR3: immutable READ group size.
    bank[11] = 0;
  }
  const uint32_t header_words = header ? kDescriptorHeaderBytes / 4 : 0;
  for (uint32_t span = thread; span < spans; span += kDescriptorThreads) {
    const uint32_t request = first + span;
    const uint64_t address = addresses[indices[request]] + offsets[request];
    auto* out = bank + header_words + span * 4;
    out[0] = static_cast<uint32_t>(address);
    out[1] = static_cast<uint32_t>(address >> 32);
    out[2] = token_bytes;
    out[3] = 0;
  }
  // MTE3 writes complete cache lines. Only the final line needs padding; it
  // stays within this lane's aligned allocation and is not sent to the CPU.
  const uint32_t used_words = header_words + spans * 4;
  for (uint32_t word = used_words + thread; word < copy_bytes / 4;
       word += kDescriptorThreads)
    bank[word] = 0;
}

__aicore__ inline void CopyDescriptorBankToGm(uint64_t descriptor,
                                            uint32_t bytes, uint32_t bank) {
  const uint64_t config = (1ULL << 4) | (uint64_t(bytes) << 25);
  copy_ubuf_to_gm_align_v2(reinterpret_cast<__gm__ float*>(descriptor),
      reinterpret_cast<__ubuf__ float*>(get_imm(bank * kDescriptorBankBytes)), config, 0);
}

__simt_vf__ __aicore__ LAUNCH_BOUND(128)
inline void ClearGatherProgress(__ubuf__ uint32_t* bank) {
  bank[threadIdx.x] = 0;
}

__aicore__ inline void BuildGatherDescriptor(
    const KvafGatherBatchGetArgs& a, uint32_t first, uint32_t last,
    uint64_t descriptor, uint64_t staging) {
  const auto& r = a.request;
  const uint32_t bytes = kDescriptorHeaderBytes + (last - first) * kDescriptorSpanBytes;
  const uint32_t padded_bytes = (bytes + 63U) & ~63U;
  const uint32_t posts = (padded_bytes + kDescriptorBankBytes - 1) / kDescriptorBankBytes;
  set_loop_size_ubtoout(1ULL | (1ULL << 21));
  set_loop1_stride_ubtoout(0);
  set_loop2_stride_ubtoout(0);
  set_atomic_none();
  for (uint32_t post = 0; post < posts; ++post) {
    const uint32_t previous_bank = (post + 1) % 2;
    if (post) {
      wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(previous_bank));
      CopyDescriptorBankToGm(descriptor + uint64_t(post - 1) * kDescriptorBankBytes,
                             kDescriptorBankBytes, previous_bank);
      set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(previous_bank));
      if (post + 1 < posts)
        set_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(previous_bank));
    }
    const uint32_t bank = post % 2;
    if (post >= 2) wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank));
    const uint32_t offset = post * kDescriptorBankBytes;
    const uint32_t header = post == 0;
    const uint32_t span_offset = post ? (offset - kDescriptorHeaderBytes) / kDescriptorSpanBytes : 0;
    const uint32_t spans = Min(last - first - span_offset,
        (kDescriptorBankBytes - (header ? kDescriptorHeaderBytes : 0)) / kDescriptorSpanBytes);
    const uint32_t copy_bytes = Min(padded_bytes - offset, kDescriptorBankBytes);
    AscendC::Simt::VF_CALL<FillGatherDescriptor>(
        AscendC::Simt::Dim3{kDescriptorThreads, 1U, 1U},
        reinterpret_cast<__ubuf__ uint32_t*>(get_imm(bank * kDescriptorBankBytes)),
        reinterpret_cast<__gm__ const uint64_t*>(r.address_table),
        reinterpret_cast<__gm__ const int32_t*>(r.indices),
        reinterpret_cast<__gm__ const int32_t*>(r.offsets), first + span_offset,
        spans, r.token_bytes, header, last - first, a.sequence, staging, copy_bytes,
        a.pipeline_chunk_bytes, a.pipeline_shards, a.sgl_size);
    set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
    if (post) wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(previous_bank));
  }
  const uint32_t bank = (posts - 1) % 2;
  const uint32_t offset = (posts - 1) * kDescriptorBankBytes;
  wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
  CopyDescriptorBankToGm(descriptor + offset, padded_bytes - offset, bank);
  set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
  wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
  if (a.pipeline_shards) {
    AscendC::Simt::VF_CALL<ClearGatherProgress>(AscendC::Simt::Dim3{128U, 1U, 1U},
        reinterpret_cast<__ubuf__ uint32_t*>(get_imm(0)));
    set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
    wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
    CopyDescriptorBankToGm(descriptor + kvaf::GatherProgressOffset(last - first),
                           kvaf::kGatherProgressBytes, 0);
    set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(0));
    wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(0));
  }
  // All descriptor bytes were written by MTE3, never through Scalar's data
  // cache. Waiting for MTE3 completion replaces the old per-line Flush before
  // the control WRITE reads this HBM allocation. No UB bank/event stays live.
}

// One SIMT thread materializes one variable-length, multi-SGE READ. Every WR
// except the final request tail has the same WQEBB stride. The final WR is
// packed at its actual size; SQ ownership always uses its starting WQEBB PI.
__simt_vf__ __aicore__ LAUNCH_BOUND(128)
inline void FillGatherReadWqes(
    __ubuf__ uint32_t* bank, __gm__ const int32_t* rows,
    uint32_t request_begin, uint32_t request_end,
    uint32_t token_bytes, uint32_t sgl_size, uint32_t coalesce,
    uint64_t output, uint64_t staging,
    uint32_t wr_offset, uint32_t wr_count, uint32_t ring_head, uint32_t head_owner,
    uint32_t sq_depth,
    uint32_t full_blocks, uint32_t completion_on_last,
    uint32_t tp_id, uint32_t remote_token_id, uint32_t remote_token_value,
    uint32_t local_token_id, uint64_t eid_low, uint64_t eid_high) {
  const uint32_t slot = threadIdx.x;
  if (slot >= wr_count) return;
  const uint32_t request_offset = (wr_offset + slot) * sgl_size;
  const uint32_t request = request_begin + request_offset;
  const uint32_t remaining = request_end - request;
  const uint32_t tokens = remaining < sgl_size ? remaining : sgl_size;
  // Keep the token grouping/remote range; only the local SGE encoding changes.
  const uint32_t sges = coalesce ? 1 : tokens;
  const uint32_t blocks = (48 + sges * 16 + 63) / 64;
  // A post fits within one physical wave, so it crosses the SQ end at most
  // once. Scalar computes the head's owner; VF needs only a 32-bit comparison.
  const uint32_t owner = head_owner ^ uint32_t(ring_head + slot * full_blocks >= sq_depth);
  const bool completion = completion_on_last && slot + 1 == wr_count;
  const uint64_t remote = staging + uint64_t(request_offset) * token_bytes;
  // Materialize directly in UB, avoiding a dynamically indexed per-thread
  // words[] temporary. Actual compiler register spills still require CANN
  // resource reports; this source change alone does not prove a device fault.
  // Match the hardware-validated BatchPut boundary: MainScalar resolves the
  // physical UB bank and passes an explicitly qualified pointer into VF.
  auto* destination = bank + slot * full_blocks * 16;
  destination[0] = ((completion ? 2U : 1U) << 16) | (1U << 18) | (1U << 20) |
             (uint32_t(completion) << 21) | (1U << 28) | (1U << 29) | (owner << 31);
  destination[1] = kRead << 8;
  destination[2] = (tp_id & 0xffffffU) | (sges << 24);
  destination[3] = remote_token_id & 0xfffffU;
  destination[4] = static_cast<uint32_t>(eid_low);
  destination[5] = static_cast<uint32_t>(eid_low >> 32);
  destination[6] = static_cast<uint32_t>(eid_high);
  destination[7] = static_cast<uint32_t>(eid_high >> 32);
  destination[8] = remote_token_value;
  destination[9] = 0;
  destination[10] = static_cast<uint32_t>(remote);
  destination[11] = static_cast<uint32_t>(remote >> 32);
#pragma unroll
  for (uint32_t i = 0; i < KVAF_SEQ_MAX_SGES; ++i) {
    if (i < sges) {
      const uint64_t local = output + uint64_t(rows[request + i]) * token_bytes;
      destination[12 + i * 4] = token_bytes * (coalesce ? tokens : 1);
      destination[13 + i * 4] = local_token_id;
      destination[14 + i * 4] = static_cast<uint32_t>(local);
      destination[15 + i * 4] = static_cast<uint32_t>(local >> 32);
    }
  }
  // At most 48 bytes of padding complete the last 64-byte WQEBB.
  const uint32_t used_words = 12 + sges * 4;
#pragma unroll
  for (uint32_t i = 0; i < 12; ++i)
    if (used_words + i < blocks * 16) destination[used_words + i] = 0;
}

__aicore__ inline void CopyReadBankToSq(uint64_t sq, uint32_t sq_depth,
                                       uint64_t head, uint32_t blocks,
                                       uint32_t bank) {
  const uint32_t ring_head = head % sq_depth;
  const uint32_t first = Min(blocks, sq_depth - ring_head);
  const uint32_t bank_offset = bank * kReadBankBytes;
  // The same raw MTE3 primitive and loop configuration as direct_read. A
  // wrapped SQ post is two DMA commands, both covered by the following event.
  uint64_t config = (1ULL << 4) | (uint64_t(first * 64) << 25);
  copy_ubuf_to_gm_align_v2(reinterpret_cast<__gm__ float*>(sq + ring_head * 64ULL),
      reinterpret_cast<__ubuf__ float*>(get_imm(bank_offset)), config, 0);
  if (first != blocks) {
    config = (1ULL << 4) | (uint64_t((blocks - first) * 64) << 25);
    copy_ubuf_to_gm_align_v2(reinterpret_cast<__gm__ float*>(sq),
        reinterpret_cast<__ubuf__ float*>(get_imm(bank_offset + first * 64)), config, 0);
  }
}

struct ReadPost {
  uint64_t head, next_head;
  uint32_t blocks, wrs;
};

__aicore__ inline void CommitReadPost(const ReadPost& post, uint32_t bank,
                                     Queue& data, uint64_t ready_bytes,
                                     __gm__ KvafSequentialStatus* status) {
  wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
  data.state->sq_producer_index = post.next_head;
  data.wrs += post.wrs;
  status->data_wrs += post.wrs;
  if (data.profile) {
    data.profile->data_wrs += post.wrs;
    data.profile->data_wqebbs += post.blocks;
    const auto cycle = static_cast<uint64_t>(GetSystemCycle());
    if (!data.profile->first_read_submit_cycle) {
      data.profile->first_read_submit_cycle = cycle;
      data.profile->first_read_ready_bytes = ready_bytes;
    }
  }
  data.Publish();
}

// Read sequence and ready_bytes in one 40-byte control READ into this lane's
// mailbox (+16..+55). The ordered notify WRITE has completed before any query;
// the descriptor remains owned by this generation until the final CPU ACK.
struct ReadyPrefix {
  Queue& control;
  uint64_t descriptor, scratch, sequence, total_bytes;
  uint32_t chunk_bytes;
  __gm__ volatile KvafGatherBatchGetCoreProfile* profile;

  __aicore__ uint64_t BeginQuery() {
    const auto begin = profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    if (profile) ++profile->ready_queries;
    const auto result = control.StartRead(descriptor + 8, scratch + 16, 40);
    if (profile) profile->ready_wait_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
    return result;
  }
  // Return the observed byte prefix by value, or kErrorBit | result. In-flight
  // time overlapped with WQE work is excluded from scalar ready_wait_cycles.
  __aicore__ uint64_t FinishQuery(uint64_t previous) {
    const auto begin = profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    const auto result = control.Wait();
    const auto observed = result ? (kErrorBit | result) : ReadSnapshot(previous);
    if (profile) profile->ready_wait_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
    return observed;
  }
  __aicore__ uint64_t TryFinishQuery(uint64_t previous) {
    const auto begin = profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    const auto result = control.PollOnce();
    const auto observed = result == kCqPending ? kCqPending :
        result ? (kErrorBit | result) : ReadSnapshot(previous);
    if (profile) profile->ready_wait_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
    return observed;
  }
  __aicore__ uint64_t ReadSnapshot(uint64_t previous) {
    // Both fields occupy one line. CQ has completed and there is no new DMA
    // between these loads; invalidate once, then consume the same snapshot.
    Flush(scratch + 16, 40);
    const auto observed_sequence = *reinterpret_cast<__gm__ volatile uint64_t*>(scratch + 16);
    auto observed = *reinterpret_cast<__gm__ volatile uint64_t*>(scratch + 48);
    if (observed_sequence != sequence || (observed & kErrorBit) ||
        observed < previous || observed > total_bytes ||
        (observed != total_bytes && observed % chunk_bytes)) {
      observed = kErrorBit | KVAF_SEQ_REMOTE_ERROR;
    } else if (profile && observed && !profile->first_ready_cycle) {
      profile->first_ready_cycle = static_cast<uint64_t>(GetSystemCycle());
    }
    return observed;
  }
};

__aicore__ inline uint64_t WaitForGatherAck(
    const KvafGatherBatchGetArgs& a, Queue& control, uint64_t remote_control,
    uint64_t scratch, __gm__ volatile KvafGatherBatchGetCoreProfile* profile) {
  for (uint32_t poll = 0; poll < a.max_polls; ++poll) {
    if (profile) ++profile->ack_queries;
    const auto result = control.Transfer(kRead, remote_control + 8, scratch + 8, 8);
    if (result) return result;
    const auto ack = LoadWord(scratch + 8);
    if (ack == (a.sequence | kErrorBit)) return KVAF_SEQ_REMOTE_ERROR;
    if (ack == a.sequence) return KVAF_SEQ_OK;
    // ~sequence is only the CPU's started ACK, never a completion.
  }
  return KVAF_SEQ_TIMEOUT;
}

__aicore__ inline void IssueReadPost(const ReadPost& post, uint32_t bank, Queue& data) {
  wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
  CopyReadBankToSq(data.entity->sq_va, data.entity->sq_depth, post.head, post.blocks, bank);
  set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
  set_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank));
}

// Inputs are immutable snapshots. Caller resets its local bookkeeping after
// this function; no mutable cross-call aggregate stores pipeline progress.
__aicore__ inline void FinishReadBanks(
    uint32_t posts, bool built, const ReadPost* prepared, const ReadPost* pending,
    const bool* pending_live, const bool* release_live, Queue& data, uint64_t ready_bytes,
    __gm__ KvafSequentialStatus* status, bool publish) {
  if (!posts) return;
  const auto begin = data.profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
  const uint32_t last_bank = (posts - 1) % 2;
  if (built) {
    if (publish) IssueReadPost(prepared[last_bank], last_bank, data);
    else wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(last_bank));
  }
  const uint32_t oldest = posts >= 2 ? (posts - 2) % 2 : 0;
  for (uint32_t i = 0; i < 2; ++i) {
    const uint32_t bank = (oldest + i) % 2;
    if (!pending_live[bank]) continue;
    if (release_live[bank]) wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank));
    if (publish) CommitReadPost(pending[bank], bank, data, ready_bytes, status);
    else wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
  }
  if (built && publish) {
    wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(last_bank));
    CommitReadPost(prepared[last_bank], last_bank, data, ready_bytes, status);
  }
  if (data.profile)
    data.profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
}

__aicore__ inline uint64_t ReadGatherChunks(
    const KvafGatherBatchGetArgs& a, uint32_t first, uint32_t last,
    uint64_t staging, uint64_t remote_control, Queue& data, ReadyPrefix& ready,
    __gm__ KvafSequentialStatus* status) {
  const auto& r = a.request;
  const auto& e = *data.entity;
  const uint32_t full_blocks = (48 + (a.coalesce_sges ? 1 : a.sgl_size) * 16 + 63) / 64;
  const uint32_t total_wrs = (last - first + a.sgl_size - 1) / a.sgl_size;
  const uint32_t wave_limit = Min(e.sq_depth / full_blocks, e.sq_depth / 4);
  const auto eid_low = *reinterpret_cast<__gm__ const uint64_t*>(e.remote_eid);
  const auto eid_high = *reinterpret_cast<__gm__ const uint64_t*>(e.remote_eid + 8);
  uint64_t ready_bytes = 0;
  bool query_pending = false, primed = false;
  set_loop_size_ubtoout(1ULL | (1ULL << 21));
  set_loop1_stride_ubtoout(0);
  set_loop2_stride_ubtoout(0);
  set_atomic_none();
  for (uint32_t wave = 0; wave < total_wrs;) {
    const uint32_t wave_wrs = Min(total_wrs - wave, wave_limit);
    const uint32_t wave_end = wave + wave_wrs;
    uint64_t head = data.state->sq_producer_index;
    ReadPost prepared[2], pending[2];
    bool pending_live[2]{}, release_live[2]{}, built = false;
    uint32_t posts = 0;
    for (uint32_t wr = wave; wr < wave_end;) {
      const uint64_t needed = uint64_t(Min((wr + 1) * a.sgl_size, last - first)) * r.token_bytes;
      for (uint32_t poll = 0; ready_bytes < needed; ++poll) {
        if (poll == a.max_polls) {
          FinishReadBanks(posts, built, prepared, pending, pending_live, release_live,
                          data, ready_bytes, status, false);
          return KVAF_SEQ_TIMEOUT;
        }
        uint64_t observed = kCqPending;
        if (query_pending) observed = ready.TryFinishQuery(ready_bytes);
        if (observed == kCqPending) {
          // Only flush local banks when a real progress wait is necessary.
          // Completed lookahead queries extend the same VF/MTE3 pipeline.
          FinishReadBanks(posts, built, prepared, pending, pending_live, release_live,
                          data, ready_bytes, status, true);
          posts = 0; built = false;
          pending_live[0] = pending_live[1] = false;
          release_live[0] = release_live[1] = false;
          if (!query_pending) {
            const auto result = ready.BeginQuery();
            if (result) return result;
          }
          observed = ready.FinishQuery(ready_bytes);
        }
        query_pending = false;
        if (observed & kErrorBit) {
          FinishReadBanks(posts, built, prepared, pending, pending_live, release_live,
                          data, ready_bytes, status, false);
          return observed & ~kErrorBit;
        }
        ready_bytes = observed;
      }
      const uint32_t ready_wrs = ready_bytes == ready.total_bytes ? total_wrs :
          static_cast<uint32_t>(ready_bytes / (uint64_t(a.sgl_size) * r.token_bytes));
      const uint32_t wrs = Min(Min(ready_wrs - wr, wave_end - wr), kReadWrsPerPost);
      const auto begin = data.profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
      if (built) {
        const uint32_t previous = (posts - 1) % 2;
        IssueReadPost(prepared[previous], previous, data);
        pending[previous] = prepared[previous];
        pending_live[previous] = release_live[previous] = true;
      }
      const uint32_t bank = posts % 2;
      if (release_live[bank]) {
        wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank));
        release_live[bank] = false;
      }
      uint32_t blocks = wrs * full_blocks;
      if (wr + wrs == total_wrs) {
        const uint32_t tail = a.coalesce_sges ? 1 : last - first - (total_wrs - 1) * a.sgl_size;
        blocks -= full_blocks - (48 + tail * 16 + 63) / 64;
      }
      AscendC::Simt::VF_CALL<FillGatherReadWqes>(
          AscendC::Simt::Dim3{kReadWrsPerPost, 1U, 1U},
          reinterpret_cast<__ubuf__ uint32_t*>(get_imm(bank * kReadBankBytes)),
          reinterpret_cast<__gm__ const int32_t*>(r.output_indices), first, last,
          r.token_bytes, a.sgl_size, a.coalesce_sges, r.output, staging, wr, wrs,
          uint32_t(head % e.sq_depth), 1U - uint32_t((head / e.sq_depth) & 1),
          e.sq_depth, full_blocks, uint32_t(wr + wrs == wave_end),
          e.tp_id, e.remote_token_id, e.remote_token_value, e.local_token_id, eid_low, eid_high);
      set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
      prepared[bank] = {head, head + blocks, blocks, wrs};
      head += blocks;
      built = true;
      if (pending_live[bank]) {
        CommitReadPost(pending[bank], bank, data, ready_bytes, status);
        pending_live[bank] = false;
      }
      ++posts;
      wr += wrs;
      if (data.profile)
        data.profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
      if (!primed) {
        // First eligible post is latency-sensitive: publish after one VF/MTE3,
        // without waiting to prepare the next two posts.
        FinishReadBanks(posts, built, prepared, pending, pending_live, release_live,
                        data, ready_bytes, status, true);
        posts = 0; built = false;
        pending_live[0] = pending_live[1] = false;
        release_live[0] = release_live[1] = false;
        primed = true;
      }
      if (!query_pending && ready_bytes < ready.total_bytes) {
        const auto result = ready.BeginQuery();
        if (result) {
          FinishReadBanks(posts, built, prepared, pending, pending_live, release_live,
                          data, ready_bytes, status, false);
          return result;
        }
        query_pending = true;
      }
    }
    FinishReadBanks(posts, built, prepared, pending, pending_live, release_live,
                    data, ready_bytes, status, true);
    if (wave_end == total_wrs) {
      // Final ACK and payload CQ are independent completion conditions. Confirm
      // CPU completion while the NIC is still processing the last READ wave.
      status->phase = KVAF_SEQ_WAIT_REMOTE;
      const auto result = WaitForGatherAck(a, ready.control, remote_control, ready.scratch, data.profile);
      if (result) return result;
      Timeline{data.profile}.Stamp(4);
      status->phase = KVAF_SEQ_PAYLOAD;
    }
    const auto result = data.Wait();
    if (result) return result;
    wave = wave_end;
  }
  return KVAF_SEQ_OK;
}

// A single control wave reads the whole progress vector and the final ACK.
// Each progress word atomically carries its generation and completed WR count;
// no cross-word snapshot consistency or CPU-wide prefix is required.
struct ReadyShards {
  Queue& control;
  uint64_t remote_progress, remote_control, scratch, sequence;
  uint32_t total_wrs, shards;
  uint32_t ready[kvaf::kGatherMaxShards]{};
  bool pending{}, ack_done{};
  __gm__ volatile KvafGatherBatchGetCoreProfile* profile;

  __aicore__ uint64_t Begin() {
    if (pending) return KVAF_SEQ_OK;
    const auto begin = profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    if (profile) { ++profile->ready_queries; ++profile->ack_queries; }
    const uint64_t ack = scratch + 8, progress = scratch + 64;
    const uint32_t word = 8, bytes = kvaf::kGatherProgressBytes;
    auto result = control.Append(kRead, remote_control + 8, &ack, &word, 1);
    if (!result) result = control.Append(kRead, remote_progress, &progress, &bytes, 1, true);
    if (!result) { control.Publish(); pending = true; }
    if (profile) profile->ready_wait_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
    return result;
  }
  __aicore__ uint64_t Finish(bool blocking) {
    if (!pending) return KVAF_SEQ_OK;
    const auto begin = profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    auto result = blocking ? control.Wait() : control.PollOnce();
    if (result != kCqPending) {
      pending = false;
      if (!result) {
        Flush(scratch + 8, 8);
        const auto ack = *reinterpret_cast<__gm__ volatile uint64_t*>(scratch + 8);
        if (ack == (sequence | kErrorBit)) result = KVAF_SEQ_REMOTE_ERROR;
        if (ack == sequence) ack_done = true;
        Flush(scratch + 64, kvaf::kGatherProgressBytes);
        for (uint32_t shard = 0; shard < shards && !result; ++shard) {
          const auto value = *reinterpret_cast<__gm__ volatile uint64_t*>(scratch + 64 + shard * 8);
          const uint64_t generation = value >> 32;
          const uint32_t completed = static_cast<uint32_t>(value);
          const uint32_t size = kvaf::GatherShardBoundary(total_wrs, shards, shard + 1) -
              kvaf::GatherShardBoundary(total_wrs, shards, shard);
          if (generation > sequence ||
              (generation == sequence && (completed < ready[shard] || completed > size)))
            result = KVAF_SEQ_REMOTE_ERROR;
          else if (generation == sequence) ready[shard] = completed;
        }
        if (profile && !result && !profile->first_ready_cycle) {
          for (uint32_t shard = 0; shard < shards; ++shard)
            if (ready[shard]) { profile->first_ready_cycle = GetSystemCycle(); break; }
        }
      }
    }
    if (profile) profile->ready_wait_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
    return result;
  }
};

__aicore__ inline ReadPost BuildShardPost(
    const KvafGatherBatchGetArgs& a, uint32_t first, uint32_t last, uint64_t staging,
    Queue& data, uint32_t wr, uint32_t wrs, uint64_t head, uint32_t bank, bool tail) {
  const auto& e = *data.entity;
  const uint32_t full = (48 + (a.coalesce_sges ? 1 : a.sgl_size) * 16 + 63) / 64;
  const uint32_t total = (last - first + a.sgl_size - 1) / a.sgl_size;
  uint32_t blocks = wrs * full;
  if (wr + wrs == total) {
    const auto sges = a.coalesce_sges ? 1 : last - first - (total - 1) * a.sgl_size;
    blocks -= full - (48 + sges * 16 + 63) / 64;
  }
  AscendC::Simt::VF_CALL<FillGatherReadWqes>(
      AscendC::Simt::Dim3{kReadWrsPerPost, 1U, 1U},
      reinterpret_cast<__ubuf__ uint32_t*>(get_imm(bank * kReadBankBytes)),
      reinterpret_cast<__gm__ const int32_t*>(a.request.output_indices), first, last,
      a.request.token_bytes, a.sgl_size, a.coalesce_sges, a.request.output, staging, wr, wrs,
      uint32_t(head % e.sq_depth), 1U - uint32_t((head / e.sq_depth) & 1), e.sq_depth,
      full, uint32_t(tail), e.tp_id, e.remote_token_id, e.remote_token_value,
      e.local_token_id, *reinterpret_cast<__gm__ const uint64_t*>(e.remote_eid),
      *reinterpret_cast<__gm__ const uint64_t*>(e.remote_eid + 8));
  set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
  return {head, head + blocks, blocks, wrs};
}

// Merge adjacent ready shards into a normal post. Shard-sized progress must
// not force shard-sized VF launches/doorbells once a longer run is available.
__aicore__ inline uint32_t ReadyShardRun(uint32_t selected, uint32_t total,
    uint32_t shards, const uint32_t* ready, const uint32_t* consumed, uint32_t capacity) {
  uint32_t wrs = 0;
  for (uint32_t s = selected; s < shards && wrs < capacity; ++s) {
    if (s != selected && consumed[s]) break;
    const auto size = kvaf::GatherShardBoundary(total, shards, s + 1) -
        kvaf::GatherShardBoundary(total, shards, s);
    const auto available = ready[s] - consumed[s];
    wrs += Min(available, capacity - wrs);
    if (ready[s] != size) break;
  }
  return wrs;
}

__aicore__ inline uint64_t ReadGatherShards(
    const KvafGatherBatchGetArgs& a, uint32_t first, uint32_t last, uint64_t staging,
    uint64_t remote_descriptor, uint64_t remote_control, uint64_t scratch,
    Queue& data, Queue& control, __gm__ KvafSequentialStatus* status) {
  const uint32_t total = (last - first + a.sgl_size - 1) / a.sgl_size;
  const uint32_t shards = kvaf::GatherShardCount(total);
  const uint32_t full = (48 + (a.coalesce_sges ? 1 : a.sgl_size) * 16 + 63) / 64;
  const auto limit = Min(data.entity->sq_depth / full, data.entity->sq_depth / 4);
  ReadyShards progress{control, remote_descriptor + kvaf::GatherProgressOffset(last - first),
      remote_control, scratch, a.sequence, total, shards, {}, false, false, data.profile};
  uint32_t consumed[kvaf::kGatherMaxShards]{};
  uint32_t issued = 0, wave = 0, bank = 0, cursor = 0;
  uint64_t head = data.state->sq_producer_index;
  bool pending = false;
  ReadPost previous{};
  uint32_t previous_bank = 0;
  set_loop_size_ubtoout(1ULL | (1ULL << 21));
  set_loop1_stride_ubtoout(0); set_loop2_stride_ubtoout(0); set_atomic_none();
  while (issued < total) {
    // Query first, then fill UB without waiting for its completion. A speculative
    // candidate has no SQ reservation and may be replaced by any ready shard.
    bool need_progress = false;
    for (uint32_t s = 0; s < shards; ++s)
      if (progress.ready[s] < kvaf::GatherShardBoundary(total, shards, s + 1) -
          kvaf::GatherShardBoundary(total, shards, s)) need_progress = true;
    auto result = need_progress ? progress.Begin() : uint64_t(KVAF_SEQ_OK);
    if (result) {
      if (pending) {
        wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(previous_bank));
        wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(previous_bank));
      }
      return result;
    }
    uint32_t selected = shards;
    for (uint32_t n = 0; n < shards; ++n) {
      const uint32_t s = (cursor + n) % shards;
      if (progress.ready[s] > consumed[s]) { selected = s; break; }
    }
    if (selected == shards) {
      for (uint32_t n = 0; n < shards; ++n) {
        const uint32_t s = (cursor + n) % shards;
        const auto size = kvaf::GatherShardBoundary(total, shards, s + 1) -
            kvaf::GatherShardBoundary(total, shards, s);
        if (consumed[s] < size) { selected = s; break; }
      }
    }
    uint32_t wr = kvaf::GatherShardBoundary(total, shards, selected) + consumed[selected];
    uint32_t wrs = Min(Min(kReadWrsPerPost, limit - wave),
        kvaf::GatherShardBoundary(total, shards, selected + 1) - wr);
    if (progress.ready[selected] > consumed[selected])
      wrs = ReadyShardRun(selected, total, shards, progress.ready, consumed,
                          Min(kReadWrsPerPost, limit - wave));
    auto begin = data.profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    ReadPost prepared = BuildShardPost(a, first, last, staging, data, wr, wrs, head, bank,
        wave + wrs == limit || issued + wrs == total);
    if (pending) {
      // Previous MTE3 runs across this VF and across shard boundaries. Only its
      // bank is reclaimed; data CQ remains in flight until the physical wave.
      wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(previous_bank));
      CommitReadPost(previous, previous_bank, data, uint64_t(issued) * a.sgl_size * a.request.token_bytes, status);
      pending = false;
    }
    if (data.profile) data.profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
    result = progress.Finish(false);
    for (uint32_t poll = 0; result == kCqPending || !result; ++poll) {
      if (result == kCqPending) {
        bool cached = false;
        for (uint32_t s = 0; s < shards; ++s)
          if (progress.ready[s] > consumed[s]) cached = true;
        // Keep the control READ in flight while known-ready payload can make
        // progress. A missing fresh snapshot is not a reason to stop the NIC.
        result = cached ? uint64_t(KVAF_SEQ_OK) : progress.Finish(true);
      }
      if (result) break;
      uint32_t available = shards;
      if (progress.ready[selected] > consumed[selected]) available = selected;
      else for (uint32_t n = 0; n < shards; ++n) {
        const uint32_t s = (cursor + n) % shards;
        if (progress.ready[s] > consumed[s]) { available = s; break; }
      }
      if (available != shards) {
        const uint32_t count = ReadyShardRun(available, total, shards, progress.ready,
            consumed, Min(kReadWrsPerPost, limit - wave));
        if (available != selected || count != wrs) {
          wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
          selected = available;
          wr = kvaf::GatherShardBoundary(total, shards, selected) + consumed[selected];
          wrs = count;
          begin = data.profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
          prepared = BuildShardPost(a, first, last, staging, data, wr, wrs, head, bank,
              wave + wrs == limit || issued + wrs == total);
          if (data.profile) data.profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
        }
        break;
      }
      if (poll == a.max_polls) { result = KVAF_SEQ_TIMEOUT; break; }
      result = progress.Begin();
      if (result) break;
      result = progress.Finish(false);
    }
    if (result) {
      wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
      return result;
    }
    begin = data.profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    IssueReadPost(prepared, bank, data);
    previous = prepared; previous_bank = bank; pending = true;
    head = prepared.next_head;
    uint32_t remaining = wrs;
    for (uint32_t s = selected; remaining; ++s) {
      const auto size = kvaf::GatherShardBoundary(total, shards, s + 1) -
          kvaf::GatherShardBoundary(total, shards, s);
      const auto n = Min(remaining, size - consumed[s]);
      consumed[s] += n; remaining -= n;
      cursor = (s + 1) % shards;
    }
    issued += wrs; wave += wrs;
    if (data.profile) data.profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - begin;
    if (issued == wrs || wave == limit || issued == total) {
      // First eligible post goes out immediately. Later posts keep both banks
      // alive across ready queries; only capacity and final completion drain CQ.
      wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank));
      uint64_t ready_bytes = 0;
      for (uint32_t s = 0; s < shards; ++s) {
        const uint64_t end = uint64_t(kvaf::GatherShardBoundary(total, shards, s) + progress.ready[s]) *
            a.sgl_size * a.request.token_bytes;
        const uint64_t start = uint64_t(kvaf::GatherShardBoundary(total, shards, s)) *
            a.sgl_size * a.request.token_bytes;
        ready_bytes += (end > uint64_t(last - first) * a.request.token_bytes ?
            uint64_t(last - first) * a.request.token_bytes : end) - start;
      }
      CommitReadPost(previous, bank, data, ready_bytes, status);
      pending = false;
      if (issued == total) {
        if (progress.pending) { result = progress.Finish(true); if (result) return result; }
        if (!progress.ack_done) {
          result = WaitForGatherAck(a, control, remote_control, scratch, data.profile);
          if (result) return result;
        }
        Timeline{data.profile}.Stamp(4);
      }
      if (wave == limit || issued == total) {
        result = data.Wait();
        if (result) return result;
        wave = 0;
      }
    }
    bank ^= 1U;
  }
  return KVAF_SEQ_OK;
}

__aicore__ inline uint64_t ReadGatherPipeline(
    const KvafGatherBatchGetArgs& a, uint32_t first, uint32_t last,
    uint64_t staging, Queue& data, __gm__ KvafSequentialStatus* status) {
  const auto& r = a.request;
  const auto& e = *data.entity;
  const uint32_t full_blocks = (48 + (a.coalesce_sges ? 1 : a.sgl_size) * 16 + 63) / 64;
  const uint32_t total_wrs = (last - first + a.sgl_size - 1) / a.sgl_size;
  const uint64_t ready_bytes = uint64_t(last - first) * r.token_bytes;
  // A physical wave respects both WQEBB capacity and the transport WR limit.
  // 128 is only a publishing batch size, never a completion/outstanding cap.
  const uint32_t wave_limit = Min(e.sq_depth / full_blocks, e.sq_depth / 4);
  const auto eid_low = *reinterpret_cast<__gm__ const uint64_t*>(e.remote_eid);
  const auto eid_high = *reinterpret_cast<__gm__ const uint64_t*>(e.remote_eid + 8);
  // Descriptor MTE3 has already finished. A WQE-only checkpoint must not
  // execute additional data-SQ MTE3 configuration instructions.
  if (a.probe != KVAF_GATHER_PROBE_WQE) {
    set_loop_size_ubtoout(1ULL | (1ULL << 21));
    set_loop1_stride_ubtoout(0);
    set_loop2_stride_ubtoout(0);
    set_atomic_none();
  }
  for (uint32_t wave = 0; wave < total_wrs;) {
    const auto build_begin = data.profile ? static_cast<uint64_t>(GetSystemCycle()) : 0;
    const uint32_t wave_wrs = Min(total_wrs - wave,
        a.probe == KVAF_GATHER_PROBE_FIRST_READ ? Min(wave_limit, kReadWrsPerPost) : wave_limit);
    const uint32_t posts = (wave_wrs + kReadWrsPerPost - 1) / kReadWrsPerPost;
    uint64_t head = data.state->sq_producer_index;
    ReadPost prepared[2], pending[2];
    for (uint32_t post = 0; post < posts; ++post) {
      // Copy the preceding bank while VF fills the other. The MTE3->V event
      // releases UB after DMA, independently of remote READ completion.
      const uint32_t previous_bank = (post + 1) % 2;
      if (post) {
        wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(previous_bank));
        const auto& previous = prepared[previous_bank];
        CopyReadBankToSq(e.sq_va, e.sq_depth, previous.head, previous.blocks, previous_bank);
        set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(previous_bank));
        if (post + 1 < posts)
          set_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(previous_bank));
        pending[previous_bank] = previous;
      }
      const uint32_t bank = post % 2;
      if (post >= 2) wait_flag(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank));
      const uint32_t wr_offset = wave + post * kReadWrsPerPost;
      const uint32_t wrs = Min(wave_wrs - post * kReadWrsPerPost, kReadWrsPerPost);
      uint32_t blocks = wrs * full_blocks;
      if (wr_offset + wrs == total_wrs) {
        const uint32_t tail_sges = a.coalesce_sges ? 1 :
            last - first - (total_wrs - 1) * a.sgl_size;
        blocks -= full_blocks - (48 + tail_sges * 16 + 63) / 64;
      }
      AscendC::Simt::VF_CALL<FillGatherReadWqes>(
          AscendC::Simt::Dim3{kReadWrsPerPost, 1U, 1U},
          reinterpret_cast<__ubuf__ uint32_t*>(get_imm(bank * kReadBankBytes)),
          reinterpret_cast<__gm__ const int32_t*>(r.output_indices), first, last,
          r.token_bytes, a.sgl_size, a.coalesce_sges, r.output, staging, wr_offset, wrs,
          uint32_t(head % e.sq_depth), 1U - uint32_t((head / e.sq_depth) & 1),
          e.sq_depth, full_blocks, uint32_t(post + 1 == posts),
          e.tp_id, e.remote_token_id, e.remote_token_value, e.local_token_id,
          eid_low, eid_high);
      if (a.probe == KVAF_GATHER_PROBE_WQE) {
        // Stop only after VF has finished, without issuing any SQ DMA or READ.
        set_flag(PIPE_V, PIPE_S, static_cast<event_t>(2));
        wait_flag(PIPE_V, PIPE_S, static_cast<event_t>(2));
        status->phase = KVAF_GATHER_AFTER_WQE;
        return KVAF_SEQ_PROBE_COMPLETE;
      }
      set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
      if (a.probe == KVAF_GATHER_PROBE_SQ) {
        wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
        CopyReadBankToSq(e.sq_va, e.sq_depth, head, blocks, bank);
        set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
        wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
        status->phase = KVAF_GATHER_AFTER_SQ;
        return KVAF_SEQ_PROBE_COMPLETE;
      }
      prepared[bank] = {head, head + blocks, blocks, wrs};
      head += blocks;
      // Match direct_read's three-stage schedule: issue MTE(n-1), prepare
      // VF(n), then commit n-2. Do not stall Scalar on MTE(n-1) each round.
      if (post >= 2) CommitReadPost(pending[(post - 2) % 2], (post - 2) % 2, data, ready_bytes, status);
    }
    const uint32_t bank = (posts - 1) % 2;
    wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(bank));
    const auto& final = prepared[bank];
    CopyReadBankToSq(e.sq_va, e.sq_depth, final.head, final.blocks, bank);
    set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(bank));
    pending[bank] = final;
    if (posts > 1) {
      const uint32_t previous_bank = (posts - 2) % 2;
      CommitReadPost(pending[previous_bank], previous_bank, data, ready_bytes, status);
    }
    CommitReadPost(pending[bank], bank, data, ready_bytes, status);
    if (data.profile)
      data.profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - build_begin;
    // The tail was signaled before publication. Never patch posted SQ memory.
    const auto result = data.Wait();
    if (result) return result;
    if (a.probe == KVAF_GATHER_PROBE_FIRST_READ) {
      status->phase = KVAF_GATHER_AFTER_FIRST_READ;
      return KVAF_SEQ_PROBE_COMPLETE;
    }
    wave += wave_wrs;
  }
  return KVAF_SEQ_OK;
}

__aicore__ uint64_t Gather(const KvafGatherBatchGetArgs& a, uint32_t core,
                           uint32_t count, __gm__ KvafSequentialStatus* status,
                           __gm__ volatile KvafGatherBatchGetCoreProfile* profile) {
  const Timeline timeline{profile};
  const auto& r = a.request;
  const uint32_t first = uint64_t(count) * core / r.block_count;
  const uint32_t last = uint64_t(count) * (core + 1) / r.block_count;
  if (first == last) {
    timeline.Stamp(1); timeline.Empty();
    if (a.probe) {
      status->phase = KVAF_GATHER_AFTER_ACK + a.probe - 1;
      return KVAF_SEQ_PROBE_COMPLETE;
    }
    return KVAF_SEQ_OK;
  }
  // Match direct_read: per-request validation is disabled.
  // if (!ValidateRows(a, first, last)) return KVAF_SEQ_INVALID;
  timeline.Stamp(1);
  auto* states = reinterpret_cast<__gm__ KvafBatchGetQueueState*>(r.queue_state) + core * 2;
  const auto* scratch_entities = reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity*>(a.workspace_entity);
  const auto* output_entities = reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity*>(r.channel_entity);
  Queue control{scratch_entities + core * 2 + 1, states + 1, 0, 0, 0, a.max_polls};
  Queue data{output_entities + core * 2, states, 0, 0, 0, a.max_polls,
             profile};
  auto result = control.Init();
  if (!result) result = data.Init();
  if (result) return result;
  const auto descriptor = a.workspace + a.descriptor_offset + core * a.lane_descriptor_bytes;
  const auto remote_descriptor = a.remote_descriptor + core * a.lane_descriptor_bytes;
  const auto staging = a.remote_staging + core * a.lane_staging_bytes;
  const auto scratch = a.workspace + core * uint64_t(kvaf::kGatherScratchBytes);
  const auto remote_control = a.remote_control + core * 64;
  if (profile) profile->pipeline_chunk_bytes = a.pipeline_chunk_bytes;
  status->phase = KVAF_SEQ_BUILD;
  BuildGatherDescriptor(a, first, last, descriptor, staging);
  const uint64_t descriptor_bytes = a.pipeline_shards ?
      kvaf::GatherProgressOffset(last - first) + kvaf::kGatherProgressBytes :
      48 + uint64_t(last - first) * 16;
  timeline.Stamp(2);
  // Descriptor, command and notify share one ordered WRITE wave. Only physical
  // queue capacity may force an intermediate drain; the strong notify tail
  // orders all preceding descriptor/command WRITEs before CPU notification.
  result = control.AppendTransfer(kWrite, remote_descriptor, descriptor, descriptor_bytes);
  if (result) return result;
  // Both WRITE sources must stay distinct and unchanged until the ordered tail
  // completes. Clean this lane's mailbox line once, then only read it for ACKs.
  auto* mailbox = reinterpret_cast<__gm__ uint64_t*>(scratch);
  mailbox[0] = a.sequence;
  mailbox[2] = remote_descriptor;
  Flush(scratch, 24);
  status->phase = KVAF_SEQ_NOTIFY;
  const uint64_t command_source = scratch + 16;
  const uint64_t notify_source = scratch;
  const uint32_t word_bytes = 8;
  result = control.Append(kWrite, remote_control + 16, &command_source, &word_bytes, 1);
  if (result) return result;
  result = control.Append(kWrite, remote_control, &notify_source, &word_bytes, 1, true);
  if (result) return result;
  control.Publish();
  result = control.Wait();
  if (result) return result;
  timeline.Stamp(3);
  status->phase = KVAF_SEQ_WAIT_REMOTE;
  if (!a.pipeline_chunk_bytes) {
    result = WaitForGatherAck(a, control, remote_control, scratch, profile);
    if (result) { control.Poison(result); return data.Poison(result); }
    timeline.Stamp(4);
  }
  if (a.probe == KVAF_GATHER_PROBE_ACK) {
    status->phase = KVAF_GATHER_AFTER_ACK;
    status->requests = last - first;
    return KVAF_SEQ_PROBE_COMPLETE;
  }
  status->phase = KVAF_SEQ_PAYLOAD;
  if (uint64_t(r.token_bytes) * a.sgl_size <= 65536) {
    const uint64_t total_bytes = uint64_t(last - first) * r.token_bytes;
    ReadyPrefix ready{control, remote_descriptor, scratch, a.sequence, total_bytes,
        a.pipeline_chunk_bytes, profile};
    result = a.pipeline_shards ?
        ReadGatherShards(a, first, last, staging, remote_descriptor, remote_control, scratch, data, control, status) :
        a.pipeline_chunk_bytes ?
        ReadGatherChunks(a, first, last, staging, remote_control, data, ready, status) :
        ReadGatherPipeline(a, first, last, staging, data, status);
  } else {
    // Keep the general split-token encoder for payloads exceeding one 64 KiB WR.
    // Only this fallback reads row mappings through Scalar's data cache. The
    // normal SIMT path follows direct_read and needs no Scalar input sweep.
    Flush(r.output_indices + uint64_t(first) * 4, uint64_t(last - first) * 4);
    uint32_t index = first, offset = 0;
    uint64_t source_offset = 0;
    while (index < last) {
      const auto build_begin = timeline.Enabled() ? static_cast<uint64_t>(GetSystemCycle()) : 0;
      uint64_t local[KVAF_SEQ_MAX_SGES];
      uint32_t lengths[KVAF_SEQ_MAX_SGES];
      uint32_t sges = 0, bytes = 0;
      const auto remote = staging + source_offset;
      while (index < last && sges < a.sgl_size && bytes < 65536) {
        const auto row = reinterpret_cast<__gm__ const int32_t*>(r.output_indices)[index];
        const auto n = Min(r.token_bytes - offset, 65536 - bytes);
        local[sges] = r.output + uint64_t(row) * r.token_bytes + offset;
        lengths[sges++] = n;
        bytes += n; source_offset += n; offset += n;
        if (offset == r.token_bytes) { ++index; offset = 0; }
      }
      if (timeline.Enabled())
        profile->read_build_cycles += static_cast<uint64_t>(GetSystemCycle()) - build_begin;
      result = data.Append(kRead, remote, local, lengths, sges);
      if (result) return result;
      ++status->data_wrs;
      if (timeline.Enabled()) ++profile->data_wrs;
    }
    result = data.Drain();
  }
  if (!result) timeline.Stamp(5);
  if (result && result != KVAF_SEQ_PROBE_COMPLETE) {
    // A partial wave may have no signaled tail. Do not patch posted WQEs or
    // reuse its staging/descriptor; shutdown must quiesce the transport.
    control.Poison(result);
    data.Poison(result);
  }
  status->sq_pi = states->sq_producer_index;
  status->cq_ci = states->cq_consumer_index;
  status->requests = last - first;
  if (timeline.Enabled()) profile->requests = last - first;
  return result;
}
}  // namespace kvaf_gather

extern "C" __global__ __aicore__ void KvafGatherBatchGetAivKernelV5(
    KvafGatherBatchGetArgs args) {
  using namespace kvaf_gather;
  const auto core = GetBlockIdx();
  const auto& r = args.request;
  if (!r.core_status || core >= r.block_count) return;
  auto* profile = args.profile ?
      reinterpret_cast<__gm__ volatile KvafGatherBatchGetCoreProfile*>(args.profile) + core : nullptr;
  Timeline timeline{profile};
  timeline.Initialize(args.sequence);
  timeline.Stamp(0);
  // WQE banks use the direct_read raw UB/MTE3 path. Keep scatter's static
  // LocalTensor/TPipe setup out of this entry; payload still goes NIC->output.
  auto* status = reinterpret_cast<__gm__ KvafSequentialStatus*>(r.core_status) + core;
  status->magic = KVAF_SEQ_STATUS_MAGIC; status->sequence = args.sequence;
  status->phase = KVAF_SEQ_VALIDATE; status->result = KVAF_SEQ_INVALID;
  status->requests = status->data_wrs = status->sq_pi = status->cq_ci = 0;
  uint64_t result = KVAF_SEQ_INVALID;
  if (r.block_count && r.block_count <= KVAF_SEQ_MAX_WORKERS && r.token_bytes &&
      r.tokens_per_block && r.address_table && r.valid_table && r.indices && r.offsets &&
      r.miss_count && r.output_indices && r.output && args.workspace && args.sequence &&
      args.sequence <= UINT32_MAX && args.max_polls && r.request_capacity <= KVAF_SEQ_MAX_REQUESTS &&
      args.sgl_size && args.sgl_size <= KVAF_SEQ_MAX_SGES && args.coalesce_sges <= 1 &&
      args.pipeline_shards <= 1 && (!args.pipeline_shards || args.pipeline_chunk_bytes) &&
      (!args.pipeline_chunk_bytes || (args.pipeline_chunk_bytes >= 64 &&
       args.pipeline_chunk_bytes % 64 == 0 && !args.probe &&
       uint64_t(r.token_bytes) * args.sgl_size <= 65536)) &&
      (!args.coalesce_sges || uint64_t(r.token_bytes) * args.sgl_size <= 65536) &&
      args.probe <= KVAF_GATHER_PROBE_FIRST_READ &&
      (!args.probe || args.probe == KVAF_GATHER_PROBE_ACK ||
       uint64_t(r.token_bytes) * args.sgl_size <= 65536)) {
    // Scalar consumes only the count here. Address/index/offset/row arrays are
    // consumed by SIMT, as in direct_read; a Scalar DCCI sweep of those arrays
    // neither refreshes SIMT caches nor scales with this core's active slice.
    // Preserve one line for the mutable Scalar count across repeated launches.
    Flush(r.miss_count, 4);
    const auto count = *reinterpret_cast<__gm__ const int32_t*>(r.miss_count);
    if (count >= 0 && uint32_t(count) <= r.request_capacity) {
      if (!count) {
        timeline.Stamp(1); timeline.Empty();
        result = KVAF_SEQ_OK;
      }
      else if (r.queue_state && r.channel_entity && args.workspace_entity)
        result = Gather(args, core, count, status, profile);
    }
  }
  status->result = result;
  if (!result) status->phase = KVAF_SEQ_COMPLETE;
  if (r.queue_state)
    Flush(r.queue_state + core * 2 * sizeof(KvafBatchGetQueueState),
          2 * sizeof(KvafBatchGetQueueState));
  Flush(reinterpret_cast<uint64_t>(status), sizeof(*status));
  timeline.Finish(result);
}

// Publish the same explicit AIV kernel type metadata as BatchPut/direct_read.
// The Host's AIV engine launch attribute and the binary metadata are separate
// parts of the standalone AIV launch contract.
static const struct FunLevelKType
    KvafGatherBatchGetAivKernelV5_kernel_type_section __attribute__(
        (used, section(".ascend.meta.KvafGatherBatchGetAivKernelV5"))) =
        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
