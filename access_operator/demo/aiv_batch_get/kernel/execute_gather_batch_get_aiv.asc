#include "gather_batch_get_abi.h"
#include "batch_get_kernel_common.h"

namespace kvaf_gather {
using namespace AscendC;
using namespace kvaf_aiv;
constexpr uint64_t kGatherMagic = 0x4b56414647445232ULL;
constexpr uint64_t kErrorBit = 1ULL << 63;
constexpr uint32_t kRead = 6, kWrite = 3;
// One queue owns a physically bounded wave. No configurable outstanding window.
struct Queue {
  __gm__ const KvafBatchGetDirectUrmaEntity* entity;
  __gm__ KvafBatchGetQueueState* state;
  uint64_t wave_begin, last_header;
  uint32_t wrs, max_polls;

  __aicore__ uint64_t Init() {
    Flush(reinterpret_cast<uint64_t>(entity), sizeof(*entity));
    Flush(reinterpret_cast<uint64_t>(state), sizeof(*state));
    const auto& e = *entity;
    if (e.magic != 0x4b564155U || e.version != 1 || !e.sq_va || !e.sq_db_va ||
        !e.cq_va || !e.cq_db_va || e.sq_depth < 4 || e.sq_depth % 4 ||
        !e.cq_depth || e.cqe_size < 32 || e.wqe_size != 64 || !e.local_token_id)
      return KVAF_SEQ_QUEUE_ERROR;
    if (state->initialized && (state->magic != 0x4b564151U || state->poisoned))
      return KVAF_SEQ_QUEUE_ERROR;
    if (!state->initialized) {
      state->magic = 0x4b564151U;
      state->initialized = 1;
      state->sq_producer_index = state->cq_consumer_index = 0;
      state->poisoned = state->last_error = 0;
    }
    wave_begin = state->sq_producer_index;
    wrs = 0;
    return KVAF_SEQ_OK;
  }
  __aicore__ uint64_t Drain() {
    if (!wrs) return KVAF_SEQ_OK;
    auto* tail = reinterpret_cast<__gm__ uint32_t*>(last_header);
    *tail = (*tail & ~(3U << 16)) | (2U << 16) | (1U << 21);
    Flush(last_header, 64);
    st_dev(static_cast<uint32_t>(state->sq_producer_index),
           reinterpret_cast<__gm__ uint32_t*>(entity->sq_db_va), 0);
    const auto ci = state->cq_consumer_index;
    const auto cqe = entity->cq_va + (ci % entity->cq_depth) * entity->cqe_size;
    uint64_t result = KVAF_SEQ_TIMEOUT;
    for (uint32_t poll = 0; poll < max_polls; ++poll) {
      Flush(cqe, 32);
      const auto word = *reinterpret_cast<__gm__ volatile uint32_t*>(cqe);
      if (((word >> 2) & 1) == ((ci / entity->cq_depth) & 1)) continue;
      ++state->cq_consumer_index;
      st_dev(static_cast<uint32_t>(state->cq_consumer_index) & 0x003fffffU,
             reinterpret_cast<__gm__ uint32_t*>(entity->cq_db_va), 0);
      result = (word & 0xffff0000U) ? KVAF_SEQ_CQ_ERROR : KVAF_SEQ_OK;
      break;
    }
    if (result) {
      state->last_error = result;
      state->poisoned = 1;
    } else {
      wave_begin = state->sq_producer_index;
      wrs = 0;
    }
    return result;
  }
  __aicore__ uint64_t Append(uint32_t opcode, uint64_t remote,
                            const uint64_t* local, const uint32_t* lengths,
                            uint32_t count) {
    // 48-byte common header followed by count 16-byte local SGEs.
    // The SQ producer/owner operate in 64-byte WQEBBs, not logical WRs.
    const uint32_t blocks = (48 + count * 16 + 63) / 64;
    const auto& e = *entity;
    if (!count || count > KVAF_SEQ_MAX_SGES || blocks > e.sq_depth)
      return KVAF_SEQ_QUEUE_ERROR;
    if (state->sq_producer_index - wave_begin + blocks > e.sq_depth ||
        wrs == e.sq_depth / 4) {
      const auto result = Drain();
      if (result) return result;
    }
    const auto pi = state->sq_producer_index;
    uint32_t words[48] = {};
    const uint32_t owner = 1U - static_cast<uint32_t>((pi / e.sq_depth) & 1);
    words[0] = (1U << 16) | (1U << 18) | (1U << 20) |
               (1U << 28) | (1U << 29) | (owner << 31);
    words[1] = opcode << 8;
    words[2] = (e.tp_id & 0xffffffU) | (count << 24);
    words[3] = e.remote_token_id & 0xfffffU;
    const auto* eid = reinterpret_cast<__gm__ const uint32_t*>(e.remote_eid);
    for (uint32_t i = 0; i < 4; ++i) words[4 + i] = eid[i];
    words[8] = e.remote_token_value;
    words[10] = static_cast<uint32_t>(remote);
    words[11] = static_cast<uint32_t>(remote >> 32);
    for (uint32_t i = 0; i < count; ++i) {
      words[12 + i * 4] = lengths[i];
      words[13 + i * 4] = e.local_token_id;
      words[14 + i * 4] = static_cast<uint32_t>(local[i]);
      words[15 + i * 4] = static_cast<uint32_t>(local[i] >> 32);
    }
    for (uint32_t b = 0; b < blocks; ++b) {
      const auto dst = e.sq_va + ((pi + b) % e.sq_depth) * 64;
      auto* out = reinterpret_cast<__gm__ uint32_t*>(dst);
      for (uint32_t i = 0; i < 16; ++i) out[i] = words[b * 16 + i];
      Flush(dst, 64);
    }
    last_header = e.sq_va + (pi % e.sq_depth) * 64;
    state->sq_producer_index += blocks;
    ++wrs;
    return KVAF_SEQ_OK;
  }
  __aicore__ uint64_t Transfer(uint32_t opcode, uint64_t remote,
                              uint64_t local, uint64_t bytes) {
    while (bytes) {
      const uint32_t n = bytes > 65536 ? 65536 : static_cast<uint32_t>(bytes);
      const auto result = Append(opcode, remote, &local, &n, 1);
      if (result) return result;
      remote += n; local += n; bytes -= n;
    }
    return Drain();
  }
};

__aicore__ uint64_t Gather(const KvafGatherBatchGetArgs& a, uint32_t core,
                           uint32_t count, __gm__ KvafSequentialStatus* status) {
  const auto& r = a.request;
  const uint32_t first = uint64_t(count) * core / r.block_count;
  const uint32_t last = uint64_t(count) * (core + 1) / r.block_count;
  if (first == last) return KVAF_SEQ_OK;
  if (!ValidateRows(a, first, last)) return KVAF_SEQ_INVALID;
  auto* states = reinterpret_cast<__gm__ KvafBatchGetQueueState*>(r.queue_state) + core * 2;
  const auto* scratch_entities = reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity*>(a.workspace_entity);
  const auto* output_entities = reinterpret_cast<__gm__ const KvafBatchGetDirectUrmaEntity*>(r.channel_entity);
  Queue control{scratch_entities + core * 2 + 1, states + 1, 0, 0, 0, a.max_polls};
  Queue data{output_entities + core * 2, states, 0, 0, 0, a.max_polls};
  auto result = control.Init();
  if (!result) result = data.Init();
  if (result) return result;
  const auto descriptor = a.workspace + a.descriptor_offset + core * a.lane_descriptor_bytes;
  const auto remote_descriptor = a.remote_descriptor + core * a.lane_descriptor_bytes;
  const auto staging = a.remote_staging + core * a.lane_staging_bytes;
  const auto scratch = a.workspace + core * 64;
  const auto remote_control = a.remote_control + core * 64;
  status->phase = KVAF_SEQ_BUILD;
  auto* h = reinterpret_cast<__gm__ KvafSequentialGatherHeader*>(descriptor);
  h->magic = kGatherMagic; h->sequence = a.sequence; h->staging_address = staging;
  h->span_count = last - first; h->total_bytes = (last - first) * r.token_bytes;
  h->pipeline_chunk_bytes = 0; h->span_bytes = r.token_bytes; h->ready_bytes = 0;
  auto* spans = reinterpret_cast<__gm__ KvafSequentialGatherSpan*>(descriptor + 48);
  for (uint32_t i = first; i < last; ++i) {
    spans[i - first].address = Source(a, i);
    spans[i - first].length = r.token_bytes; spans[i - first].reserved = 0;
  }
  const uint64_t descriptor_bytes = 48 + uint64_t(last - first) * 16;
  Flush(descriptor, descriptor_bytes);
  result = control.Transfer(kWrite, remote_descriptor, descriptor, descriptor_bytes);
  if (result) return result;
  PublishWord(scratch, remote_descriptor);
  status->phase = KVAF_SEQ_NOTIFY;
  result = control.Transfer(kWrite, remote_control + 16, scratch, 8);
  if (result) return result;
  PublishWord(scratch, a.sequence);
  result = control.Transfer(kWrite, remote_control, scratch, 8);
  if (result) return result;
  status->phase = KVAF_SEQ_WAIT_REMOTE;
  bool acknowledged = false;
  for (uint32_t poll = 0; poll < a.max_polls; ++poll) {
    result = control.Transfer(kRead, remote_control + 8, scratch + 8, 8);
    if (result) return result;
    const auto ack = LoadWord(scratch + 8);
    if (ack == (a.sequence | kErrorBit)) return KVAF_SEQ_REMOTE_ERROR;
    if (ack == a.sequence) { acknowledged = true; break; }
    // ~sequence is only the CPU's started ACK, never a completion.
  }
  if (!acknowledged) return KVAF_SEQ_TIMEOUT;
  status->phase = KVAF_SEQ_PAYLOAD;
  uint32_t index = first, offset = 0;
  uint64_t source_offset = 0;
  while (index < last) {
    uint64_t local[KVAF_SEQ_MAX_SGES];
    uint32_t lengths[KVAF_SEQ_MAX_SGES];
    uint32_t sges = 0, bytes = 0;
    const auto remote = staging + source_offset;
    while (index < last && sges < a.sgl_size && bytes < 65536) {
      const auto row = reinterpret_cast<__gm__ const int32_t*>(r.output_indices)[index];
      const auto n = Min(r.token_bytes - offset, 65536 - bytes);
      local[sges] = r.output + uint64_t(row) * r.token_bytes + offset;
      lengths[sges++] = n;
      bytes += n; source_offset += n; offset += n;
      if (offset == r.token_bytes) { ++index; offset = 0; }
    }
    result = data.Append(kRead, remote, local, lengths, sges);
    if (result) return result;
    ++status->data_wrs;
  }
  result = data.Drain();
  status->sq_pi = states->sq_producer_index;
  status->cq_ci = states->cq_consumer_index;
  status->requests = last - first;
  return result;
}
}  // namespace kvaf_gather

extern "C" __global__ __aicore__ void KvafGatherBatchGetAivKernelV1(
    KvafGatherBatchGetArgs args) {
  using namespace kvaf_gather;
  const auto core = GetBlockIdx();
  const auto& r = args.request;
  if (!r.core_status || core >= r.block_count) return;
  // Gather uses scalar GM/cache operations and USER_CTL queues, with no
  // LocalTensor or MTE copies. Keep scatter's static-Tensor setup out of this
  // entry so it retains the lifecycle used by the validated gather path.
  auto* status = reinterpret_cast<__gm__ KvafSequentialStatus*>(r.core_status) + core;
  status->magic = KVAF_SEQ_STATUS_MAGIC; status->sequence = args.sequence;
  status->phase = KVAF_SEQ_VALIDATE; status->result = KVAF_SEQ_INVALID;
  status->requests = status->data_wrs = status->sq_pi = status->cq_ci = 0;
  uint64_t result = KVAF_SEQ_INVALID;
  if (r.block_count && r.block_count <= KVAF_SEQ_MAX_WORKERS && r.token_bytes &&
      r.tokens_per_block && r.address_table && r.valid_table && r.indices && r.offsets &&
      r.miss_count && r.output_indices && r.output && args.workspace && args.sequence &&
      args.sequence <= UINT32_MAX && args.max_polls && r.request_capacity <= KVAF_SEQ_MAX_REQUESTS &&
      args.sgl_size && args.sgl_size <= KVAF_SEQ_MAX_SGES) {
    // Inputs and persistent queue state may have changed since this physical
    // core last ran the kernel. A new launch is not a scalar-cache invalidate.
    Flush(r.miss_count, 4);
    Flush(r.address_table, uint64_t(r.table_capacity) * 8);
    Flush(r.valid_table, r.table_capacity);
    Flush(r.indices, uint64_t(r.request_capacity) * 4);
    Flush(r.offsets, uint64_t(r.request_capacity) * 4);
    Flush(r.output_indices, uint64_t(r.request_capacity) * 4);
    const auto count = *reinterpret_cast<__gm__ const int32_t*>(r.miss_count);
    if (count >= 0 && uint32_t(count) <= r.request_capacity) {
      if (!count) result = KVAF_SEQ_OK;
      else if (r.queue_state && r.channel_entity && args.workspace_entity)
        result = Gather(args, core, count, status);
    }
  }
  status->result = result;
  if (!result) status->phase = KVAF_SEQ_COMPLETE;
  if (r.queue_state)
    Flush(r.queue_state + core * 2 * sizeof(KvafBatchGetQueueState),
          2 * sizeof(KvafBatchGetQueueState));
  Flush(reinterpret_cast<uint64_t>(status), sizeof(*status));
}
