#include "kernel_operator.h"
#include "batch_put_internal.h"


// Synchronous eager BatchPut data plane. Request i writes the packed input
// range [input_offsets[i], input_offsets[i] + lengths[i]) to
// destination_addresses[i].
using namespace AscendC;

namespace {

constexpr uint32_t kEntityMagic = 0x4b564155U;  // "KVAU"
constexpr uint32_t kEntityVersion = 1U;
constexpr uint32_t kQueueMagic = 0x4b564151U;   // "KVAQ"
// CANN 9.1 PTO UrmaOpcode / HCCL udma_data_struct.h: WRITE=0x3,
// WRITE_WITH_IMM=0x4, WRITE_WITH_NOTIFY=0x5, READ=0x6.
constexpr uint32_t kWriteOpcode = 0x3U;
constexpr uint32_t kWqeBytes = 64U;
constexpr uint32_t kWqesPerPost = 32U;
constexpr uint32_t kCqeProbeBytes = 32U;
constexpr uint32_t kCqConsumerMask = 0x003fffffU;
// A failed first-ABI smoke test must return a device status rather than keep
// the host process inside a DCCI polling loop until the runner's 180 s wall
// timeout. Successful A5 writes complete orders of magnitude below this
// bound; the established baseline keeps its larger diagnostic bound.
constexpr uint32_t kMaxCqPolls = 20000U;
// A5 GetSystemCycle is a 1 GHz device clock. This eager Put setup/seed path
// tolerates at most another 100 ms after the original fast budget. The hard
// poll cap is independent of the clock so a stalled clock cannot hang setup.
// Neither bound is a bandwidth/performance measurement or a retry of WQEs.
constexpr uint64_t kSlowCqDeadlineTicks = 100000000ULL;
constexpr uint32_t kMaxSlowCqPolls = 1000000U;
constexpr uint64_t kCacheLineBytes = 64U;

constexpr uint64_t kSuccess = KVAF_BATCH_PUT_CORE_SUCCESS;
constexpr uint64_t kInvalidEntity = KVAF_BATCH_PUT_CORE_INVALID_ENTITY;
constexpr uint64_t kInvalidQueue = KVAF_BATCH_PUT_CORE_INVALID_QUEUE;
constexpr uint64_t kQueueFull = KVAF_BATCH_PUT_CORE_QUEUE_FULL;
constexpr uint64_t kCqTimeout = KVAF_BATCH_PUT_CORE_CQ_TIMEOUT;
constexpr uint64_t kCqError = KVAF_BATCH_PUT_CORE_CQ_ERROR;

__aicore__ inline void CleanCacheLines(__gm__ uint8_t *address, uint64_t bytes) {
  if (address == nullptr || bytes == 0U) {
    return;
  }
  const uint64_t first = reinterpret_cast<uint64_t>(address) & ~(kCacheLineBytes - 1U);
  const uint64_t last = (reinterpret_cast<uint64_t>(address) + bytes - 1U) & ~(kCacheLineBytes - 1U);
  GlobalTensor<uint8_t> global;
  global.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(first));
  for (uint64_t offset = 0U; offset <= last - first; offset += kCacheLineBytes) {
    DataCacheCleanAndInvalid<uint8_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(global[offset]);
  }
}

__aicore__ inline uint32_t WqeControl(bool completion, uint32_t owner) {
  const uint32_t place_order = completion ? 0x2U : 0x1U;
  return (place_order << 16U) | (1U << 18U) | (1U << 20U) |
         (static_cast<uint32_t>(completion) << 21U) | (1U << 28U) |
         (1U << 29U) | ((owner & 1U) << 31U);
}

// CANN 9.1 PTO UrmaPostSend uses scalar GM SQE/SGE stores followed by
// DCCI and PIPE_ALL before st_dev. Initialization is outside Get timing;
// use that conservative path and verify the actual SQ bytes before posting.
__aicore__ inline void BuildBatchPutWqeWords(
    __gm__ const KvafBatchPutDirectUrmaEntity *entity,
    uint64_t input_offset, uint64_t length, uint64_t destination,
    uint64_t head, bool completion, uint32_t *words) {
  for (uint32_t word = 0U; word < kWqeBytes / sizeof(uint32_t); ++word) {
    words[word] = 0U;
  }
  const uint32_t owner = 1U - static_cast<uint32_t>((head / entity->sq_depth) & 1U);
  const uint64_t local = entity->local_hbm_address + input_offset;
  const uint64_t eid_low =
      *reinterpret_cast<__gm__ const uint64_t *>(entity->remote_eid);
  const uint64_t eid_high =
      *reinterpret_cast<__gm__ const uint64_t *>(entity->remote_eid + 8U);
  // CANN 9.1 PTO FillSqeCtx sets sqeBbIdx to curHead % depth (64B WQEBB).
  // It is independent of the owner bit and must advance for every WQE.
  words[0] = WqeControl(completion, owner) |
      static_cast<uint32_t>((head % entity->sq_depth) & 0xffffU);
  words[1] = kWriteOpcode << 8U;
  words[2] = (entity->tp_id & 0x00ffffffU) | 0x01000000U;
  words[3] = entity->remote_token_id & 0x000fffffU;
  words[4] = static_cast<uint32_t>(eid_low);
  words[5] = static_cast<uint32_t>(eid_low >> 32U);
  words[6] = static_cast<uint32_t>(eid_high);
  words[7] = static_cast<uint32_t>(eid_high >> 32U);
  words[8] = entity->remote_token_value;
  words[10] = static_cast<uint32_t>(destination);
  words[11] = static_cast<uint32_t>(destination >> 32U);
  words[12] = static_cast<uint32_t>(length);
  words[13] = entity->local_token_id;
  words[14] = static_cast<uint32_t>(local);
  words[15] = static_cast<uint32_t>(local >> 32U);
}

__aicore__ inline __gm__ volatile uint32_t *BatchPutSqWords(
    __gm__ const KvafBatchPutDirectUrmaEntity *entity, uint64_t head) {
  return reinterpret_cast<__gm__ volatile uint32_t *>(
      entity->sq_va + (head % entity->sq_depth) * kWqeBytes);
}

__aicore__ inline void PublishBatchPutSqLine(__gm__ volatile uint32_t *sq) {
  __asm__ __volatile__("" ::: "memory");
  PipeBarrier<PIPE_ALL>();
  CleanCacheLines(reinterpret_cast<__gm__ uint8_t *>(
                      const_cast<__gm__ uint32_t *>(sq)), kWqeBytes);
  DataSyncBarrier<MemDsbT::DDR>();
  PipeBarrier<PIPE_ALL>();
  __asm__ __volatile__("" ::: "memory");
}

__aicore__ inline bool VerifyBatchPutSqWords(
    __gm__ volatile uint32_t *sq, const uint32_t *expected,
    __gm__ uint64_t *diagnostic, uint32_t request_offset, bool owner_valid) {
  for (uint32_t word = 0U; word < kWqeBytes / sizeof(uint32_t); ++word) {
    const uint32_t wanted = expected[word] ^
        ((word == 0U && !owner_valid) ? 0x80000000U : 0U);
    __asm__ __volatile__("" ::: "memory");
    const uint32_t actual = sq[word];
    __asm__ __volatile__("" ::: "memory");
    if (actual != wanted) {
      diagnostic[KVAF_BATCH_PUT_SQ_DIAG_MISMATCH_WORD] =
          static_cast<uint64_t>(request_offset) * 16U + word + 1U;
      return false;
    }
  }
  return true;
}

__aicore__ inline uint64_t PostBatchPutRequests(
    __gm__ const uint64_t *input_offsets, __gm__ const uint64_t *lengths,
    __gm__ const uint64_t *destination_addresses, uint32_t request_begin,
    uint32_t active_count, uint32_t jettys_per_core,
    __gm__ const KvafBatchPutDirectUrmaEntity *entities,
    __gm__ KvafBatchPutQueueState *queues,
    __gm__ KvafBatchPutCoreStatus *status, uint64_t *last_wqe,
    uint64_t *failed_request) {
  status->reserved[KVAF_BATCH_PUT_SQ_DIAGNOSTIC_MAGIC_WORD] =
      KVAF_BATCH_PUT_SQ_DIAGNOSTIC_MAGIC;
  for (uint32_t word = 0U; word < 8U; ++word) status->reserved[word] = 0U;
  const uint32_t total_posts =
      (active_count + kWqesPerPost - 1U) / kWqesPerPost;
  uint32_t words[kWqeBytes / sizeof(uint32_t)];
  for (uint32_t post = 0U; post < total_posts; ++post) {
    const uint32_t jetty = post % jettys_per_core;
    const auto *entity = entities + jetty;
    auto *queue = queues + jetty;
    auto *diagnostic = status->reserved + jetty * KVAF_BATCH_PUT_SQ_DIAGNOSTIC_WORDS;
    const uint64_t head = queue->sq_producer_index;
    const uint32_t offset = post * kWqesPerPost;
    const uint32_t count = active_count - offset < kWqesPerPost ?
        active_count - offset : kWqesPerPost;
    const bool completion = post + jettys_per_core >= total_posts;
    // Retain the old owner until every payload word has reached GM. A
    // subsequent pass verifies all sixteen words before owners become valid.
    for (uint32_t row = 0U; row < count; ++row) {
      const uint32_t request = request_begin + offset + row;
      BuildBatchPutWqeWords(entity, input_offsets[request], lengths[request],
          destination_addresses[request], head + row, completion && row + 1U == count, words);
      auto *sq = BatchPutSqWords(entity, head + row);
      sq[0] = words[0] ^ 0x80000000U;
      for (uint32_t word = 1U; word < 16U; ++word) sq[word] = words[word];
      PublishBatchPutSqLine(sq);
      if (!VerifyBatchPutSqWords(sq, words, diagnostic, offset + row, false)) {
        *failed_request = request;
        return KVAF_BATCH_PUT_CORE_SQ_PUBLICATION_ERROR;
      }
    }
    // Publish owners backwards, so the first WQE cannot precede the rest of
    // its batch. No doorbell is issued until the complete batch is read back.
    for (uint32_t remaining = count; remaining != 0U; --remaining) {
      const uint32_t row = remaining - 1U;
      const uint32_t request = request_begin + offset + row;
      BuildBatchPutWqeWords(entity, input_offsets[request], lengths[request],
          destination_addresses[request], head + row, completion && row + 1U == count, words);
      auto *sq = BatchPutSqWords(entity, head + row);
      sq[0] = words[0];
      PublishBatchPutSqLine(sq);
    }
    for (uint32_t row = 0U; row < count; ++row) {
      const uint32_t request = request_begin + offset + row;
      BuildBatchPutWqeWords(entity, input_offsets[request], lengths[request],
          destination_addresses[request], head + row, completion && row + 1U == count, words);
      auto *sq = BatchPutSqWords(entity, head + row);
      if (row == 0U) diagnostic[KVAF_BATCH_PUT_SQ_DIAG_FIRST_CONTROL] = sq[0];
      if (row + 1U == count) {
        diagnostic[KVAF_BATCH_PUT_SQ_DIAG_LAST_CONTROL] = sq[0];
        *last_wqe = sq[0];
      }
      if (!VerifyBatchPutSqWords(sq, words, diagnostic, offset + row, true)) {
        *failed_request = request;
        return KVAF_BATCH_PUT_CORE_SQ_PUBLICATION_ERROR;
      }
    }
    queue->sq_producer_index = head + count;
    __asm__ __volatile__("" ::: "memory");
    CleanCacheLines(reinterpret_cast<__gm__ uint8_t *>(queue), sizeof(*queue));
    DataSyncBarrier<MemDsbT::DDR>();
    __asm__ __volatile__("" ::: "memory");
    const uint64_t published =
        *reinterpret_cast<__gm__ const volatile uint64_t *>(&queue->sq_producer_index);
    __asm__ __volatile__("" ::: "memory");
    if (published != head + count) {
      diagnostic[KVAF_BATCH_PUT_SQ_DIAG_MISMATCH_WORD] = UINT64_MAX;
      return KVAF_BATCH_PUT_CORE_SQ_PUBLICATION_ERROR;
    }
    st_dev(static_cast<uint32_t>(published),
        reinterpret_cast<__gm__ uint32_t *>(entity->sq_db_va), 0);
    diagnostic[KVAF_BATCH_PUT_SQ_DIAG_PUBLISHED_PI] = published;
  }
  return kSuccess;
}

__aicore__ inline uint32_t BatchPutRequestsForJetty(
    uint32_t active_count, uint32_t jetty, uint32_t jettys_per_core) {
  const uint32_t total_posts =
      (active_count + kWqesPerPost - 1U) / kWqesPerPost;
  uint32_t assigned = 0U;
  for (uint32_t post = jetty; post < total_posts;
       post += jettys_per_core) {
    const uint32_t request_offset = post * kWqesPerPost;
    uint32_t wqe_count = active_count - request_offset;
    if (wqe_count > kWqesPerPost) {
      wqe_count = kWqesPerPost;
    }
    assigned += wqe_count;
  }
  return assigned;
}

__aicore__ inline void WriteStatus(__gm__ KvafBatchPutCoreStatus *status, uint64_t result,
                                   uint64_t processed, uint64_t completed, uint64_t sq_pi,
                                   uint64_t cq_ci, uint64_t failed_request, uint64_t last_wqe,
                                   uint64_t cq_status, uint64_t cq_sub_status) {
  status->magic = KVAF_AIV_BATCH_PUT_STATUS_MAGIC;
  status->processed_request_count = processed;
  status->result = result;
  status->completed_batch_count = completed;
  status->sq_producer_index = sq_pi;
  status->cq_consumer_index = cq_ci;
  status->failed_request_index = failed_request;
  status->last_wqe_protocol = last_wqe;
  status->cq_status = cq_status;
  status->cq_sub_status = cq_sub_status;
}

__aicore__ inline uint64_t WaitForCompletion(const __gm__ KvafBatchPutDirectUrmaEntity *entity,
                                             __gm__ KvafBatchPutQueueState *queue,
                                             __gm__ KvafBatchPutCoreStatus *status,
                                             uint32_t jetty, uint32_t assigned_rows) {
  const uint32_t slot = static_cast<uint32_t>(queue->cq_consumer_index % entity->cq_depth);
  __gm__ uint8_t *const cqe_address = reinterpret_cast<__gm__ uint8_t *>(entity->cq_va) +
                                      static_cast<uint64_t>(slot) * entity->cqe_size;
  const uint64_t started = static_cast<uint64_t>(AscendC::GetSystemCycle());
  const uint64_t sq_before = queue->sq_producer_index;
  const uint64_t cq_before = queue->cq_consumer_index;
  const uint8_t expected = static_cast<uint8_t>((cq_before / entity->cq_depth) & 1U);
  uint32_t cqe_word = 0U;
  uint64_t polls = 0U;
  uint64_t completion = kCqTimeout;
  uint64_t slow_started = 0U;
  uint64_t slow_elapsed = 0U;
  uint64_t timeout_reason = KVAF_BATCH_PUT_CQ_TIMEOUT_NONE;
  bool fast_budget_exceeded = false;
  for (uint32_t poll = 0U; poll < kMaxCqPolls; ++poll) {
    CleanCacheLines(cqe_address, kCqeProbeBytes);
    // CQEs are written by UDMA. DCCI maintains hardware cache visibility;
    // volatile and compiler barriers require a fresh CQ read on every poll.
    __asm__ __volatile__("" ::: "memory");
    cqe_word =
        *reinterpret_cast<__gm__ const volatile uint32_t *>(cqe_address);
    __asm__ __volatile__("" ::: "memory");
    ++polls;
    const uint8_t owner = static_cast<uint8_t>((cqe_word >> 2U) & 1U);
    if ((owner ^ expected) == 0U) {
      continue;
    }
    const uint8_t sub_status = static_cast<uint8_t>((cqe_word >> 16U) & 0xffU);
    const uint8_t status = static_cast<uint8_t>((cqe_word >> 24U) & 0xffU);
    ++queue->cq_consumer_index;
    st_dev(static_cast<uint32_t>(queue->cq_consumer_index) & kCqConsumerMask,
           reinterpret_cast<__gm__ uint32_t *>(entity->cq_db_va), 0);
    const uint64_t result = status == 0U && sub_status == 0U ? kSuccess : kCqError;
    completion = result | (static_cast<uint64_t>(status) << 8U) |
           (static_cast<uint64_t>(sub_status) << 16U);
    break;
  }
  if (completion == kCqTimeout) {
    fast_budget_exceeded = true;
    slow_started = static_cast<uint64_t>(AscendC::GetSystemCycle());
    for (uint32_t poll = 0U; poll < kMaxSlowCqPolls; ++poll) {
      slow_elapsed = static_cast<uint64_t>(AscendC::GetSystemCycle()) - slow_started;
      if (slow_elapsed >= kSlowCqDeadlineTicks) {
        timeout_reason = KVAF_BATCH_PUT_CQ_TIMEOUT_DEVICE_DEADLINE;
        break;
      }
      CleanCacheLines(cqe_address, kCqeProbeBytes);
      __asm__ __volatile__("" ::: "memory");
      cqe_word = *reinterpret_cast<__gm__ const volatile uint32_t *>(cqe_address);
      __asm__ __volatile__("" ::: "memory");
      ++polls;
      const uint8_t owner = static_cast<uint8_t>((cqe_word >> 2U) & 1U);
      if ((owner ^ expected) == 0U) {
        continue;
      }
      const uint8_t sub_status = static_cast<uint8_t>((cqe_word >> 16U) & 0xffU);
      const uint8_t cq_status = static_cast<uint8_t>((cqe_word >> 24U) & 0xffU);
      ++queue->cq_consumer_index;
      st_dev(static_cast<uint32_t>(queue->cq_consumer_index) & kCqConsumerMask,
             reinterpret_cast<__gm__ uint32_t *>(entity->cq_db_va), 0);
      const uint64_t result = cq_status == 0U && sub_status == 0U ? kSuccess : kCqError;
      completion = result | (static_cast<uint64_t>(cq_status) << 8U) |
                   (static_cast<uint64_t>(sub_status) << 16U);
      break;
    }
    slow_elapsed = static_cast<uint64_t>(AscendC::GetSystemCycle()) - slow_started;
    if (completion == kCqTimeout && timeout_reason == KVAF_BATCH_PUT_CQ_TIMEOUT_NONE) {
      timeout_reason = KVAF_BATCH_PUT_CQ_TIMEOUT_POLL_FALLBACK;
    }
  }
  // Keep the legacy aggregate (jetty0) fields for ABI compatibility, but
  // record the actual queue responsible for a timeout/error separately.
  __gm__ uint64_t *const diagnostic = status->reserved +
      KVAF_BATCH_PUT_CQ_DIAGNOSTIC_BASE_WORD +
      jetty * KVAF_BATCH_PUT_CQ_DIAGNOSTIC_WORDS_PER_JETTY;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_RESULT] = completion & 0xffU;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_POLLS] = polls;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_ELAPSED_TICKS] =
      static_cast<uint64_t>(AscendC::GetSystemCycle()) - started;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_RAW_WORD] = cqe_word;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_EXPECTED_OWNER] = expected;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_TIMEOUT_REASON] = timeout_reason;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_SQ_BEFORE] = sq_before;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_CQ_BEFORE] = cq_before;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_SQ_AFTER] = queue->sq_producer_index;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_CQ_AFTER] = queue->cq_consumer_index;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_ASSIGNED_ROWS] = assigned_rows;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_FAST_BUDGET_EXCEEDED] = fast_budget_exceeded;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_OBSERVED_OWNER] = (cqe_word >> 2U) & 1U;
  diagnostic[KVAF_BATCH_PUT_CQ_DIAG_SLOW_ELAPSED_TICKS] = slow_elapsed;
  status->reserved[KVAF_BATCH_PUT_CQ_DIAGNOSTIC_MAGIC_WORD] =
      KVAF_BATCH_PUT_CQ_DIAGNOSTIC_MAGIC;
  return completion;
}

}  // namespace

extern "C" __global__ __aicore__ void KvafExecuteBatchPutAivKernel(KvafExecuteBatchPutLaunchArgs args) {
  const uint32_t core = GetBlockIdx();
  const KvafExecuteBatchPutKernelArgs &request_args = args.request;
  const uint32_t jettys_per_core =
      args.jettys_per_core == 0U ? 1U : args.jettys_per_core;
  if (request_args.aiv_core_count == 0U || core >= request_args.aiv_core_count ||
      request_args.aiv_core_count > KVAF_AIV_BATCH_PUT_MAX_AIV_CORES ||
      jettys_per_core > KVAF_AIV_BATCH_PUT_MAX_JETTYS_PER_CORE ||
      request_args.input == 0U || request_args.input_offsets == 0U || request_args.lengths == 0U ||
      request_args.destination_addresses == 0U || request_args.core_status == 0U ||
      request_args.input_bytes == 0U || request_args.row_count == 0U ||
      args.channel_entity == 0U || args.queue_state == 0U) {
    return;
  }

  __gm__ KvafBatchPutCoreStatus *const status =
      reinterpret_cast<__gm__ KvafBatchPutCoreStatus *>(request_args.core_status) + core;
  __gm__ KvafBatchPutQueueState *const queues =
      reinterpret_cast<__gm__ KvafBatchPutQueueState *>(args.queue_state) +
      static_cast<uint64_t>(core) * jettys_per_core;
  __gm__ const KvafBatchPutDirectUrmaEntity *const entities =
      reinterpret_cast<__gm__ const KvafBatchPutDirectUrmaEntity *>(args.channel_entity) +
      static_cast<uint64_t>(core) * jettys_per_core;
  uint64_t result = kSuccess;
  uint64_t failed_request = UINT64_MAX;
  uint64_t active_count = 0U;
  uint64_t last_wqe = 0U;
  uint64_t cq_status = 0U;
  uint64_t cq_sub_status = 0U;
  const uint32_t begin = static_cast<uint32_t>((static_cast<uint64_t>(request_args.row_count) * core) /
                                                request_args.aiv_core_count);
  const uint32_t end = static_cast<uint32_t>((static_cast<uint64_t>(request_args.row_count) * (core + 1U)) /
                                              request_args.aiv_core_count);

  for (uint32_t jetty = 0U; jetty < jettys_per_core; ++jetty) {
    __gm__ const KvafBatchPutDirectUrmaEntity *const entity =
        entities + jetty;
    if (entity->magic != kEntityMagic || entity->version != kEntityVersion ||
        entity->local_hbm_address != request_args.input || entity->local_hbm_size < request_args.input_bytes ||
        entity->local_token_id == 0U || entity->local_token_value == 0U ||
        entity->remote_host_ddr_address == 0U || entity->remote_host_ddr_size == 0U ||
        entity->remote_token_id == 0U || entity->remote_token_value == 0U ||
        entity->sq_va == 0U || entity->sq_db_va == 0U || entity->sq_depth < 2U ||
        entity->wqe_size != kWqeBytes || entity->cq_va == 0U || entity->cq_db_va == 0U ||
        entity->cq_depth == 0U || entity->cqe_size < kCqeProbeBytes ||
        (jetty != 0U &&
         (entity->local_hbm_address != entities[0].local_hbm_address ||
          entity->local_hbm_size != entities[0].local_hbm_size ||
          entity->local_token_id != entities[0].local_token_id ||
          entity->local_token_value != entities[0].local_token_value ||
          entity->remote_host_ddr_address !=
              entities[0].remote_host_ddr_address ||
          entity->remote_host_ddr_size != entities[0].remote_host_ddr_size ||
          entity->remote_token_id != entities[0].remote_token_id ||
          entity->remote_token_value != entities[0].remote_token_value))) {
      result = kInvalidEntity;
    }
  }
  for (uint32_t jetty = 0U;
       result == kSuccess && jetty < jettys_per_core; ++jetty) {
    __gm__ KvafBatchPutQueueState *const queue = queues + jetty;
    if (queue->initialized != 0U && queue->magic != kQueueMagic) {
      result = kInvalidQueue;
    }
    if (result == kSuccess && queue->initialized == 0U) {
      queue->magic = kQueueMagic;
      queue->initialized = 1U;
      queue->sq_producer_index = 0U;
      queue->cq_consumer_index = 0U;
      queue->completed_batch_count = 0U;
      queue->last_error = 0U;
    }
  }

  __gm__ const uint64_t *const input_offsets =
      reinterpret_cast<__gm__ const uint64_t *>(request_args.input_offsets);
  __gm__ const uint64_t *const lengths = reinterpret_cast<__gm__ const uint64_t *>(request_args.lengths);
  __gm__ const uint64_t *const destination_addresses =
      reinterpret_cast<__gm__ const uint64_t *>(request_args.destination_addresses);

  if (result == kSuccess) {
    active_count = end - begin;
  }
  if (result == kSuccess && active_count != 0U) {
    for (uint32_t jetty = 0U;
         result == kSuccess && jetty < jettys_per_core; ++jetty) {
      if (BatchPutRequestsForJetty(static_cast<uint32_t>(active_count),
                                   jetty, jettys_per_core) >=
          entities[jetty].sq_depth) {
        result = kQueueFull;
      }
    }
  }
  if (result == kSuccess && active_count != 0U) {
    result = PostBatchPutRequests(input_offsets, lengths, destination_addresses, begin,
                         static_cast<uint32_t>(active_count), jettys_per_core,
                         entities, queues, status, &last_wqe, &failed_request);
  }

  if (result == kSuccess && active_count != 0U) {
    const uint32_t total_posts =
        (static_cast<uint32_t>(active_count) + kWqesPerPost - 1U) /
        kWqesPerPost;
    const uint32_t used_jettys =
        total_posts < jettys_per_core ? total_posts : jettys_per_core;
    for (uint32_t jetty = 0U; jetty < used_jettys; ++jetty) {
      const uint64_t completion =
          WaitForCompletion(entities + jetty, queues + jetty, status, jetty,
              BatchPutRequestsForJetty(static_cast<uint32_t>(active_count),
                                       jetty, jettys_per_core));
      const uint64_t completion_result = completion & 0xffU;
      if (result == kSuccess && completion_result != kSuccess) {
        result = completion_result;
        cq_status = (completion >> 8U) & 0xffU;
        cq_sub_status = (completion >> 16U) & 0xffU;
      }
    }
    if (result == kSuccess) {
      for (uint32_t jetty = 0U; jetty < used_jettys; ++jetty) {
        ++queues[jetty].completed_batch_count;
      }
    }
  }
  for (uint32_t jetty = 0U; jetty < jettys_per_core; ++jetty) {
    queues[jetty].last_error = result;
  }
  WriteStatus(status, result, active_count, queues[0].completed_batch_count,
              queues[0].sq_producer_index, queues[0].cq_consumer_index,
              failed_request, last_wqe, cq_status, cq_sub_status);
}

static const struct FunLevelKType KvafExecuteBatchPutAivKernel_kernel_type_section __attribute__(
    (used, section(".ascend.meta.KvafExecuteBatchPutAivKernel"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
