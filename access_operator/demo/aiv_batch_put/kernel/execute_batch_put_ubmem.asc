#include "ubmem/copy.h"
using namespace kvaf::ubmem;

extern "C" __global__ __aicore__ void KvafExecuteBatchPutUbmemKernelV2(BatchArgs a) {
  const uint32_t core = AscendC::GetBlockIdx();
  uint64_t completed = 0;
  MteCopyPipeline copy(kMteBufferBytes / 2);
  // RuntimeCore validated input ranges and allocated every destination.
  for (uint64_t row = static_cast<uint64_t>(a.capacity) * core / a.blocks;
       row < static_cast<uint64_t>(a.capacity) * (core + 1) / a.blocks; ++row) {
    const uint64_t offset = reinterpret_cast<__gm__ const uint64_t*>(a.put_offsets)[row];
    const uint64_t bytes = reinterpret_cast<__gm__ const uint64_t*>(a.put_lengths)[row];
    const uint64_t remote = reinterpret_cast<__gm__ const uint64_t*>(a.put_destinations)[row];
    copy.Copy(a.mapped_base + (remote - a.remote_base), a.local_base + offset, bytes);
    ++completed;
  }
  copy.Finish();
  auto* status = reinterpret_cast<__gm__ CoreStatus*>(a.statuses) + core;
  status->result = 0;
  status->failed_request = UINT64_MAX;
  status->completed = completed;
}
static const struct FunLevelKType KvafExecuteBatchPutUbmemKernelV2_type __attribute__(
    (used, section(".ascend.meta.KvafExecuteBatchPutUbmemKernelV2"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
