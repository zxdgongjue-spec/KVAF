#include "kernel_operator.h"
#include "ubmem/batch_abi.h"

using namespace kvaf::ubmem;
namespace {
constexpr uint32_t kThreads = 128;

__simt_vf__ __aicore__ LAUNCH_BOUND(128)
inline void CopyBytes(__gm__ uint8_t* dst, __gm__ const uint8_t* src, uint64_t bytes) {
  if (((reinterpret_cast<uint64_t>(dst) | reinterpret_cast<uint64_t>(src)) & 7U) == 0) {
    auto* d = reinterpret_cast<__gm__ volatile uint64_t*>(dst);
    auto* s = reinterpret_cast<__gm__ const volatile uint64_t*>(src);
    for (uint64_t i = threadIdx.x; i < bytes / 8; i += kThreads) d[i] = s[i];
    for (uint64_t i = bytes / 8 * 8 + threadIdx.x; i < bytes; i += kThreads) dst[i] = src[i];
  } else {
    for (uint64_t i = threadIdx.x; i < bytes; i += kThreads) dst[i] = src[i];
  }
}

__aicore__ inline bool Within(uint64_t address, uint64_t bytes, uint64_t base, uint64_t size) {
  return address >= base && bytes <= size && address - base <= size - bytes;
}

// Returns addresses only after checking the complete source/destination range.
__aicore__ inline uint64_t ResolveRow(const BatchArgs& a, uint32_t row,
                                     uint64_t* src, uint64_t* dst, uint64_t* bytes) {
  uint64_t remote;
  if (a.operation == Operation::kPut) {
    const auto offset = reinterpret_cast<__gm__ const uint64_t*>(a.put_offsets)[row];
    *bytes = reinterpret_cast<__gm__ const uint64_t*>(a.put_lengths)[row];
    remote = reinterpret_cast<__gm__ const uint64_t*>(a.put_destinations)[row];
    if (*bytes == 0 || offset > a.local_bytes || *bytes > a.local_bytes - offset) return 3;
    *src = a.local_base + offset;
  } else {
    const auto index = reinterpret_cast<__gm__ const int32_t*>(a.indices)[row];
    const auto offset = reinterpret_cast<__gm__ const int32_t*>(a.offsets)[row];
    const auto output = reinterpret_cast<__gm__ const int32_t*>(a.output_indices)[row];
    if (index < 0 || static_cast<uint32_t>(index) >= a.table_entries ||
        reinterpret_cast<__gm__ const uint8_t*>(a.valid)[index] == 0) return 2;
    const uint64_t block_bytes = static_cast<uint64_t>(a.token_bytes) * a.tokens_per_block;
    const auto base = reinterpret_cast<__gm__ const uint64_t*>(a.addresses)[index];
    if (offset < 0 || static_cast<uint64_t>(offset) > block_bytes - a.token_bytes ||
        !Within(base, block_bytes, a.remote_base, a.remote_bytes)) return 2;
    *bytes = a.token_bytes;
    if (output < 0 || a.local_bytes < *bytes ||
        static_cast<uint64_t>(output) > (a.local_bytes - *bytes) / *bytes) return 3;
    remote = base + offset;
    *dst = a.local_base + static_cast<uint64_t>(output) * *bytes;
  }
  if (!Within(remote, *bytes, a.remote_base, a.remote_bytes)) return 2;
  const uint64_t mapped = a.mapped_base + (remote - a.remote_base);
  if (a.operation == Operation::kPut) *dst = mapped;
  else *src = mapped;
  return 0;
}
}  // namespace

extern "C" __global__ __aicore__ void KvafUbmemBatchKernel(BatchArgs a) {
  const uint32_t core = AscendC::GetBlockIdx();
  if (a.statuses == 0 || core >= a.blocks) return;
  auto* status = reinterpret_cast<__gm__ CoreStatus*>(a.statuses) + core;
  status->magic = kBatchMagic;
  status->result = 1;
  status->failed_request = UINT64_MAX;
  status->completed = 0;
  // The mapped-memory path uses the same pipeline/cache drain as SHMEM quiet.
  AscendC::PipeBarrier<PIPE_ALL>();
  dcci_entire_cache();
  uint64_t count = a.capacity;
  bool valid = a.magic == kBatchMagic && a.blocks != 0 && a.local_base != 0 &&
      a.local_bytes != 0 && a.remote_base != 0 && a.mapped_base != 0 && a.remote_bytes != 0 &&
      a.remote_base <= UINT64_MAX - a.remote_bytes && a.mapped_base <= UINT64_MAX - a.remote_bytes &&
      a.local_base <= UINT64_MAX - a.local_bytes;
  if (a.operation == Operation::kGet) {
    valid = valid && a.miss_count && a.indices && a.offsets && a.output_indices && a.addresses && a.valid &&
        a.token_bytes && a.tokens_per_block && a.table_entries;
    const int32_t active = valid ? *reinterpret_cast<__gm__ const int32_t*>(a.miss_count) : -1;
    valid = valid && active >= 0 && static_cast<uint32_t>(active) <= a.capacity;
    count = valid ? static_cast<uint32_t>(active) : 0;
  } else {
    valid = valid && a.operation == Operation::kPut && a.put_offsets && a.put_lengths && a.put_destinations;
  }
  if (valid) {
    status->result = 0;
    for (uint64_t row = core; row < count; row += a.blocks) {
      uint64_t src, dst, bytes;
      const auto error = ResolveRow(a, row, &src, &dst, &bytes);
      if (error != 0) { status->result = error; status->failed_request = row; break; }
    }
    if (status->result == 0) {
      for (uint64_t row = core; row < count; row += a.blocks) {
        uint64_t src, dst, bytes;
        ResolveRow(a, row, &src, &dst, &bytes);
        AscendC::Simt::VF_CALL<CopyBytes>(AscendC::Simt::Dim3{kThreads, 1, 1},
            reinterpret_cast<__gm__ uint8_t*>(dst), reinterpret_cast<__gm__ const uint8_t*>(src), bytes);
        ++status->completed;
      }
    }
  }
  AscendC::PipeBarrier<PIPE_ALL>();
  dcci_entire_cache();
}

static const struct FunLevelKType KvafUbmemBatchKernel_kernel_type_section __attribute__(
    (used, section(".ascend.meta.KvafUbmemBatchKernel"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
