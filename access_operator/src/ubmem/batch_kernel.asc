#include "kernel_operator.h"
#include "ubmem/batch_abi.h"

using namespace kvaf::ubmem;
namespace {
// SHMEM's SIMT GM-to-GM path: each lane owns disjoint bytes. Byte accesses
// cover unaligned rows and tails without requiring wider-load alignment.
__simt_vf__ __aicore__ LAUNCH_BOUND(128)
inline void CopyBytesSimt(__gm__ uint8_t* dst, __gm__ const uint8_t* src, uint64_t bytes) {
  for (uint64_t i = threadIdx.x; i < bytes; i += kSimtThreads) dst[i] = src[i];
}

// SHMEM's Host-DDR MTE path: DataCopyPad GM -> UB -> GM, with byte-sized
// blockLen. UB padding stays local; only the requested bytes reach dst.
__aicore__ inline void CopyBytes(__gm__ uint8_t* dst, __gm__ uint8_t* src, uint64_t bytes) {
  AscendC::LocalTensor<uint8_t> buffer;
  buffer.address_.logicPos = static_cast<uint8_t>(AscendC::TPosition::VECIN);
  buffer.address_.bufferAddr = 0;  // Per-core UB reserved by the host launch.
  buffer.address_.dataLen = kMteBufferBytes;
  AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(0);
  AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(0);
  for (uint64_t offset = 0; offset < bytes;) {
    const uint32_t chunk = static_cast<uint32_t>(
        bytes - offset < kMteBufferBytes ? bytes - offset : kMteBufferBytes);
    AscendC::GlobalTensor<uint8_t> source, destination;
    source.SetGlobalBuffer(src + offset);
    destination.SetGlobalBuffer(dst + offset);
    AscendC::DataCopyExtParams copy(1, chunk, 0, 0, 0);
    AscendC::DataCopyPadExtParams<uint8_t> padding{false, 0, 0, 0};
    AscendC::DataCopyPad(buffer, source, copy, padding);
    // MTE3 must not consume UB before MTE2 has filled it.
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(0);
    AscendC::DataCopyPad(destination, buffer, copy);
    offset += chunk;
    if (offset < bytes) {
      // Finish reading the current UB chunk before overwriting it.
      AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(0);
    }
  }
  // As in mte_perftest: finish the row before reporting it or reusing UB.
  AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(0);
}

__aicore__ inline bool Within(uint64_t address, uint64_t bytes, uint64_t base, uint64_t size) {
  return address >= base && bytes <= size && address - base <= size - bytes;
}

// Put metadata is produced by RuntimeCore/MetaManager. Get metadata comes
// from device buffers; only those values need validation here.
__aicore__ inline uint64_t ResolveRow(const BatchArgs& a, uint32_t row,
                                     uint64_t* src, uint64_t* dst, uint64_t* bytes) {
  uint64_t remote;
  if (a.operation == Operation::kPut) {
    const auto offset = reinterpret_cast<__gm__ const uint64_t*>(a.put_offsets)[row];
    *bytes = reinterpret_cast<__gm__ const uint64_t*>(a.put_lengths)[row];
    remote = reinterpret_cast<__gm__ const uint64_t*>(a.put_destinations)[row];
    *src = a.local_base + offset;
  } else {
    const auto index = reinterpret_cast<__gm__ const int32_t*>(a.indices)[row];
    const auto offset = reinterpret_cast<__gm__ const int32_t*>(a.offsets)[row];
    const auto output = reinterpret_cast<__gm__ const int32_t*>(a.output_indices)[row];
    if (index < 0 || static_cast<uint32_t>(index) >= a.table_entries ||
        reinterpret_cast<__gm__ const uint8_t*>(a.valid)[index] == 0) return 2;
    const uint64_t block_bytes = static_cast<uint64_t>(a.token_bytes) * a.tokens_per_block;
    const auto base = reinterpret_cast<__gm__ const uint64_t*>(a.addresses)[index];
    if (offset < 0 || static_cast<uint64_t>(offset) > block_bytes - a.token_bytes ||
        !Within(base, block_bytes, a.remote_base, a.remote_bytes)) return 2;
    *bytes = a.token_bytes;
    if (output < 0 || a.local_bytes < *bytes ||
        static_cast<uint64_t>(output) > (a.local_bytes - *bytes) / *bytes) return 3;
    remote = base + offset;
    *dst = a.local_base + static_cast<uint64_t>(output) * *bytes;
  }
  const uint64_t mapped = a.mapped_base + (remote - a.remote_base);
  if (a.operation == Operation::kPut) *dst = mapped;
  else *src = mapped;
  return 0;
}
// Both engines use the same address resolution, row assignment and reports.
// The engine is selected at compile time for each exported kernel.
template <bool UseSimt>
__aicore__ inline void RunBatch(BatchArgs a) {
  const uint32_t core = AscendC::GetBlockIdx();
  CoreStatus report{};
  report.failed_request = UINT64_MAX;
  uint64_t count = a.capacity;
  if (a.operation == Operation::kGet) {
    const int32_t active = *reinterpret_cast<__gm__ const int32_t*>(a.miss_count);
    if (active < 0 || static_cast<uint32_t>(active) > a.capacity) {
      report.result = 1;
      count = 0;
    } else {
      count = static_cast<uint32_t>(active);
    }
  }
  for (uint64_t row = core; row < count; row += a.blocks) {
    uint64_t src, dst, bytes;
    const auto error = ResolveRow(a, row, &src, &dst, &bytes);
    if (error != 0) { report.result = error; report.failed_request = row; break; }
    if constexpr (UseSimt) {
      // As in SHMEM's SIMT VSSync: publish scalar arguments before the VF,
      // then wait for vector work before reporting/reusing the row's state.
      set_flag(PIPE_S, PIPE_V, static_cast<event_t>(0));
      wait_flag(PIPE_S, PIPE_V, static_cast<event_t>(0));
      AscendC::Simt::VF_CALL<CopyBytesSimt>(AscendC::Simt::Dim3{kSimtThreads, 1, 1},
          reinterpret_cast<__gm__ uint8_t*>(dst), reinterpret_cast<__gm__ const uint8_t*>(src), bytes);
      set_flag(PIPE_V, PIPE_S, static_cast<event_t>(0));
      wait_flag(PIPE_V, PIPE_S, static_cast<event_t>(0));
    } else {
      CopyBytes(reinterpret_cast<__gm__ uint8_t*>(dst), reinterpret_cast<__gm__ uint8_t*>(src), bytes);
    }
    ++report.completed;
  }
  auto* status = reinterpret_cast<__gm__ CoreStatus*>(a.statuses) + core;
  status->result = report.result;
  status->failed_request = report.failed_request;
  status->completed = report.completed;
  status->capacity = a.capacity;
  status->blocks = a.blocks;
  status->operation = static_cast<uint32_t>(a.operation);
  // Like the existing BatchGet WriteStatus path, the host reads this report
  // after kernel completion; there is no in-kernel poller requiring DCCI.
}
}  // namespace

extern "C" __global__ __aicore__ void KvafUbmemBatchMteKernel(BatchArgs a) {
  RunBatch<false>(a);
}

extern "C" __global__ __aicore__ void KvafUbmemBatchSimtKernel(BatchArgs a) {
  RunBatch<true>(a);
}

static const struct FunLevelKType KvafUbmemBatchMteKernel_kernel_type_section __attribute__(
    (used, section(".ascend.meta.KvafUbmemBatchMteKernel"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};

static const struct FunLevelKType KvafUbmemBatchSimtKernel_kernel_type_section __attribute__(
    (used, section(".ascend.meta.KvafUbmemBatchSimtKernel"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
