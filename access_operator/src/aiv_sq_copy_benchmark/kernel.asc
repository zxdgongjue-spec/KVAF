#include "kernel_operator.h"
#include "aicpu_urma/sq_copy_benchmark.h"
#include "simt_api/device_atomic_functions.h"

using namespace AscendC;
using namespace kvaf::aicpu_urma;

namespace {

constexpr uint32_t kPatternThreads = 32U;

__simt_vf__ __aicore__ LAUNCH_BOUND(32)
inline void FillSource(__ubuf__ uint8_t* source, uint32_t bytes,
                       uint32_t worker, uint64_t round) {
  for (uint32_t index = threadIdx.x; index < bytes; index += kPatternThreads)
    source[index] = static_cast<uint8_t>(index * 131U + index / 64U * 17U + worker * 29U + round * 7U);
}

__aicore__ inline void ConfigureCopy() {
  set_loop_size_ubtoout(1U | (1ULL << 21U));
  set_loop1_stride_ubtoout(0U);
  set_loop2_stride_ubtoout(0U);
  set_atomic_none();
}

__aicore__ inline void WriteSq(__gm__ uint8_t* destination,
                                __ubuf__ uint8_t* source, uint64_t bytes) {
  const uint64_t configuration = (1ULL << 4U) | (bytes << 25U);
  copy_ubuf_to_gm_align_v2(reinterpret_cast<__gm__ float*>(destination),
      reinterpret_cast<__ubuf__ float*>(source), configuration, 0U);
}

}

extern "C" __global__ __aicore__ void KvafAivSqCopyClock(SqCopyBenchmarkArgs args) {
  if (GetBlockIdx() != 0U || args.statuses == 0U || args.round == 0U) return;
  auto* status = reinterpret_cast<__gm__ SqCopyBenchmarkStatus*>(args.statuses);
  const uint64_t begin = GetSystemCycle();
  while (GetSystemCycle() - begin < args.round) {}
  const uint64_t end = GetSystemCycle();
  status->magic = kSqCopyBenchmarkMagic;
  status->result = 0U;
  status->copy_begin_ns = begin;
  status->copy_end_ns = end;
}

extern "C" __global__ __aicore__ void KvafAivSqCopyBenchmark(SqCopyBenchmarkArgs args) {
  const uint32_t worker = GetBlockIdx();
  if (args.queues == 0U || args.statuses == 0U || args.workers == 0U ||
      args.workers > kSqCopyBenchmarkMaxWorkers || worker >= args.workers) return;
  auto* status = reinterpret_cast<__gm__ SqCopyBenchmarkStatus*>(args.statuses) + worker;
  status->magic = kSqCopyBenchmarkMagic;
  status->result = 1U;
  status->worker = worker;
  status->round = args.round;
  status->entry_ns = GetSystemCycle();
  status->thread_cpu_ns = 0U;
  status->thread_cpu_available = 0U;
  const auto* queue = reinterpret_cast<__gm__ const SqCopyBenchmarkQueue*>(args.queues) + worker;
  const uint64_t destination = (args.target_sq & 1U) != 0U ? queue->sq : queue->hbm;
  if (args.target_sq > 3U || args.copy_mode != kvaf::GatherSqCopyMode::kMemcpySp ||
      (args.batch_wqes != 8U && args.batch_wqes != 16U &&
       args.batch_wqes != 32U && args.batch_wqes != 64U) ||
      destination == 0U || destination % 64U != 0U || queue->bytes == 0U ||
      queue->bytes % 64U != 0U || queue->offset % 64U != 0U ||
      queue->capacity > kSqCopyBenchmarkQueueBytes || queue->offset > queue->capacity ||
      queue->bytes > queue->capacity - queue->offset ||
      destination > UINT64_MAX - queue->capacity ||
      (args.target_sq >= 2U && (queue->source_hbm == 0U || queue->source_hbm % 64U != 0U ||
       queue->source_hbm > UINT64_MAX - queue->bytes ||
       (queue->source_hbm < destination + queue->offset + queue->bytes &&
        destination + queue->offset < queue->source_hbm + queue->bytes)))) return;
  ConfigureCopy();
  const uint32_t chunk_bytes = args.batch_wqes * 192U;
  auto* source = reinterpret_cast<__ubuf__ uint8_t*>(get_imm(0U));
  auto* output = reinterpret_cast<__gm__ uint8_t*>(destination + queue->offset);
  if (args.target_sq < 2U) {
    Simt::VF_CALL<FillSource>(Simt::Dim3{kPatternThreads, 1U, 1U}, source, chunk_bytes,
                              worker, args.round);
    set_flag(PIPE_V, PIPE_S, EVENT_ID1);
    wait_flag(PIPE_V, PIPE_S, EVENT_ID1);
    set_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
    wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
  }
  const uint64_t begin = GetSystemCycle();
  for (uint64_t offset = 0U; offset < queue->bytes; offset += chunk_bytes) {
    const uint64_t remaining = queue->bytes - offset;
    const uint32_t bytes = remaining < chunk_bytes ? static_cast<uint32_t>(remaining) : chunk_bytes;
    if (args.target_sq >= 2U) {
      if (offset != 0U) {
        set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
        wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
      }
      copy_gm_to_ubuf_align_v2(source,
          reinterpret_cast<__gm__ uint8_t*>(queue->source_hbm + offset),
          0U, 1U, bytes, 0U, 0U, 0U, 0U, 0U, 0U);
      set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
      wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    }
    WriteSq(output + offset, source, bytes);
  }
  set_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_MTE3, PIPE_S, EVENT_ID0);
  const uint64_t end = GetSystemCycle();
  status->copy_begin_ns = begin;
  status->copy_end_ns = end;
  status->bytes = queue->bytes;
  status->copy_calls = (queue->bytes + chunk_bytes - 1U) / chunk_bytes;
  status->result = 0U;
}
