file(REMOVE_RECURSE "${OUTPUT_DIR}")
if(NOT UMDK_RUNTIME_DIR OR UMDK_RUNTIME_DIR MATCHES "-NOTFOUND$")
  return()
endif()
file(GLOB core_libraries "${UMDK_RUNTIME_DIR}/liburma.so*"
                         "${UMDK_RUNTIME_DIR}/liburma_common.so*")
file(GLOB providers "${UMDK_RUNTIME_DIR}/urma/*.so*")
foreach(library IN LISTS core_libraries providers)
  file(READ "${library}" header OFFSET 0 LIMIT 20 HEX)
  if(NOT header MATCHES "^7f454c46" OR NOT header MATCHES "(b700|00b7)$")
    message(FATAL_ERROR "AICPU UMDK runtime must be AArch64 ELF: ${library}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/urma")
foreach(library IN LISTS core_libraries)
  file(COPY "${library}" DESTINATION "${OUTPUT_DIR}" FOLLOW_SYMLINK_CHAIN)
endforeach()
foreach(library IN LISTS providers)
  file(COPY "${library}" DESTINATION "${OUTPUT_DIR}/urma" FOLLOW_SYMLINK_CHAIN)
endforeach()
