namespace kvaf::cpu_push::aiv {
using namespace AscendC;
constexpr uint32_t kThreads = 256, kRows = 4096;

__aicore__ inline void Flush(uint64_t address, uint64_t bytes) {
  if (!bytes) return;
  const auto first = address & ~uint64_t(63);
  const auto last = (address + bytes - 1) & ~uint64_t(63);
  GlobalTensor<uint8_t> gm;
  gm.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(first));
  for (uint64_t i = 0; i <= last - first; i += 64)
    DataCacheCleanAndInvalid<uint8_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(gm[i]);
}
__aicore__ inline uint64_t Load(uint64_t address) {
#ifdef KVAF_CPU_SGL_AIV_MODEL
  return sgl_model::Load(address);
#else
  Flush(address, 8);
  return *reinterpret_cast<__gm__ volatile uint64_t*>(address);
#endif
}
__aicore__ inline void Store(uint64_t address, uint64_t value) {
#ifdef KVAF_CPU_SGL_AIV_MODEL
  sgl_model::Store(address, value);
#else
  *reinterpret_cast<__gm__ volatile uint64_t*>(address) = value;
  Flush(address, 8);
#endif
}

#include "../../../cpu_sgl_push/kernel/aiv_mailbox.h"

// Adapted from origin/aiv-scatter BuildSourcesSimt: bypass private SIMT
// DCache, write compact source addresses through UB -> GM, then notify CPU.
__simt_vf__ __aicore__ LAUNCH_BOUND(256) inline void BuildSimt(
    BatchGetInput r, uint32_t first, uint32_t count,
    __ubuf__ uint64_t* sources, __ubuf__ uint32_t* failures) {
  uint32_t failed = 0;
  auto* indices = reinterpret_cast<__gm__ int32_t*>(r.indices);
  auto* offsets = reinterpret_cast<__gm__ int32_t*>(r.offsets);
  auto* rows = reinterpret_cast<__gm__ int32_t*>(r.output_indices);
  auto* addresses = reinterpret_cast<__gm__ uint64_t*>(r.address_table);
  auto* valid = reinterpret_cast<__gm__ uint8_t*>(r.valid_table);
  for (uint32_t j = threadIdx.x; j < count; j += kThreads) {
    const auto index = uint32_t(asc_ldcg(indices + first + j));
    const auto offset = uint64_t(asc_ldcg(offsets + first + j));
    if (index >= r.table_capacity || asc_ldcg(rows + first + j) != int32_t(first + j) ||
        r.block_bytes < r.token_bytes || offset > r.block_bytes - r.token_bytes) {
      failed = 1; continue;
    }
    if (valid && !asc_ldcg(valid + index)) { failed = 1; continue; }
    const auto base = asc_ldcg(addresses + index);
    if (base < r.canonical_base || r.block_bytes > r.logical_bytes ||
        base - r.canonical_base > r.logical_bytes - r.block_bytes) {
      failed = 1; continue;
    }
    sources[j] = base + offset;
  }
  failures[threadIdx.x] = failed;
}

__aicore__ bool Build(const KernelArgs& a, uint64_t descriptor, uint32_t begin, uint32_t end) {
  auto* sources = reinterpret_cast<__ubuf__ uint64_t*>(get_imm(0));
  auto* failures = reinterpret_cast<__ubuf__ uint32_t*>(get_imm(kRows * 8));
  LocalTensor<uint8_t> scratch(TPosition::VECIN, 0, kRows * 8);
  for (uint32_t first = begin; first < end; first += kRows) {
    const auto n = end - first < kRows ? end - first : kRows;
    set_flag(PIPE_S, PIPE_V, static_cast<event_t>(1));
    wait_flag(PIPE_S, PIPE_V, static_cast<event_t>(1));
    Simt::VF_CALL<BuildSimt>(Simt::Dim3{kThreads, 1U, 1U}, a.request, first, n, sources, failures);
    set_flag(PIPE_V, PIPE_S, static_cast<event_t>(1));
    wait_flag(PIPE_V, PIPE_S, static_cast<event_t>(1));
    for (uint32_t t = 0; t < kThreads; ++t) if (failures[t]) return false;
    set_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(1));
    wait_flag(PIPE_V, PIPE_MTE3, static_cast<event_t>(1));
    GlobalTensor<uint8_t> destination;
    destination.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(descriptor + uint64_t(first) * 8));
    destination.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
    const DataCopyExtParams copy{1, n * 8, 0, 0, 0};
    DataCopyPad(destination, scratch, copy);
    set_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(1));
    wait_flag(PIPE_MTE3, PIPE_S, static_cast<event_t>(1));
  }
  return true;
}

__aicore__ uint64_t Publish(const CpuSglWriteArgs& args, uint64_t sequence, uint32_t count,
                       uint32_t head, __gm__ volatile BatchGetWorkerProfile* profile, bool chunked = false, const MailboxLaunch* mailbox = nullptr) {
  const auto& a = args.execution;
  const auto& r = a.request;
  const auto output_desc = a.workspace + 192 + uint64_t(a.workers) * 64;
  // ccec's implicit struct assignment operators are local-memory-only.
  // Publish GM records with scalar stores, then flush before notify.
  auto* header = reinterpret_cast<__gm__ Request*>(a.workspace);
  header->magic = kMagic;
  header->sequence = sequence;
  header->count = count;
  header->token_bytes = r.token_bytes;
  header->workers = a.workers;
  header->mode = chunked ? kChunkedOutput : kDirectOutput;
  for (uint32_t i = 0; i < 4; ++i) header->reserved_words[i] = i == 0 ? (chunked ? kChunkRows : head) : i == 1 && chunked && mailbox && head != kChunkRows ? head : 0;
  auto* target = reinterpret_cast<__gm__ OutputTarget*>(output_desc);
  target->base = args.output_target.base;
  target->bytes = args.output_target.bytes;
  target->token_value = args.output_target.token_value;
  target->segment_bytes = args.output_target.segment_bytes;
  for (uint32_t i = 0; i < kOutputSegmentBytes; ++i)
    target->segment[i] = args.output_target.segment[i];
  Flush(a.workspace, sizeof(Request));
  Flush(output_desc, sizeof(OutputTarget));
  const volatile uint64_t notify_start = profile ? GetSystemCycle() : 0;
  Store(a.workspace + 64, sequence | (a.profile ? kProfileNotify : uint64_t(0)));
  if (profile) profile->notify_ns += GetSystemCycle() - notify_start;
  if (mailbox) {
    const auto offset = 192 + uint64_t(a.workers) * 64;
    const auto started = profile ? GetSystemCycle() : 0;
    const auto result = chunked
        ? PostChunkMailbox(*mailbox, a, offset + sizeof(OutputTarget), offset, count, 0, 0, true, false, profile)
        : PostMailbox(*mailbox, a, offset + sizeof(OutputTarget), offset, count, false, false, profile);
    if (profile) profile->notify_ns += GetSystemCycle() - started;
    return result;
  }
  return 0;
}

struct ChunkRelayIO {
  const CpuSglWriteArgs& args;
  const MailboxLaunch& mailbox;
  uint64_t sequence;
  uint32_t count;
  __gm__ volatile BatchGetWorkerProfile* profile;
  __aicore__ uint32_t HeadRows() const { return PushLaunchHeadRows(args.execution.sequence); }
  __aicore__ uint64_t Target() const { return 192 + uint64_t(args.execution.workers) * 64; }
  __aicore__ uint64_t Descriptor() const { return Target() + sizeof(OutputTarget); }
  __aicore__ uint64_t Staging() const { return (Descriptor() + uint64_t(kMaxRequests) * 8 + 63) & ~uint64_t(63); }
  __aicore__ __gm__ ChunkPushState* State() const {
    return reinterpret_cast<__gm__ ChunkPushState*>(args.execution.workspace + Staging());
  }
  __aicore__ uint64_t ProgressWord(uint32_t owner) const { return Load(args.execution.workspace + 192 + uint64_t(owner) * 64); }
  __aicore__ uint32_t Sent(uint32_t owner) const { return uint32_t(Load(reinterpret_cast<uint64_t>(&State()->sent[owner].value))); }
  __aicore__ void SetSent(uint32_t owner, uint32_t value) { Store(reinterpret_cast<uint64_t>(&State()->sent[owner].value), value); }
  __aicore__ uint32_t Pending() const { return uint32_t(Load(reinterpret_cast<uint64_t>(&State()->state.reserved[0]))); }
  __aicore__ void SetPending(uint32_t value) { Store(reinterpret_cast<uint64_t>(&State()->state.reserved[0]), value); }
  __aicore__ bool Notified() const { return Load(reinterpret_cast<uint64_t>(&State()->state.reserved[1])) != 0; }
  __aicore__ void SetNotified() { Store(reinterpret_cast<uint64_t>(&State()->state.reserved[1]), 1); }
  __aicore__ bool ErrorSent() const { return Load(reinterpret_cast<uint64_t>(&State()->state.reserved[2])) != 0; }
  __aicore__ void SetErrorSent() { Store(reinterpret_cast<uint64_t>(&State()->state.reserved[2]), 1); }
  __aicore__ uint32_t Total() const { return uint32_t(Load(reinterpret_cast<uint64_t>(&State()->state.value))); }
  __aicore__ void SetTotal(uint32_t value) { Store(reinterpret_cast<uint64_t>(&State()->state.value), value); }
  __aicore__ void Init(bool notified = false, bool head_posted = false) {
    // Publisher-private bookkeeping is initialized after the Head doorbell.
    // Write each scalar once and flush each line once before another VF_CALL;
    // do not use local/GM struct assignment or carry this state across SIMT.
    auto* state = reinterpret_cast<__gm__ volatile ChunkPushState*>(State());
    for (uint32_t w = 0; w < kMaxWorkers; ++w) state->sent[w].value = !w && head_posted ? 1 : 0;
    state->state.value = head_posted ? 1 : 0;
    state->state.reserved[0] = head_posted ? 1 : 0;
    state->state.reserved[1] = notified ? 1 : 0;
    state->state.reserved[2] = 0;
    Flush(reinterpret_cast<uint64_t>(&state->sent[0]), sizeof(state->sent) + sizeof(state->state));
  }
  __aicore__ uint64_t StartHead() {
    // Core 0 has just built chunk 0. Publish it directly, without writing and
    // re-reading its Ready line or consulting stale per-invocation bookkeeping.
    const auto result = Post(0, 0, 1, true);
    const auto started = profile ? GetSystemCycle() : 0;
    // A partial post may have reached CPU even if no tail CQE was admitted.
    Init(true, result == 0);
    Store(args.execution.workspace + 192, (sequence << 32) | 1U);
    if (profile) profile->notify_ns += GetSystemCycle() - started;
    return result;
  }
  __aicore__ uint64_t Post(uint32_t chunk, uint32_t owner, uint32_t progress, bool first) {
    // Progress() is Host-only; encode the same wire token in AIV code.
    Store(args.execution.workspace + Staging() + PushCommitOffset(chunk), (sequence << 32) | progress);
    if (first) return Publish(args, sequence, count, HeadRows(), profile, true, &mailbox);
    const auto started = profile ? GetSystemCycle() : 0;
    const auto result = PostChunkMailbox(mailbox, args.execution, Descriptor(), Target(), count, chunk, owner, false, false, profile);
    if (profile) profile->notify_ns += GetSystemCycle() - started;
    return result;
  }
  __aicore__ uint64_t Error(uint32_t owner, uint32_t error) {
    Store(reinterpret_cast<uint64_t>(&State()->commits[kPushChunkCount + owner].value), (sequence << 32) | kChunkFailed | error);
    const auto started = profile ? GetSystemCycle() : 0;
    const auto result = PostChunkMailbox(mailbox, args.execution, Descriptor(), Target(), count, 0, owner, false, true, profile);
    if (profile) profile->notify_ns += GetSystemCycle() - started;
    return result;
  }
  __aicore__ uint64_t Wait() {
    const auto started = profile ? GetSystemCycle() : 0;
    const auto result = RetireDeferredMailbox(mailbox);
    if (profile) profile->notify_ns += GetSystemCycle() - started;
    return result;
  }
};

__aicore__ uint64_t RelayChunks(const CpuSglWriteArgs& args, const MailboxLaunch& mailbox,
    uint64_t sequence, uint32_t count, __gm__ volatile BatchGetWorkerProfile* profile, bool drain = false) {
  ChunkRelayIO io{args, mailbox, sequence, count, profile};
  return drain ? DrainChunkControls(io) : RelayReadyChunks(io, count, args.execution.workers, sequence, io.HeadRows());
}

__aicore__ void Execute(CpuSglWriteArgs args, const MailboxLaunch* mailbox = nullptr) {
  auto& a = args.execution;
  const bool pipeline = (a.sequence & kPipelineLaunch) != 0;
  const bool chunked = (a.sequence & kChunkPipelineLaunch) != 0;
  const bool pushed_chunks = mailbox && chunked;
  const auto head_rows = pushed_chunks ? PushLaunchHeadRows(a.sequence) : kChunkRows;
  const uint32_t core = GetBlockIdx();
  if (!a.coordination || !a.status || !a.workers || a.workers > kMaxWorkers || core >= a.workers) return;
  // Keep completed checkpoints in per-core GM, as in aiv-scatter. In particular,
  // do not carry an address-taken local profile/entry timestamp across VF_CALL.
  auto* profile = a.profile ? reinterpret_cast<__gm__ volatile BatchGetWorkerProfile*>(a.profile) + core : nullptr;
  if (profile) {
    profile->enter_ns = GetSystemCycle(); // Raw AIV cycles, despite the shared ABI field names.
    auto* words = reinterpret_cast<__gm__ volatile uint64_t*>(profile);
    for (uint32_t i = 1; i < sizeof(*profile) / 8; ++i) words[i] = 0;
    if (mailbox) profile->head_profile_tag = kCpuSglPushHeadProfileV1;
  }
  const auto coord = a.coordination;
  const auto epoch = coord + sizeof(Coordination) + uint64_t(core) * sizeof(Word);
  const auto builder = coord + sizeof(Coordination) + uint64_t(kMaxWorkers + core) * sizeof(Word);
  const auto sequence = Load(epoch) + 1;
  Store(epoch, sequence);
  auto result = Load(coord + offsetof(Coordination, result));
  if (!result) result = Load(epoch + 8);
  uint32_t count = 0, begin = 0, end = 0;
  bool head_notified = false;
  const auto& r = a.request;
  const uint64_t output_desc = a.workspace + 192 + uint64_t(a.workers) * 64;
  const uint64_t descriptor = output_desc + sizeof(OutputTarget);
  // AIV bounds control polling, as in aiv-scatter; this is not a CPU clock.
  const uint64_t polls = uint64_t(a.timeout_ms) * 10000;
  if (!result) {
    if (sequence > UINT32_MAX) result = uint64_t(Result::kSequenceError);
    else if (!ValidPushHeadRows(head_rows) || !a.workspace || !a.output || !a.timeout_ms || !r.miss_count || !r.address_table ||
        !r.indices || !r.offsets || !r.output_indices || !r.token_bytes || r.request_capacity > kMaxRequests ||
        args.output_target.base != a.output || args.output_target.bytes != a.output_bytes)
      result = uint64_t(Result::kInvalidRequest);
    else {
      Flush(r.miss_count, 4);
      const auto active = *reinterpret_cast<__gm__ volatile int32_t*>(r.miss_count);
      if (active < 0 || uint32_t(active) > r.request_capacity || uint64_t(uint32_t(active)) * r.token_bytes > a.output_bytes)
        result = uint64_t(Result::kInvalidRequest);
      else {
        count = uint32_t(active);
        const uint32_t groups = (count + 7) / 8;
        begin = groups * core / a.workers * 8;
        end = groups * (core + 1) / a.workers * 8;
        if (begin > count) begin = count;
        if (end > count) end = count;
        const auto head = count < kPipelineHeadRows ? count : kPipelineHeadRows;
        if (chunked) {
          begin = end = 0;
          uint32_t completed = 0;
          const auto chunks = PushChunkCount(count, head_rows);
          if (pushed_chunks && profile) profile->request_ns = GetSystemCycle() - profile->enter_ns;
          for (uint32_t chunk = core; chunk < chunks; chunk += a.workers) {
            const auto first = PushChunkBegin(chunk, head_rows);
            const auto last = PushChunkEnd(count, chunk, head_rows);
            end += last - first;
            if (result) continue;
            if (pushed_chunks && profile) {
              profile->request_ns -= GetSystemCycle();
              if (!chunk) profile->head_build_ns = GetSystemCycle();
            }
            const bool built = Build(a, descriptor, first, last);
            if (pushed_chunks && profile) {
              if (!chunk) profile->head_build_ns = GetSystemCycle() - profile->head_build_ns;
              profile->request_ns += GetSystemCycle();
            }
            if (!built) { result = uint64_t(Result::kInvalidRequest); continue; }
            ++completed;
            if (pushed_chunks && !chunk) {
              ChunkRelayIO io{args, *mailbox, sequence, count, profile};
              result = io.StartHead();
            } else {
              // Build waits for MTE3 before this release; each core owns its line.
              Store(a.workspace + 192 + uint64_t(core) * 64, (sequence << 32) | completed);
            }
            if (pushed_chunks && !core) {
              if (!result) result = RelayChunks(args, *mailbox, sequence, count, profile);
              ChunkRelayIO io{args, *mailbox, sequence, count, profile}; head_notified = io.Notified();
            } else if (!core && !head_notified) {
              Publish(args, sequence, count, kChunkRows, profile, true);
              head_notified = true;
            }
          }
          if (!completed && !result) Store(a.workspace + 192 + uint64_t(core) * 64, sequence << 32);
        } else if (pipeline && !core) {
          // Keep the start in GM: SIMT calls must not clobber a local timestamp.
          if (mailbox && profile && count) profile->head_build_ns = GetSystemCycle();
          if (!Build(a, descriptor, 0, head)) result = uint64_t(Result::kInvalidRequest);
          if (mailbox && profile && count)
            profile->head_build_ns = GetSystemCycle() - profile->head_build_ns;
          if (!result && count) {
            const auto posted = Publish(args, sequence, count, head, profile, false, mailbox);
            if (posted) result = posted;
            head_notified = true;
            if (!Build(a, descriptor, begin < head ? head : begin, end)) result = uint64_t(Result::kInvalidRequest);
          }
        } else if (!Build(a, descriptor, pipeline && begin < head ? head : begin, end))
          result = uint64_t(Result::kInvalidRequest);
      }
    }
  }
  if (pushed_chunks && !core && a.workspace && !head_notified) {
    // Empty/invalid requests have no Head, but must not inspect prior replay
    // bookkeeping while waiting for builders or draining the control window.
    ChunkRelayIO io{args, *mailbox, sequence, count, profile}; io.Init();
  }
  if (chunked && result && a.workspace)
    Store(a.workspace + 192 + uint64_t(core) * 64, (sequence << 32) | kChunkFailed | uint32_t(result));
  if (profile && !pushed_chunks) profile->request_ns = GetSystemCycle() - profile->enter_ns - profile->notify_ns;
  // Publish validation even for empty cores. Baseline rejects before any DMA;
  // pipeline reports suffix failure after CPU has drained the valid head.
  Store(builder, (sequence << 32) | uint32_t(result));
  if (!core) {
    for (uint32_t w = 0; w < a.workers; ++w) {
      uint64_t value = 0;
      for (uint64_t poll = 0; poll < polls; ++poll) {
        value = Load(coord + sizeof(Coordination) + uint64_t(kMaxWorkers + w) * 64);
        if ((value >> 32) == sequence) break;
        if (pushed_chunks && !result) result = RelayChunks(args, *mailbox, sequence, count, profile);
      }
      if ((value >> 32) != sequence) result = uint64_t(Result::kTimeout);
      else if (uint32_t(value) && !result) result = uint32_t(value);
    }
    Store(coord + offsetof(Coordination, claimed), sequence * a.workers);
    if (pushed_chunks && a.workspace) {
      ChunkRelayIO io{args, *mailbox, sequence, count, profile};
      const auto chunks = PushChunkCount(count, head_rows);
      for (uint64_t poll = 0; !result && io.Total() < chunks && poll < polls; ++poll)
        result = RelayChunks(args, *mailbox, sequence, count, profile);
      if (!result && io.Total() < chunks) result = uint64_t(Result::kTimeout);
      if (result && io.Notified()) (void)FailChunkControl(io, 0, uint32_t(result));
      const auto retired = DrainChunkControls(io); if (retired) result = retired;
      head_notified = io.Notified();
    }
    if (head_notified && !chunked) {
      if (mailbox) {
        const auto retired = RetireDeferredMailbox(*mailbox);
        if (retired) result = retired;
      }
      Store(a.workspace + kSuffixNotifyOffset, (sequence << 32) | uint32_t(result ? result : uint64_t(Result::kOk)));
      if (mailbox && count > kPipelineHeadRows) {
        auto posted = PostMailbox(*mailbox, a, descriptor - a.workspace, output_desc - a.workspace, count, true, result != 0);
        if (!posted) posted = RetireDeferredMailbox(*mailbox);
        if (posted) result = posted;
      }
    }
    if ((!result && count) || head_notified) {
      if (!head_notified) Publish(args, sequence, count, 0, profile);
      const volatile uint64_t wait_start = profile ? GetSystemCycle() : 0;
      bool done = false;
      for (uint64_t poll = 0; poll < polls; ++poll) {
        const auto token = Load(a.workspace + 128);
        if ((token >> 32) > sequence) { result = uint64_t(Result::kSequenceError); break; }
        if ((token >> 32) != sequence) continue;
        const auto completion = uint32_t(token);
        if (!result && completion != uint32_t(Result::kOk))
          result = completion ? completion : uint64_t(Result::kTransportError);
        done = true;
        break;
      }
      if (!done) result = uint64_t(Result::kTimeout);
      if (profile) profile->ack_ns = GetSystemCycle() - wait_start;
    }
    if (result) Store(coord + offsetof(Coordination, result), result);
    Store(coord + offsetof(Coordination, finished), sequence);
  } else {
    bool finished = false;
    for (uint64_t poll = 0; poll < polls; ++poll)
      if (Load(coord + offsetof(Coordination, finished)) == sequence) { finished = true; break; }
    if (!finished) result = uint64_t(Result::kTimeout);
    else result = Load(coord + offsetof(Coordination, result));
  }
  if (result) Store(epoch + 8, result);
  // Control lines are invalidated on every observation. Payload never enters
  // AIV's scalar cache or UB; CPU's strongly ordered done follows all data CQEs.
  PipeBarrier<PIPE_ALL>();
  auto* status = reinterpret_cast<__gm__ WorkerStatus*>(a.status) + core;
  status->magic = kMagic;
  status->sequence = sequence;
  status->result = result ? result : uint64_t(Result::kOk);
  status->worker = core;
  status->consumed = 0;
  for (uint32_t i = 0; i < 3; ++i) status->reserved[i] = 0;
  Flush(reinterpret_cast<uint64_t>(status), sizeof(*status));
  if (profile) {
    if (!core && count && !result) {
      Flush(a.workspace + 128, sizeof(Completion));
      const auto* sample = &reinterpret_cast<__gm__ Completion*>(a.workspace + 128)->cpu_sgl_write;
      profile->cpu_sgl_write.elapsed_ns = sample->elapsed_ns;
      profile->cpu_sgl_write.data_wrs = sample->data_wrs;
      profile->cpu_sgl_write.waves = sample->waves;
      profile->cpu_sgl_write.tail_cqes = sample->tail_cqes;
    }
    profile->spans = end - begin;
    profile->bytes = profile->spans * r.token_bytes;
    profile->exit_ns = GetSystemCycle();
    Flush(reinterpret_cast<uint64_t>(profile), sizeof(*profile));
  }
  PipeBarrier<PIPE_ALL>();
}
}  // namespace kvaf::cpu_push::aiv

extern "C" __global__ __aicore__ void KvafCpuSglWriteAivKernelV1(kvaf::cpu_push::CpuSglWriteArgs args) {
  kvaf::cpu_push::aiv::Execute(args);
}
#ifndef KVAF_CPU_SGL_AIV_MODEL
static const struct FunLevelKType KvafCpuSglWriteAivKernelV1_kernel_type_section
    __attribute__((used, section(".ascend.meta.KvafCpuSglWriteAivKernelV1"))) =
    {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
#endif

extern "C" __global__ __aicore__ void KvafCpuSglPushAivKernelV1(kvaf::cpu_push::CpuSglPushArgs args) {
  args.write.execution.sequence = (args.write.execution.sequence & kvaf::cpu_push::kChunkPipelineLaunch)
      ? args.write.execution.sequence : kvaf::cpu_push::kPipelineLaunch;
  kvaf::cpu_push::aiv::Execute(args.write, &args.mailbox);
}
#ifndef KVAF_CPU_SGL_AIV_MODEL
